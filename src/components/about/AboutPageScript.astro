  //       el.style.transform = 'translateY(30px)';
  //       el.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
  //       observer.observe(el);
  //     });

  //   const revealObs = new IntersectionObserver(
  //     (entries) => {
  //       entries.forEach((entry) => {
  //         if (entry.isIntersecting) {
  //           entry.target.style.opacity = '1';
  //           entry.target.style.transform = 'translateY(0)';
  //         }
  //       });
  //     },
  //     { threshold: 0.1 }
  //   );

  //   document
  //     .querySelectorAll('.nms-card, .game-card, .show-card, .movie-card')
  //     .forEach((el) => revealObs.observe(el));
  // }

  // ============================================
  // INIT / LIFECYCLE
  // ============================================

  let aboutInitialized = false;
  let readmeFullLoaded = false;

  async function initAboutPage() {
    if (aboutInitialized) return;
    aboutInitialized = true;

    await loadReadme('readmeContent');
    initSteamWidget();
    // initScrollReveal();
  }

  function resetAboutState() {
    aboutInitialized = false;
    readmeFullLoaded = false;

    const btn = document.getElementById('steam-toggle-btn');
    const infoDiv = document.getElementById('steam-info');
    if (btn) btn.classList.remove('active');
    if (infoDiv) infoDiv.innerHTML = '';

    const readmeContentFull = document.getElementById('readmeContentFull');
    if (readmeContentFull) {
      readmeContentFull.innerHTML = '';
      delete readmeContentFull.dataset.fullLoaded;
    }

    initAboutPage();
    initCarousel();
    initModal();
    initClubHimno();
  }

  function handleAboutNavigate() {
    resetAboutState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initAboutPage();
      initCarousel();
      initModal();
      initClubHimno();
    });
  } else {
    initAboutPage();
    initCarousel();
    initModal();
    initClubHimno();
  }

  document.addEventListener('astro:page-load', handleAboutNavigate);
  window.addEventListener('astro:after-swap', handleAboutNavigate);
</script>
