---
import '../../styles/homelab/status.css';

interface Props {
  class?: string;
  service?: 'homelab' | 'kuma';
}

const { class: className = '', service = 'homelab' } = Astro.props;
---

<span class:list={['status-item', 'status-item-' + service, className]} data-service={service}>
  <span class="status-dot" aria-hidden="true"></span>
  <span class="status-name">{service === 'homelab' ? 'HOMELAB' : 'STATUS'}</span>
  <span data-status={service} class="status-value">checking...</span>
</span>

<script is:inline>
  (function () {
    'use strict';

    const API_URL  = 'https://vukilis.com/status-api';
    const SSE_URL  = 'https://vukilis.com/status-stream';
    const STATES   = ['is-up', 'is-down', 'is-partial', 'is-unknown', 'is-error'];
    let es = null;

    function setStatus(service, status, text) {
      const el = document.querySelector(`.status-item-${service} [data-status="${service}"]`);
      const item = el?.closest('.status-item');
      if (!el || !item) return;
      item.classList.remove(...STATES);
      el.classList.remove(...STATES);
      if (status) {
        item.classList.add('is-' + status);
        el.classList.add('is-' + status);
      }
      if (text !== undefined) el.textContent = text;
    }

    // 1) Immediate fetch so the user sees status right away
    async function fetchInitial() {
      try {
        const res = await fetch(API_URL, { cache: 'no-store' });

        // Homelab: did the API itself respond?
        const homelabStatus = res.ok ? 'up' : 'down';
        setStatus('homelab', homelabStatus, homelabStatus.toUpperCase());

        // Kuma: parse the same JSON response
        const data = await res.json();
        const heartbeats = data.heartbeatList || {};
        let up = 0, down = 0, total = 0;

        for (const id in heartbeats) {
          const pulses = heartbeats[id];
          if (Array.isArray(pulses) && pulses.length) {
            const latest = pulses[pulses.length - 1];
            latest.status === 1 ? up++ : down++;
            total++;
          }
        }

        let kStatus, kText;
        if (total === 0)       { kStatus = 'unknown';  kText = 'NO DATA'; }
        else if (down === total) { kStatus = 'down';     kText = 'DOWN'; }
        else if (down > 0)     { kStatus = 'partial';  kText = 'PARTIAL (' + down + ')'; }
        else                   { kStatus = 'up';       kText = 'UP'; }

        setStatus('kuma', kStatus, kText);
      } catch (err) {
        setStatus('homelab', 'error', 'ERROR');
        setStatus('kuma', 'error', 'ERROR');
      }
    }

    // 2) SSE for live updates (only overwrites when data changes)
    function connectSSE() {
      if (es) return;
      es = new EventSource(SSE_URL);

      es.addEventListener('homelab', (e) => {
        const data = JSON.parse(e.data);
        setStatus('homelab', data.status, data.text);
      });

      es.addEventListener('kuma', (e) => {
        const data = JSON.parse(e.data);
        setStatus('kuma', data.status, data.text);
      });

      // Browser auto-reconnects on error. We intentionally do NOT overwrite
      // the displayed status with "..." so the user keeps seeing the last known state.
    }

    function disconnectSSE() {
      if (es) { es.close(); es = null; }
    }

    async function init() {
      await fetchInitial();   // instant paint
      connectSSE();           // then go live
    }

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:before-page-transition', disconnectSSE);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) disconnectSSE();
      else connectSSE();
    });
  })();
</script>