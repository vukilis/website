---
import ThemeToggle from './ThemeToggle.astro';

// Navigation component — Linux Terminal Theme
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const relativePath = currentPath.replace(base.slice(0, -1), '') || '/';
---

<nav class="nav">
  <div class="nav-container">
    <a href={base} class="logo">
      <span class="logo-text">VUK1LIS</span>
    </a>

    <div class="nav-right">
      <div class="nav-links">
        <a href={base} class:list={['nav-link', { active: relativePath === '/' }]}>
          <span class="link-prefix" aria-hidden="true">~/</span>home
        </a>
        <a href={`${base}blog/`} class:list={['nav-link', { active: relativePath.startsWith('/blog') }]}>
          <span class="link-prefix" aria-hidden="true">~/</span>blog
        </a>
        <a href={`${base}projects/`} class:list={['nav-link', { active: relativePath.startsWith('/projects') }]}>
          <span class="link-prefix" aria-hidden="true">~/</span>projects
        </a>
        <a href={`${base}colab/`} class:list={['nav-link', { active: relativePath.startsWith('/colab') }]}>
          <span class="link-prefix" aria-hidden="true">~/</span>colab
        </a>

        <!-- Terminal-style dropdown -->
        <div class="nav-dropdown" id="nav-dropdown">
          <button 
            class:list={['nav-dropdown-toggle', { active: relativePath.startsWith('/homelab') || relativePath.startsWith('/yerbamate') || relativePath.startsWith('/about') }]}
            aria-expanded="false" 
            aria-haspopup="true" 
            aria-label="More pages"
          >
            <span class="link-prefix" aria-hidden="true">~/</span>
            <span>more</span>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          
          <div class="nav-dropdown-panel" role="menu">
            <!-- Terminal window chrome -->
            <div class="dropdown-header">
              <div class="window-dots">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <span class="window-title">more.sh</span>
              <div class="window-spacer"></div>
            </div>
            
          <div class="dropdown-body">
              <div class="dropdown-prompt">
                <span class="prompt-user">vuk1lis</span><span class="prompt-at">@</span><span class="prompt-host">web</span>:<span class="prompt-path">~/nav</span>$ <span class="prompt-cmd">ls extra/</span>
              </div>

              <a href={`${base}homelab_diagram/`} class:list={['dropdown-link', { active: relativePath.startsWith('/homelab') }]} role="menuitem">
                <span class="dropdown-icon" aria-hidden="true">
                  <i class="fa-solid fa-server"></i>
                </span>
                <span class="dropdown-name">~/homelab</span>
              </a>
              
              <a href={`${base}yerbamate/`} class:list={['dropdown-link', { active: relativePath.startsWith('/yerbamate') }]} role="menuitem">
                <span class="dropdown-icon" aria-hidden="true">
                  <i class="fa-solid fa-mug-hot"></i>
                </span>
                <span class="dropdown-name">~/yerbamate</span>
              </a>

              <a href={`${base}about/`} class:list={['dropdown-link', { active: relativePath.startsWith('/about') }]} role="menuitem">
                <span class="dropdown-icon" aria-hidden="true">
                  <i class="fa-solid fa-user"></i>
                </span>
                <span class="dropdown-name">~/about</span>
              </a>
              
              <div class="dropdown-footer">
                <span class="prompt-user">vuk1lis</span><span class="prompt-at">@</span><span class="prompt-host">web</span>:<span class="prompt-path">~/nav</span>$ <span class="blinking-cursor">_</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="nav-divider" aria-hidden="true"></div>

      <div class="nav-actions">
        <ThemeToggle />

        <button class="mobile-menu-btn" aria-label="Toggle menu" id="mobile-menu-btn" aria-expanded="false">
          <span class="hamburger" aria-hidden="true">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-content">
    <div class="mobile-header">
      <span class="prompt">$</span> ls -la <span class="path">~/nav</span>
    </div>
    <a href={base} class:list={['mobile-nav-link', { active: relativePath === '/' }]}>
      <span class="perm">drwxr-xr-x</span> <span class="link-name">home</span>
    </a>
    <a href={`${base}blog/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/blog') }]}>
      <span class="perm">drwxr-xr-x</span> <span class="link-name">blog</span>
    </a>
    <a href={`${base}projects/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/projects') }]}>
      <span class="perm">drwxr-xr-x</span> <span class="link-name">projects</span>
    </a>
    <a href={`${base}colab/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/colab') }]}>
      <span class="perm">drwxr-xr-x</span> <span class="link-name">colab</span>
    </a>
    <a href={`${base}homelab_diagram/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/homelab') }]}>
      <span class="perm">drwxr-xr-x</span> <span class="link-name">homelab</span>
    </a>
    <a href={`${base}yerbamate/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/yerbamate') }]}>
      <span class="perm">drwxr-xr-x</span> <span class="link-name">yerbamate</span>
    </a>
    <a href={`${base}about/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/about') }]}>
      <span class="perm">drwxr-xr-x</span> <span class="link-name">about</span>
    </a>
    <div class="mobile-footer">
      <span class="prompt">$</span> <span class="cursor">_</span>
    </div>
  </div>
</div>

<style>
  /* Import JetBrains Mono — add to your global CSS or layout head */
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap');


  /* Navbar */
  .nav {
    position: fixed;
    top: 0px;
    left: 0;
    right: 0;
    z-index: 1000;
    height: var(--nav-height);
    padding: 0 1.5rem;
    background: var(--color-bg-overlay);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    backdrop-filter: blur(16px) saturate(120%);
    border-bottom: 1px solid var(--color-border);
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    align-content: center;
    animation: .5s ease-out slideDown;
  }

  .nav::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-primary), var(--color-accent-purple), transparent);
    opacity: 0.6;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 1.1rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  .logo .prompt {
    color: var(--color-primary);
    font-weight: 700;
  }

  .logo .logo-text {
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .logo:hover .logo-text {
    color: var(--color-primary-hover);
  }

  .logo .cursor {
    color: var(--color-primary);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--color-text-dim);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    position: relative;
    transition: all 0.2s ease;
    border-radius: .875rem;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    text-transform: none;
  }

  .nav-link .link-prefix {
    color: var(--color-primary);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-bg-elevated);
  }

  .nav-link:hover .link-prefix {
    opacity: 1;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .nav-link.active {
    color: var(--color-text);
    background: var(--color-primary-soft);
    border: 1px solid rgba(59, 130, 246, 0.3);
    font-weight: 600;
  }

  .nav-link.active .link-prefix {
    color: var(--color-primary-hover);
    opacity: 1;
  }

  /* ===== TERMINAL DROPDOWN ===== */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-toggle {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    color: var(--color-text-dim);
    background: transparent;
    border: 1px solid transparent;
    font-family: inherit;
    font-weight: 500;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: .875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-dropdown-toggle .link-prefix {
    color: var(--color-primary);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }

  .nav-dropdown-toggle:hover {
    color: var(--color-text);
    background: var(--color-bg-elevated);
  }

  .nav-dropdown-toggle:hover .link-prefix {
    opacity: 1;
  }

  .nav-dropdown-toggle.active {
    color: var(--color-text);
    background: var(--color-primary-soft);
    border: 1px solid rgba(59, 130, 246, 0.3);
    font-weight: 600;
  }

  .nav-dropdown-toggle.active .link-prefix {
    color: var(--color-primary-hover);
    opacity: 1;
  }

  .nav-dropdown-toggle[aria-expanded="true"] {
    color: var(--color-text);
    background: var(--color-bg-elevated);
    border-color: var(--color-border);
  }

  .dropdown-chevron {
    width: 14px;
    height: 14px;
    margin-left: 0.15rem;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.7;
  }

  .nav-dropdown-toggle[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Terminal window panel */
  .nav-dropdown-panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: 260px;
    background: var(--color-bg-overlay-heavy);
    -webkit-backdrop-filter: blur(32px) saturate(140%);
    backdrop-filter: blur(32px) saturate(140%);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-12px) scale(0.96);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1001;
    box-shadow: 
      0 0 0 1px rgba(59, 130, 246, 0.08),
      0 20px 50px -10px rgba(0, 0, 0, 0.5),
      0 0 30px -5px rgba(59, 130, 246, 0.1);
  }

  .nav-dropdown.open .nav-dropdown-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  /* Window chrome header */
  .dropdown-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--color-border);
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .dot-red { background: #ff5f56; box-shadow: 0 0 4px rgba(255, 95, 86, 0.4); }
  .dot-yellow { background: #ffbd2e; box-shadow: 0 0 4px rgba(255, 189, 46, 0.4); }
  .dot-green { background: #27c93f; box-shadow: 0 0 4px rgba(39, 201, 63, 0.4); }

  .window-title {
    font-size: 0.7rem;
    color: var(--color-text-dim);
    opacity: 0.7;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .window-spacer {
    flex: 1;
  }

  /* Dropdown body */
  .dropdown-body {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dropdown-prompt {
    font-size: 0.7rem;
    color: var(--color-text-dim);
    opacity: 0.8;
    margin-bottom: 0.25rem;
    padding: 0 0.25rem;
    white-space: nowrap;
    overflow: hidden;
  }

  .dropdown-footer {
    font-size: 0.7rem;
    color: var(--color-text-dim);
    opacity: 0.6;
    margin-top: 0.25rem;
    padding: 0 0.25rem;
    white-space: nowrap;
    overflow: hidden;
  }

  .prompt-user { color: var(--color-primary); font-weight: 600; }
  .prompt-at { color: var(--color-text-dim); }
  .prompt-host { color: var(--color-accent-purple); font-weight: 600; }
  .prompt-path { color: var(--color-accent-blue); }
  .prompt-cmd { color: var(--color-text); font-weight: 500; }

  .blinking-cursor {
    color: var(--color-primary);
    animation: blink 1.2s step-end infinite;
  }

  /* Dropdown links */
  .dropdown-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    border-radius: 10px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    position: relative;
    opacity: 0;
    transform: translateX(-8px);
  }

  .nav-dropdown.open .dropdown-link {
    opacity: 1;
    transform: translateX(0);
  }

  .nav-dropdown.open .dropdown-link:nth-child(3) { transition-delay: 0.08s; }
  .nav-dropdown.open .dropdown-link:nth-child(4) { transition-delay: 0.16s; }

  .dropdown-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: var(--color-bg-elevated);
    color: var(--color-text-dim);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .dropdown-link:hover .dropdown-icon {
    background: var(--color-primary-soft);
    color: var(--color-primary);
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.2);
  }

  .dropdown-name {
    transition: color 0.2s ease;
    font-weight: 500;
  }

  .dropdown-link:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text);
    transform: translateX(4px);
  }

  .dropdown-link:hover {
    opacity: 1;
  }

  .dropdown-link:hover .dropdown-name {
    color: var(--color-primary-hover);
  }

  .dropdown-link.active {
    background: var(--color-primary-soft);
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .dropdown-link.active .dropdown-name {
    color: var(--color-primary-hover);
    font-weight: 600;
  }

  .dropdown-link.active .dropdown-icon {
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .dropdown-link.active {
    opacity: 1;
    color: var(--color-primary-hover);
  }

  .nav-divider {
    width: 1px;
    height: 20px;
    background: var(--color-border);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Mobile Menu Button */
  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 6px;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .mobile-menu-btn:hover {
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  .hamburger {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 20px;
    height: 20px;
    gap: 5px;
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
    transform-origin: center;
  }

  .mobile-menu-btn.menu-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-menu-btn.menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-menu-btn.menu-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Menu */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    top: calc(var(--nav-height));
    background: var(--color-bg-overlay-heavy);
    -webkit-backdrop-filter: blur(24px) saturate(120%);
    backdrop-filter: blur(24px) saturate(120%);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1), transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateY(10px) scale(0.99);
    overscroll-behavior: none;
    touch-action: none;
    overflow: hidden;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
  }

  .mobile-menu::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-primary), var(--color-accent-purple), transparent);
    opacity: 0.5;
  }

  .mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    gap: 0.5rem;
    max-width: 500px;
    margin: 0 auto;
    height: 100%;
    overflow: hidden;
  }

  .mobile-header {
    color: var(--color-text-dim);
    font-size: 0.85rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-header .prompt {
    color: var(--color-primary);
  }

  .mobile-header .path {
    color: var(--color-accent-blue);
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 1rem;
    border-radius: 8px;
    transition: all 0.2s ease;
    opacity: 0;
    transform: translateX(-10px);
  }

  .mobile-menu.open .mobile-nav-link {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu.open .mobile-nav-link:nth-child(2) { transition-delay: 0.06s; }
  .mobile-menu.open .mobile-nav-link:nth-child(3) { transition-delay: 0.12s; }
  .mobile-menu.open .mobile-nav-link:nth-child(4) { transition-delay: 0.18s; }
  .mobile-menu.open .mobile-nav-link:nth-child(5) { transition-delay: 0.24s; }
  .mobile-menu.open .mobile-nav-link:nth-child(6) { transition-delay: 0.30s; }
  .mobile-menu.open .mobile-nav-link:nth-child(7) { transition-delay: 0.36s; }
  .mobile-menu.open .mobile-nav-link:nth-child(8) { transition-delay: 0.42s; }

  .mobile-nav-link .perm {
    color: var(--color-text-dim);
    font-size: 0.75rem;
    min-width: 100px;
  }

  .mobile-nav-link .link-name {
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .mobile-nav-link:hover {
    background: var(--color-bg-elevated);
  }

  .mobile-nav-link:hover .link-name {
    color: var(--color-primary);
  }

  .mobile-nav-link.active {
    background: var(--color-primary-soft);
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .mobile-nav-link.active .link-name {
    color: var(--color-primary-hover);
    font-weight: 600;
  }

  .mobile-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-dim);
    font-size: 0.9rem;
  }

  .mobile-footer .prompt {
    color: var(--color-primary);
  }

  .mobile-footer .cursor {
    color: var(--color-primary);
    animation: blink 1s step-end infinite;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .nav {
      padding: 0 1rem;
    }

    .nav-links {
      display: none;
    }

    .nav-divider {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }

    .top-bar {
      padding: 0.5rem 1rem;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const clock = document.getElementById('top-clock');

    // Clock
    if (clock) {
      const updateClock = () => {
        clock.textContent = new Date().toLocaleTimeString('en-US', { hour12: false });
      };
      updateClock();
      setInterval(updateClock, 1000);
    }

    // Desktop dropdown
    const dropdown = document.getElementById('nav-dropdown');
    const dropdownToggle = dropdown?.querySelector('.nav-dropdown-toggle');
    const dropdownPanel = dropdown?.querySelector('.nav-dropdown-panel');

    if (dropdown && dropdownToggle && dropdownPanel) {
      dropdownToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dropdown.classList.toggle('open');
        dropdownToggle.setAttribute('aria-expanded', String(isOpen));
      });

      // Close when clicking a link
      dropdownPanel.querySelectorAll('.dropdown-link').forEach(link => {
        link.addEventListener('click', () => {
          dropdown.classList.remove('open');
          dropdownToggle.setAttribute('aria-expanded', 'false');
        });
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target)) {
          dropdown.classList.remove('open');
          dropdownToggle.setAttribute('aria-expanded', 'false');
        }
      });

      // Close on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dropdown.classList.contains('open')) {
          dropdown.classList.remove('open');
          dropdownToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    if (mobileMenuBtn && mobileMenu) {
      const preventScroll = (e) => e.preventDefault();

      mobileMenuBtn.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('open');
        mobileMenuBtn.classList.toggle('menu-open', isOpen);
        mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));

        if (isOpen) {
          const scrollY = window.scrollY;
          const html = document.documentElement;
          const body = document.body;

          html.style.overflow = 'hidden';
          html.style.height = '100%';
          html.style.overscrollBehavior = 'none';
          html.style.touchAction = 'none';

          body.style.position = 'fixed';
          body.style.top = `-${scrollY}px`;
          body.style.width = '100%';
          body.style.height = '100%';
          body.style.overscrollBehavior = 'none';

          mobileMenu.addEventListener('touchmove', preventScroll, { passive: false });
          document.addEventListener('touchmove', preventScroll, { passive: false });
        } else {
          const scrollY = Math.abs(parseInt(document.body.style.top || '0', 10));
          const html = document.documentElement;

          html.style.overflow = '';
          html.style.height = '';
          html.style.overscrollBehavior = '';
          html.style.touchAction = '';

          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.width = '';
          document.body.style.height = '';
          document.body.style.overscrollBehavior = '';

          mobileMenu.removeEventListener('touchmove', preventScroll);
          document.removeEventListener('touchmove', preventScroll);
          window.scrollTo(0, scrollY);
        }
      });

      const mobileLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
          mobileMenuBtn.classList.remove('menu-open');
          mobileMenuBtn.setAttribute('aria-expanded', 'false');

          const scrollY = Math.abs(parseInt(document.body.style.top || '0', 10));
          const html = document.documentElement;

          html.style.overflow = '';
          html.style.height = '';
          html.style.overscrollBehavior = '';
          html.style.touchAction = '';

          document.body.style.position = '';
          document.body.style.top = '';
          document.body.style.width = '';
          document.body.style.height = '';
          document.body.style.overscrollBehavior = '';

          mobileMenu.removeEventListener('touchmove', preventScroll);
          document.removeEventListener('touchmove', preventScroll);
          window.scrollTo(0, scrollY);
        });
      });
    }
  });
</script>