---
import '../../styles/design/header.css';
---
<header class="design-header">
  <div class="header-top-nav">
    <a href="/projects/" class="back-link">
      <i class="fa-solid fa-arrow-left"></i> Back to projects
    </a>
  </div>

  <div class="header-main-content">
    <div class="header-titles">
      <h1 class="page-title">Design</h1>
      <p class="page-subtitle">
        Motion design, animation and visual experiments created with Photoshop &amp; After Effects
      </p>
    </div>

    <div class="intro-cards">
      <div class="intro-card">
        <div class="intro-card-icon">
          <i class="fa-solid fa-palette"></i>
        </div>
        <div class="intro-card-content">
          <span class="intro-card-title">Steam</span>
          <span class="intro-card-text">Artworks created for the community</span>
        </div>
      </div>
      <div class="intro-card">
        <div class="intro-card-icon">
          <i class="fa-solid fa-heart"></i>
        </div>
        <div class="intro-card-content">
          <span class="intro-card-title">Passion</span>
          <span class="intro-card-text">Making artworks is my hobby</span>
        </div>
      </div>
    </div>
  </div>

  <div class="intro-highlight">
    <div class="intro-highlight-icon">
      <i class="fa-solid fa-trophy"></i>
    </div>
    <div class="intro-highlight-content">
      <div class="intro-highlight-header">
        <span class="intro-highlight-title">Awarded Profile of the Week!</span>
        <a href="https://steamcommunity.com/groups/ArtworkProfiles" target="_blank" rel="noopener noreferrer" class="intro-highlight-link">
          ArtworkProfiles <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </a>
      </div>
      <p class="intro-highlight-text">
        Recognized multiple times as one of the Top 5 profiles on SteamCommunity.com. Also featured as an example of a high-quality retro-themed Steam profile. Inspired by <a href="https://newretrowave.com/" target="_blank" rel="noopener noreferrer">NewRetroWave <i class="fa-solid fa-arrow-up-right-from-square"></i></a>.
      </p>
    </div>
  </div>

  <p class="header-note">
    <i class="fa-solid fa-circle-info"></i> Backgrounds and character art belong to their respective original creators.
  </p>
</header>
