---
const base = import.meta.env.BASE_URL;

const cards = [
  {
    title: 'DevOps',
    description: 'Building bridges between technology and real-world infrastructure',
    href: `${base}colab/devops/`,
  },
  {
    title: 'WebDev',
    description: 'Building modern frontend experiences that connect great design with real-world business needs',
    href: `${base}colab/webdev/`,
  },
];
