---
import '../../styles/colab/contact-me.css';
---

<section class="service-section contact-section" id="contact">
  <div class="section-bg">
    <div class="bg-grid"></div>
  </div>
  <div class="container">
    <div class="service-header centered">
      <h2 class="service-title">Contact Me</h2>
      <p class="service-desc">Interested in working together? Reach out directly.</p>
    </div>

    <div class="contact-card">
      <a href="mailto:vuk.lekic@vukilis.com" class="contact-email">
        <span class="contact-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>
        <span class="contact-address">vuk.lekic@vukilis.com</span>
      </a>
    </div>
  </div>
</section>
