---
import '../../../styles/colab/shared.css';
import CloudInfrastructure from './CloudInfrastructure.astro';
import ScriptMicroservices from './ScriptMicroservices.astro';
import SysAdminBlock from './SysAdminBlock.astro';
import PhysicalInstallation from './PhysicalInstallation.astro';
---

<section class="service-section" id="services">
  <div class="section-bg">
    <div class="bg-grid"></div>
  </div>
  <div class="container">
    <div class="service-header centered">
      <h2 class="service-title">Infrastructure</h2>
      <p class="service-desc">Experienced in everything from physical rack installations to cloud architecture and automation</p>
    </div>

    <div class="infra-grid">
      <CloudInfrastructure />
      <ScriptMicroservices />
      <SysAdminBlock />
      <PhysicalInstallation />
    </div>
  </div>
</section>
