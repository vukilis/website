---
import '../../../styles/colab/web-design/web-design-blocks.css';
---

<div class="service-block" id="wd-delivery">
  <div class="block-header">
    <div class="service-icon wd-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 16 14" />
      </svg>
    </div>
    <div>
      <h3 class="block-title">Fast Delivery</h3>
      <p class="service-desc">Launch with confidence, backed by reliable progress and no unexpected surprises</p>
    </div>
  </div>
  <div class="animation-stage">
    <svg class="wd-delivery-svg" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="wd-delivery-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#a855f7"/>
          <stop offset="100%" stop-color="#22d3ee"/>
        </linearGradient>
      </defs>

      <g class="wd-timeline-track">
        <line x1="40" y1="150" x2="260" y2="150" stroke="#1a1a2e" stroke-width="3" stroke-linecap="round"/>
        <line x1="40" y1="150" x2="260" y2="150" stroke="url(#wd-delivery-grad))" stroke-width="3" stroke-linecap="round" class="wd-timeline-fill"/>
      </g>

      <g class="wd-timeline-step wd-timeline-step-1">
        <circle cx="60" cy="150" r="14" fill="rgba(168,85,247,0.15)" stroke="#a855f7" stroke-width="2"/>
        <text x="60" y="155" text-anchor="middle" fill="#a855f7" font-size="12" font-weight="700" font-family="monospace">1</text>
        <text x="60" y="190" text-anchor="middle" fill="#fff" font-size="10" font-weight="600" font-family="monospace">Brief</text>
        <text x="60" y="204" text-anchor="middle" fill="#888" font-size="8" font-family="monospace">scope</text>
        <line x1="60" y1="128" x2="60" y2="108" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-timeline-step wd-timeline-step-2">
        <circle cx="125" cy="150" r="14" fill="rgba(168,85,247,0.15)" stroke="#a855f7" stroke-width="2"/>
        <text x="125" y="155" text-anchor="middle" fill="#a855f7" font-size="12" font-weight="700" font-family="monospace">2</text>
        <text x="125" y="190" text-anchor="middle" fill="#fff" font-size="10" font-weight="600" font-family="monospace">Draft</text>
        <text x="125" y="204" text-anchor="middle" fill="#888" font-size="8" font-family="monospace">preview</text>
        <line x1="125" y1="128" x2="125" y2="108" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-timeline-step wd-timeline-step-3">
        <circle cx="190" cy="150" r="14" fill="rgba(34,211,238,0.15)" stroke="#22d3ee" stroke-width="2"/>
        <text x="190" y="155" text-anchor="middle" fill="#22d3ee" font-size="12" font-weight="700" font-family="monospace">3</text>
        <text x="190" y="118" text-anchor="middle" fill="#fff" font-size="10" font-weight="600" font-family="monospace">Refine</text>
        <text x="190" y="104" text-anchor="middle" fill="#888" font-size="8" font-family="monospace">iterate</text>
        <line x1="190" y1="172" x2="190" y2="192" stroke="#22d3ee" stroke-width="0.8"/>
      </g>

      <g class="wd-timeline-step wd-timeline-step-4">
        <circle cx="245" cy="150" r="14" fill="rgba(34,197,94,0.15)" stroke="#22c55e" stroke-width="2"/>
        <path d="M 239 150 L 243 154 L 251 146" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <text x="245" y="190" text-anchor="middle" fill="#fff" font-size="10" font-weight="600" font-family="monospace">Ship</text>
        <text x="245" y="204" text-anchor="middle" fill="#22c55e" font-size="8" font-family="monospace">live</text>
        <line x1="245" y1="128" x2="245" y2="108" stroke="#22c55e" stroke-width="0.8"/>
      </g>

      <g class="wd-delivery-pulse wd-delivery-pulse-1">
        <circle cx="60" cy="150" r="14" fill="none" stroke="#a855f7" stroke-width="1.5"/>
      </g>
      <g class="wd-delivery-pulse wd-delivery-pulse-2">
        <circle cx="125" cy="150" r="14" fill="none" stroke="#a855f7" stroke-width="1.5"/>
      </g>
      <g class="wd-delivery-pulse wd-delivery-pulse-3">
        <circle cx="190" cy="150" r="14" fill="none" stroke="#22d3ee" stroke-width="1.5"/>
      </g>

      <g class="wd-delivery-stat">
        <text x="150" y="60" text-anchor="middle" fill="#a855f7" font-size="32" font-weight="800" font-family="monospace">Fast</text>
        <text x="150" y="78" text-anchor="middle" fill="#888" font-size="9" font-family="monospace" letter-spacing="2">PREDICTABLE TIMELINES</text>
      </g>

      <g class="wd-delivery-stat-bottom">
        <text x="150" y="252" text-anchor="middle" fill="#888" font-size="9" font-family="monospace" letter-spacing="2">BRIEF → DRAFT → REFINE → SHIP</text>
      </g>
    </svg>
  </div>
</div>