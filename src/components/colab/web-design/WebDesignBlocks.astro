---
import '../../../styles/colab/web-design/web-design-blocks.css';
---

<div class="service-block" id="wd-blocks">
  <div class="block-header">
    <div class="service-icon wd-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
    </div>
    <div>
      <h3 class="block-title">Coding</h3>
      <p class="service-desc">Reusable, well-structured code — readable, modular, and easy to maintain</p>
    </div>
  </div>
  <div class="animation-stage">
    <svg class="wd-code-svg" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="wd-grid-code" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="10" cy="10" r="0.5" fill="rgba(168,85,247,0.08)"/>
        </pattern>
      </defs>

      <rect width="300" height="300" fill="url(#wd-grid-code)"/>

      <g class="wd-code-window">
        <rect x="30" y="40" width="240" height="220" rx="6" fill="none" stroke="#a855f7" stroke-width="1.5"/>
        <rect x="30" y="40" width="240" height="20" rx="6" fill="rgba(168,85,247,0.1)" stroke="#a855f7" stroke-width="1"/>
        <circle cx="42" cy="50" r="2.5" fill="none" stroke="#a855f7" stroke-width="1"/>
        <circle cx="50" cy="50" r="2.5" fill="none" stroke="#a855f7" stroke-width="1"/>
        <circle cx="58" cy="50" r="2.5" fill="none" stroke="#a855f7" stroke-width="1"/>
        <text x="150" y="54" text-anchor="middle" fill="#a855f7" font-size="8" font-family="monospace" opacity="0.6">component.module</text>
        <line x1="34" y1="68" x2="266" y2="68" stroke="#a855f7" stroke-width="0.8" opacity="0.4"/>
      </g>

      <g class="wd-code-gutter">
        <line x1="58" y1="68" x2="58" y2="260" stroke="#a855f7" stroke-width="0.5" opacity="0.3"/>
        <text x="48" y="84" text-anchor="end" fill="#666" font-size="7" font-family="monospace">01</text>
        <text x="48" y="96" text-anchor="end" fill="#666" font-size="7" font-family="monospace">02</text>
        <text x="48" y="108" text-anchor="end" fill="#666" font-size="7" font-family="monospace">03</text>
        <text x="48" y="120" text-anchor="end" fill="#666" font-size="7" font-family="monospace">04</text>
        <text x="48" y="132" text-anchor="end" fill="#666" font-size="7" font-family="monospace">05</text>
        <text x="48" y="144" text-anchor="end" fill="#666" font-size="7" font-family="monospace">06</text>
        <text x="48" y="156" text-anchor="end" fill="#666" font-size="7" font-family="monospace">07</text>
        <text x="48" y="168" text-anchor="end" fill="#666" font-size="7" font-family="monospace">08</text>
        <text x="48" y="180" text-anchor="end" fill="#666" font-size="7" font-family="monospace">09</text>
        <text x="48" y="192" text-anchor="end" fill="#666" font-size="7" font-family="monospace">10</text>
        <text x="48" y="204" text-anchor="end" fill="#666" font-size="7" font-family="monospace">11</text>
        <text x="48" y="216" text-anchor="end" fill="#666" font-size="7" font-family="monospace">12</text>
        <text x="48" y="228" text-anchor="end" fill="#666" font-size="7" font-family="monospace">13</text>
      </g>

      <g class="wd-code-line wd-code-line-1">
        <rect x="65" y="78" width="50" height="8" rx="1" fill="none" stroke="#a855f7" stroke-width="0.8"/>
        <rect x="120" y="78" width="40" height="8" rx="1" fill="none" stroke="#22d3ee" stroke-width="0.8"/>
        <rect x="165" y="78" width="60" height="8" rx="1" fill="none" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-code-line wd-code-line-2">
        <rect x="73" y="90" width="100" height="4" rx="1" fill="none" stroke="#ec4899" stroke-width="0.6"/>
        <rect x="178" y="90" width="20" height="4" rx="1" fill="#fff" opacity="0.6"/>
      </g>

      <g class="wd-code-line wd-code-line-3">
        <rect x="73" y="102" width="60" height="4" rx="1" fill="none" stroke="#a855f7" stroke-width="0.6"/>
        <rect x="138" y="102" width="40" height="4" rx="1" fill="#84cc16" opacity="0.7"/>
        <rect x="183" y="102" width="15" height="4" rx="1" fill="none" stroke="#ec4899" stroke-width="0.6"/>
      </g>

      <g class="wd-code-line wd-code-line-4">
        <rect x="73" y="114" width="45" height="4" rx="1" fill="none" stroke="#a855f7" stroke-width="0.6"/>
        <rect x="123" y="114" width="50" height="4" rx="1" fill="none" stroke="#22d3ee" stroke-width="0.6"/>
      </g>

      <g class="wd-code-line wd-code-line-5">
        <rect x="81" y="126" width="80" height="4" rx="1" fill="none" stroke="#22d3ee" stroke-width="0.6"/>
        <rect x="166" y="126" width="35" height="4" rx="1" fill="#fff" opacity="0.5"/>
      </g>

      <g class="wd-code-line wd-code-line-6">
        <rect x="65" y="138" width="30" height="8" rx="1" fill="none" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-code-line wd-code-line-7">
        <rect x="65" y="162" width="100" height="4" rx="1" fill="#666" opacity="0.5"/>
      </g>

      <g class="wd-code-line wd-code-line-8">
        <rect x="65" y="174" width="40" height="8" rx="1" fill="none" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-code-line wd-code-line-9">
        <rect x="81" y="186" width="50" height="4" rx="1" fill="none" stroke="#22d3ee" stroke-width="0.6"/>
        <rect x="136" y="186" width="80" height="4" rx="1" fill="#84cc16" opacity="0.7"/>
      </g>

      <g class="wd-code-line wd-code-line-10">
        <rect x="81" y="198" width="50" height="4" rx="1" fill="none" stroke="#22d3ee" stroke-width="0.6"/>
        <rect x="136" y="198" width="60" height="4" rx="1" fill="#84cc16" opacity="0.7"/>
      </g>

      <g class="wd-code-line wd-code-line-11">
        <rect x="65" y="210" width="10" height="8" rx="1" fill="none" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-code-line wd-code-line-12">
        <rect x="65" y="234" width="60" height="8" rx="1" fill="none" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-code-line wd-code-line-13">
        <rect x="65" y="246" width="60" height="8" rx="1" fill="none" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-code-cursor">
        <rect x="125" y="84" width="2" height="9" fill="#a855f7"/>
      </g>
    </svg>
  </div>
</div>