---
import '../../../styles/colab/web-design/web-design-blocks.css';
---

<div class="service-block" id="wd-templates">
  <div class="block-header">
    <div class="service-icon wd-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="3" y1="9" x2="21" y2="9" />
        <line x1="9" y1="21" x2="9" y2="9" />
      </svg>
    </div>
    <div>
      <h3 class="block-title">Page Templates</h3>
      <p class="service-desc">Production-ready templates for landing, product, portfolio, and dashboard pages</p>
    </div>
  </div>
  <div class="animation-stage">
    <svg class="wd-template-svg" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="wd-grid-tpl" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(168,85,247,0.08)" stroke-width="0.5"/>
        </pattern>
      </defs>

      <rect width="300" height="300" fill="url(#wd-grid-tpl)"/>

      <g class="wd-template-frame">
        <rect x="40" y="40" width="220" height="220" rx="6" fill="none" stroke="#a855f7" stroke-width="1.5"/>
        <rect x="40" y="40" width="220" height="22" rx="6" fill="rgba(168,85,247,0.1)" stroke="#a855f7" stroke-width="1"/>
        <circle cx="52" cy="51" r="2.5" fill="none" stroke="#a855f7" stroke-width="1"/>
        <circle cx="60" cy="51" r="2.5" fill="none" stroke="#a855f7" stroke-width="1"/>
        <circle cx="68" cy="51" r="2.5" fill="none" stroke="#a855f7" stroke-width="1"/>
        <line x1="44" y1="74" x2="256" y2="74" stroke="#a855f7" stroke-width="0.8" opacity="0.4"/>
      </g>

      <g class="wd-tpl-block wd-tpl-nav">
        <rect x="50" y="84" width="200" height="14" rx="2" fill="none" stroke="#22d3ee" stroke-width="1"/>
        <rect x="56" y="89" width="20" height="4" rx="0.5" fill="#22d3ee" opacity="0.6"/>
        <rect x="180" y="89" width="14" height="4" rx="0.5" fill="none" stroke="#22d3ee" stroke-width="0.6"/>
        <rect x="200" y="89" width="14" height="4" rx="0.5" fill="none" stroke="#22d3ee" stroke-width="0.6"/>
        <rect x="220" y="89" width="22" height="4" rx="2" fill="none" stroke="#22d3ee" stroke-width="0.6"/>
      </g>

      <g class="wd-tpl-block wd-tpl-hero">
        <rect x="50" y="108" width="110" height="60" rx="3" fill="none" stroke="#a855f7" stroke-width="1"/>
        <rect x="58" y="118" width="60" height="10" rx="1" fill="#a855f7" opacity="0.7"/>
        <rect x="58" y="132" width="90" height="3" rx="0.5" fill="#a855f7" opacity="0.4"/>
        <rect x="58" y="138" width="80" height="3" rx="0.5" fill="#a855f7" opacity="0.4"/>
        <rect x="58" y="144" width="70" height="3" rx="0.5" fill="#a855f7" opacity="0.4"/>
        <rect x="58" y="152" width="34" height="10" rx="2" fill="#ec4899" opacity="0.8"/>
        <rect x="96" y="152" width="30" height="10" rx="2" fill="none" stroke="#a855f7" stroke-width="0.8"/>
      </g>

      <g class="wd-tpl-block wd-tpl-image">
        <rect x="170" y="108" width="80" height="60" rx="3" fill="none" stroke="#22d3ee" stroke-width="1" stroke-dasharray="3 2"/>
        <circle cx="195" cy="125" r="6" fill="none" stroke="#22d3ee" stroke-width="0.8"/>
        <path d="M 180 158 L 195 142 L 210 152 L 230 132 L 240 144 L 240 162 L 180 162 Z" fill="#22d3ee" opacity="0.2"/>
      </g>

      <g class="wd-tpl-block wd-tpl-features">
        <rect x="50" y="178" width="65" height="50" rx="3" fill="none" stroke="#22c55e" stroke-width="1"/>
        <circle cx="62" cy="190" r="4" fill="none" stroke="#22c55e" stroke-width="0.8"/>
        <rect x="72" y="188" width="32" height="3" rx="0.5" fill="#22c55e" opacity="0.6"/>
        <rect x="58" y="202" width="48" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>
        <rect x="58" y="208" width="42" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>
        <rect x="58" y="214" width="36" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>

        <rect x="120" y="178" width="65" height="50" rx="3" fill="none" stroke="#22c55e" stroke-width="1"/>
        <circle cx="132" cy="190" r="4" fill="none" stroke="#22c55e" stroke-width="0.8"/>
        <rect x="142" y="188" width="32" height="3" rx="0.5" fill="#22c55e" opacity="0.6"/>
        <rect x="128" y="202" width="48" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>
        <rect x="128" y="208" width="42" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>
        <rect x="128" y="214" width="36" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>

        <rect x="190" y="178" width="60" height="50" rx="3" fill="none" stroke="#22c55e" stroke-width="1"/>
        <circle cx="202" cy="190" r="4" fill="none" stroke="#22c55e" stroke-width="0.8"/>
        <rect x="212" y="188" width="28" height="3" rx="0.5" fill="#22c55e" opacity="0.6"/>
        <rect x="198" y="202" width="42" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>
        <rect x="198" y="208" width="38" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>
        <rect x="198" y="214" width="32" height="2.5" rx="0.5" fill="#22c55e" opacity="0.3"/>
      </g>

      <g class="wd-tpl-block wd-tpl-footer">
        <rect x="50" y="236" width="200" height="14" rx="2" fill="none" stroke="#a855f7" stroke-width="1"/>
        <rect x="58" y="241" width="24" height="3" rx="0.5" fill="#a855f7" opacity="0.4"/>
        <rect x="88" y="241" width="24" height="3" rx="0.5" fill="#a855f7" opacity="0.4"/>
        <rect x="118" y="241" width="24" height="3" rx="0.5" fill="#a855f7" opacity="0.4"/>
        <rect x="226" y="241" width="20" height="3" rx="1.5" fill="#a855f7" opacity="0.6"/>
      </g>

      <g class="wd-cursor-tpl">
        <path d="M 0 0 L 0 14 L 4 11 L 7 16 L 9 15 L 6 10 L 11 10 Z" fill="#ec4899" stroke="#fff" stroke-width="0.5" transform="translate(140, 150)"/>
      </g>
    </svg>
  </div>
</div>