---
import Icon from '../../other/Icon.astro';
import '../../../styles/colab/web-design/web-design-hero.css';
---

<section class="wd-hero">
  <div class="colab-hero-top">
    <a href="/colab/" class="colab-back-link">
      <Icon name="arrow-left" />
      Back to Colab
    </a>
  </div>

  <div class="wd-hero-content">
    <div class="wd-browser">
      <div class="wd-browser-chrome">
        <div class="window-dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <div class="wd-url-bar">
          <svg class="wd-lock-icon" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span class="wd-url-text">vukilis.com/portfolio</span>
        </div>
        <span class="wd-window-spacer"></span>
      </div>

      <div class="wd-browser-body">
        <div class="wd-nav">
          <div class="wd-logo">V</div>
          <div class="wd-nav-links">
            <span class="wd-nav-link wd-nav-link-active">Home</span>
            <span class="wd-nav-link">Work</span>
            <span class="wd-nav-link">About</span>
          </div>
          <div class="wd-nav-cta"></div>
        </div>

        <div class="wd-hero-grid">
          <div class="wd-hero-text">
            <div class="wd-hero-tag">
              <span class="wd-tag-dot"></span>
              <span>v1.0 · just shipped</span>
            </div>
            <div class="wd-hero-h">
              <span class="wd-h-line wd-h-line-1"></span>
              <span class="wd-h-line wd-h-line-2"></span>
              <span class="wd-h-line wd-h-line-3"></span>
            </div>
            <div class="wd-hero-p">
              <span class="wd-p-line wd-p-line-1"></span>
              <span class="wd-p-line wd-p-line-2"></span>
              <span class="wd-p-line wd-p-line-3"></span>
              <span class="wd-p-line wd-p-line-4"></span>
            </div>
            <div class="wd-hero-buttons">
              <div class="wd-btn wd-btn-primary"></div>
              <div class="wd-btn wd-btn-secondary"></div>
            </div>
          </div>

          <div class="wd-hero-image">
            <div class="wd-image-frame">
              <div class="wd-image-skyline">
                <div class="wd-img-rect wd-img-rect-1"></div>
                <div class="wd-img-rect wd-img-rect-2"></div>
                <div class="wd-img-rect wd-img-rect-3"></div>
                <div class="wd-img-rect wd-img-rect-4"></div>
                <div class="wd-img-rect wd-img-rect-5"></div>
              </div>
              <div class="wd-image-circle"></div>
            </div>
          </div>
        </div>

        <div class="wd-features-strip">
          <div class="wd-feature-card">
            <div class="wd-feature-icon"></div>
            <div class="wd-feature-lines">
              <span class="wd-feature-line"></span>
              <span class="wd-feature-line wd-feature-line-short"></span>
            </div>
          </div>
          <div class="wd-feature-card">
            <div class="wd-feature-icon"></div>
            <div class="wd-feature-lines">
              <span class="wd-feature-line"></span>
              <span class="wd-feature-line wd-feature-line-short"></span>
            </div>
          </div>
          <div class="wd-feature-card">
            <div class="wd-feature-icon"></div>
            <div class="wd-feature-lines">
              <span class="wd-feature-line"></span>
              <span class="wd-feature-line wd-feature-line-short"></span>
            </div>
          </div>
        </div>

        <div class="wd-cursor-marker" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"></path>
            <path d="m13 13 6 6"></path>
          </svg>
        </div>
      </div>
    </div>

    <h1 class="wd-hero-title">
      <span class="wd-title-line">Frontend</span>
      <span class="wd-title-line wd-title-accent">Websites</span>
    </h1>

    <div class="wd-subtitle-wrapper">
      <p class="wd-hero-subtitle">
        Building modern frontend experiences that connect great design with real-world business needs
      </p>
    </div>
  </div>

  <div class="wd-scroll-indicator">
    <span class="wd-scroll-text">Scroll to explore</span>
    <div class="wd-scroll-line"></div>
  </div>
</section>
