---
import '../../styles/blog/blog-card.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  lastmod?: Date | undefined;
  slug: string;
  tags?: string[] | undefined;
  categories?: string[] | undefined;
  activeTag?: string | undefined;
  readingTime?: number | undefined;
  currentPage?: number | undefined;
}

const base = import.meta.env.BASE_URL;
const { title, description, pubDate, lastmod, slug, tags, categories, activeTag, readingTime, currentPage } = Astro.props;

const postUrl = currentPage && currentPage > 1 ? `${base}blog/${currentPage}/${slug}/` : `${base}blog/${slug}/`;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const formattedUpdatedDate = lastmod?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const tagsJson = JSON.stringify(tags ?? []);
const categoriesJson = JSON.stringify(categories ?? []);
---

<div
  class="blog-card"
  data-href={postUrl}
  data-pub-date={pubDate.toISOString()}
  data-lastmod={lastmod?.toISOString() ?? ''}
  data-reading-time={readingTime ?? ''}
  data-title={title}
  data-tags={tagsJson}
  data-categories={categoriesJson}
>
  <div class="card-inner">
    <div class="blog-meta-row">
    <time class="blog-date">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      {formattedDate}
    </time>
    {formattedUpdatedDate && lastmod?.getTime() !== pubDate.getTime() && (
      <span class="blog-updated">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 4 23 10 17 10"></polyline>
          <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
        </svg>
        Updated: {formattedUpdatedDate}
      </span>
    )}
  </div>
  <h3 class="blog-title">
    <a href={postUrl} class="blog-title-link">{title}</a>
  </h3>
  <p class="blog-description">{description}</p>
  {tags && tags.length > 0 && (
    <div class="blog-tags">
      {tags.map((tag) => (
        <span class={`tag${activeTag && activeTag.toLowerCase() === tag.toLowerCase() ? ' active' : ''}`} data-tag={tag} title={`Filter by ${tag}`}>{tag}</span>
      ))}
    </div>
  )}
    <a href={postUrl} class="read-more">
      <span class="read-more-text">
        Read article
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
      {readingTime && (
        <span class="blog-reading-time">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {readingTime} min
        </span>
      )}
    </a>
    <div class="card-glare"></div>
  </div>
</div>

<script is:inline>
  (function() {
    function init() {
      document.querySelectorAll('.blog-card[data-href]').forEach(function(card) {
        if (card.getAttribute('data-card-initialized')) return;
        card.setAttribute('data-card-initialized', 'true');
        card.addEventListener('click', function(e) {
          if (e.target.closest('a, .tag, button')) return;
          var link = card.querySelector('.blog-title-link');
          if (link) link.click();
        });
      });
      document.querySelectorAll('.blog-card .tag[data-tag]').forEach(function(el) {
        if (el.getAttribute('data-initialized')) return;
        el.setAttribute('data-initialized', 'true');
        el.style.cursor = 'pointer';
        el.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var tag = el.getAttribute('data-tag');
          if (!tag) return;
          tag = tag.toLowerCase();
          var path = window.location.pathname;
          var tagPage = '/blog/tag/' + encodeURIComponent(tag) + '/';
          if (path === tagPage || path === tagPage.replace(/\/$/, '')) {
            window.location.href = '/blog/';
          } else {
            window.location.href = tagPage;
          }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>
