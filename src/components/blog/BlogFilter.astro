---
interface Props {
  allPosts: { data: { categories?: string[] } }[];
  activeCategory?: string;
}

const { allPosts, activeCategory } = Astro.props;

function slugify(str: string) {
  return str
    .toLowerCase()
    .trim()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '')
    .replace(/-+/g, '-');
}

const categoryCounts = new Map(
  [...new Set(allPosts.flatMap(p => p.data.categories ?? []))].map(category => [
    category,
    allPosts.filter(p => (p.data.categories ?? []).includes(category)).length,
  ])
);

const allCategories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(entry => entry[0]);

function isActiveCategory(cat: string) {
  return activeCategory ? slugify(activeCategory) === slugify(cat) : false;
}

const allPostsCount = allPosts.length;
---

  <div class="blog-filter">
    {allCategories.length > 0 && (
      <div class="filter-sections">
        <div class="filter-section">
          <span class="filter-label">Categories</span>
          <div class="filter-pills">
            <a
              href="/blog/"
              class={`filter-pill${!activeCategory ? ' active' : ''}`}
            >
              All <span class="filter-pill-count">{allPostsCount}</span>
            </a>
            {allCategories.map(category => (
              <a
                href={`/blog/category/${slugify(category)}/`}
                class={`filter-pill${isActiveCategory(category) ? ' active' : ''}`}
              >
                {category} <span class="filter-pill-count">{categoryCounts.get(category)}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>


<script is:inline>
  (function() {
    function preserveSortOnCategoryClick(e) {
      var link = e.target.closest('.filter-pill[href]');
      if (!link) return;

      var href = link.getAttribute('href');
      if (!href) return;

      var params = new URLSearchParams(window.location.search);
      var sort = params.get('sort');
      if (!sort) return;

      var base = href.split('?')[0];
      var linkParams = new URLSearchParams(href.split('?')[1] || '');
      linkParams.set('sort', sort);
      var newHref = base + '?' + linkParams.toString();
      link.setAttribute('href', newHref);
    }

    function updateFilterPills() {
      var filter = document.querySelector('.blog-filter');
      if (!filter) return;

      var params = new URLSearchParams(window.location.search);
      var sort = params.get('sort');
      var links = filter.querySelectorAll('.filter-pill[href]');
      links.forEach(function(link) {
        var href = link.getAttribute('href');
        if (!href) return;
        var base = href.split('?')[0];
        var linkParams = new URLSearchParams(href.split('?')[1] || '');
        if (sort) {
          linkParams.set('sort', sort);
        } else {
          linkParams.delete('sort');
        }
        var newHref = base + (linkParams.toString() ? '?' + linkParams.toString() : '');
        link.setAttribute('href', newHref);
      });
    }

    if (!document.__blogFilterInitialized) {
      document.__blogFilterInitialized = true;
      document.addEventListener('click', preserveSortOnCategoryClick);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateFilterPills);
    } else {
      updateFilterPills();
    }
    document.addEventListener('astro:page-load', updateFilterPills);
  })();
</script>
