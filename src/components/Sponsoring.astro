---
interface SponsoringLink {
  name: string;
  url: string;
  icon: string;
  color?: string;
}

const defaultLinks: SponsoringLink[] = [
  {
    name: 'GitHub Sponsors',
    url: 'https://github.com/sponsors/kpab',
    icon: 'github',
    color: '#ac51e0',
  },
  {
    name: 'Ko-fi',
    url: 'https://ko-fi.com/kpab',
    icon: 'ko-fi',
    color: '#FF5E5B',
  },
  {
    name: 'Buy Me a Coffee',
    url: 'https://www.buymeacoffee.com/kpab',
    icon: 'buymeacoffee',
    color: '#FFDD00',
  },
  {
    name: 'PayPal',
    url: 'https://paypal.me/kpab',
    icon: 'paypal',
    color: '#003087',
  },
];

interface Props {
  links?: SponsoringLink[];
  class?: string;
}

const { links = defaultLinks, class: className = '' } = Astro.props;

const iconClasses: Record<string, string> = {
  github: 'fa-brands fa-github',
  buymeacoffee: 'fa-solid fa-mug-saucer',
  'ko-fi': 'fa-brands fa-ko-fi',
  paypal: 'fa-brands fa-paypal',
};
---

<div class:list={['sponsoring-links', className]} aria-label="Sponsoring links">
  {links.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="sponsoring-link"
      aria-label={link.name}
      title={link.name}
    >
      {link.icon ? (
        <i
          class={['fa-fw', iconClasses[link.icon] || ''].join(' ')}
          aria-hidden="true"
          style={link.color ? `color: ${link.color}` : ''}
        />
      ) : null}
    </a>
  ))}
</div>

<style>
  .sponsoring-links {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    justify-content: flex-start;
  }

  .sponsoring-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: rgba(139, 92, 246, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sponsoring-link:hover {
    border-color: var(--color-primary);
    background: rgba(59, 130, 246, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
    color: var(--color-text);
  }

  .sponsoring-link i {
    width: 18px;
    font-size: 18px;
    line-height: 1;
    display: block;
  }

  @media (max-width: 768px) {
    .sponsoring-links {
      justify-content: center;
    }
  }
</style>
