---
interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: Section[];
}

const { sections }: Props = Astro.props;
---

<div class="pagination-dots" role="navigation" aria-label="Page sections">
  {sections.map((section) => (
    <button
      class="pagination-dot"
      data-target={section.id}
      aria-label={`Go to ${section.label}`}
      title={section.label}
      type="button"
    />
  ))}
</div>

<script>
  const dots = document.querySelectorAll('.pagination-dot');
  const sectionIds = Array.from(dots).map(d => d.dataset.target).filter(Boolean);

  function getNavOffset() {
    const style = getComputedStyle(document.documentElement);
    const navHeight = parseFloat(style.getPropertyValue('--nav-height')) || 60;
    return navHeight;
  }

  function easeInOutCubic(t: number) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function scrollToSection(targetId: string) {
    const target = document.getElementById(targetId);
    if (!target) return;

    const start = window.scrollY || window.pageYOffset;
    const end = target.getBoundingClientRect().top + start - getNavOffset();
    const distance = end - start;
    const duration = 600;
    const startTime = performance.now();

    if (Math.abs(distance) < 0.5) {
      window.scrollTo(0, end);
      return;
    }

    function step(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = easeInOutCubic(progress);
      window.scrollTo(0, start + distance * eased);

      if (progress < 1) {
        requestAnimationFrame(step);
      }
    }

    requestAnimationFrame(step);
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const targetId = dot.getAttribute('data-target');
      if (targetId) scrollToSection(targetId);
    });
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const activeDot = document.querySelector(`.pagination-dot[data-target="${entry.target.id}"]`);
          if (activeDot) {
            dots.forEach(d => d.classList.remove('active'));
            activeDot.classList.add('active');
          }
        }
      });
    },
    {
      rootMargin: `-${getNavOffset() + 24}px 0px -60% 0px`,
      threshold: 0,
    }
  );

  sectionIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  let isScrolling = false;
  const SCROLL_COOLDOWN = 600;

  function getCurrentSectionIndex() {
    const scrollMid = window.scrollY + window.innerHeight / 2;
    let currentIndex = 0;

    for (let i = 0; i < sectionIds.length; i++) {
      const el = document.getElementById(sectionIds[i]);
      if (!el) continue;

      const top = el.getBoundingClientRect().top + window.scrollY - getNavOffset();
      const bottom = top + el.offsetHeight;

      if (scrollMid >= top && scrollMid < bottom) {
        currentIndex = i;
        break;
      }

      if (scrollMid >= top) {
        currentIndex = i;
      }
    }

    return currentIndex;
  }

  function navigateByWheel(deltaY: number) {
    if (isScrolling) return;

    const currentIndex = getCurrentSectionIndex();
    let targetIndex = currentIndex;

    if (deltaY > 0 && currentIndex < sectionIds.length - 1) {
      targetIndex = currentIndex + 1;
    } else if (deltaY < 0 && currentIndex > 0) {
      targetIndex = currentIndex - 1;
    } else {
      return;
    }

    isScrolling = true;
    scrollToSection(sectionIds[targetIndex]);

    setTimeout(() => {
      isScrolling = false;
    }, SCROLL_COOLDOWN);
  }

  function navigateByTouch(startY: number, endY: number) {
    if (isScrolling) return;

    const deltaY = startY - endY;
    const threshold = 50;

    if (Math.abs(deltaY) < threshold) return;

    navigateByWheel(deltaY);
  }

  let touchStartY = 0;

  window.addEventListener('wheel', (e) => {
    e.preventDefault();
    navigateByWheel(e.deltaY);
  }, { passive: false });

  window.addEventListener('touchstart', (e) => {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  window.addEventListener('touchend', (e) => {
    const endY = e.changedTouches[0].clientY;
    navigateByTouch(touchStartY, endY);
  }, { passive: true });

  window.addEventListener('astro:page-load', () => {
    isScrolling = false;
  });
</script>

<style>
  .pagination-dots {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    z-index: 100;
    padding: 0.75rem 0.5rem;
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .pagination-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: none;
    padding: 0;
    cursor: pointer;
    background: var(--color-text-muted);
    opacity: 0.5;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
  }

  .pagination-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: inherit;
  }

  .pagination-dot:hover {
    opacity: 1;
    background: var(--color-text-secondary);
    transform: scale(1.2);
  }

  .pagination-dot:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .pagination-dot.active {
    background: var(--color-primary);
    opacity: 1;
    box-shadow: 0 0 12px var(--color-shadow);
    transform: scale(1.35);
  }

  [data-theme='light'] .pagination-dots {
    background: rgba(248, 250, 252, 0.7);
  }

  [data-theme='light'] .pagination-dot.active {
    background: var(--color-primary);
    box-shadow: 0 0 12px var(--color-shadow);
  }

  @media (max-width: 768px) {
    .pagination-dots {
      right: 0.75rem;
      gap: 0.625rem;
      padding: 0.5rem 0.25rem;
    }

    .pagination-dot {
      width: 8px;
      height: 8px;
    }

    .pagination-dot.active {
      transform: scale(1.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pagination-dot {
      transition: none;
    }
  }
</style>
