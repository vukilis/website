---
import Icon from './Icon.astro';

interface SocialLink {
  name: string;
  url: string;
  icon: 'github' | 'linkedin' | 'instagram' | 'youtube' | 'steam' | 'envelope';
  color?: string;
}

const defaultLinks: SocialLink[] = [
  {
    name: 'GitHub',
    url: 'https://github.com/vukilis',
    icon: 'github',
  },
  {
    name: 'LinkedIn',
    url: 'https://linkedin.com/in/vuk-lekic',
    icon: 'linkedin',
  },
  {
    name: 'Instagram',
    url: 'https://instagram.com/only_vukilis',
    icon: 'instagram',
  },
  {
    name: 'YouTube',
    url: 'https://youtube.com/@vukilis',
    icon: 'youtube',
  },
  {
    name: 'Steam',
    url: 'https://steamcommunity.com/id/vuk1lis',
    icon: 'steam',
  },
  {
    name: 'Email',
    url: 'mailto:vuk.lekic@vukilis.com',
    icon: 'envelope',
  },
];

interface Props {
  links?: SocialLink[];
  class?: string;
}

const { links = defaultLinks, class: className = '' } = Astro.props;

const iconStyle: Record<SocialLink['icon'], 'solid' | 'brands'> = {
  github: 'brands',
  linkedin: 'brands',
  instagram: 'brands',
  youtube: 'brands',
  steam: 'brands',
  envelope: 'solid',
};
---

<div class:list={['social-links', className]} aria-label="Social links">
  {links.map((link) => (
    <a
      href={link.url}
      target={link.url.startsWith('mailto:') ? undefined : '_blank'}
      rel={link.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
      class="social-link"
      aria-label={link.name}
      title={link.name}
    >
      <Icon
        name={link.icon}
        style={iconStyle[link.icon]}
        color={link.color}
        class="social-icon"
      />
    </a>
  ))}
</div>

<style>
  .social-links {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: rgba(241, 196, 15, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--color-primary);
    background: rgba(241, 196, 15, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(241, 196, 15, 0.15);
    color: var(--color-text);
  }

  :global(.social-link .fa-icon) {
    width: 18px;
    height: 18px;
    font-size: 18px;
  }

  :global(.social-link .fa-icon svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    .social-links {
      justify-content: center;
    }
  }
</style>
