---
import Icon from './Icon.astro';

interface SponsoringLink {
  name: string;
  url: string;
  icon: 'github' | 'mug-saucer' | 'ko-fi' | 'paypal';
  color?: string;
}

const defaultLinks: SponsoringLink[] = [
  {
    name: 'GitHub Sponsors',
    url: 'https://github.com/sponsors/vukilis',
    icon: 'github',
  },
  {
    name: 'Ko-fi',
    url: 'https://ko-fi.com/vukilis',
    icon: 'ko-fi',
  },
  {
    name: 'Buy Me a Coffee',
    url: 'https://www.buymeacoffee.com/vukilis',
    icon: 'mug-saucer',
  },
  {
    name: 'PayPal',
    url: 'https://paypal.me/vuklekic',
    icon: 'paypal',
  },
];

interface Props {
  links?: SponsoringLink[];
  class?: string;
}

const { links = defaultLinks, class: className = '' } = Astro.props;

const iconStyle: Record<SponsoringLink['icon'], 'solid' | 'brands'> = {
  github: 'brands',
  'ko-fi': 'brands',
  paypal: 'brands',
  'mug-saucer': 'solid',
};
---

<div class:list={['sponsoring-links', className]} aria-label="Sponsoring links">
  {links.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="sponsoring-link"
      aria-label={link.name}
      title={link.name}
    >
      <Icon
        name={link.icon}
        style={iconStyle[link.icon]}
        color={link.color}
        class="sponsoring-icon"
      />
    </a>
  ))}
</div>

<style>
  .sponsoring-links {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    justify-content: flex-start;
  }

  .sponsoring-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: rgba(241, 196, 15, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
  }

  .sponsoring-link:hover {
    border-color: var(--color-primary);
    background: rgba(241, 196, 15, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(241, 196, 15, 0.15);
    color: var(--color-text);
  }

  :global(.sponsoring-link .fa-icon) {
    width: 18px;
    height: 18px;
    font-size: 18px;
  }

  :global(.sponsoring-link .fa-icon svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 768px) {
    .sponsoring-links {
      justify-content: center;
    }
  }
</style>
