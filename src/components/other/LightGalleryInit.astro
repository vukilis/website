---
// src/components/other/LightGalleryInit.astro
---

<script>
  import lightGallery from 'lightgallery';
  import lgFullscreen from 'lightgallery/plugins/fullscreen';
  import lgRotate from 'lightgallery/plugins/rotate';
  import lgZoom from 'lightgallery/plugins/zoom';
  import lgThumbnail from 'lightgallery/plugins/thumbnail';
  import lgVideo from 'lightgallery/plugins/video';

  let globalInstance: any = null;

  function initLightGallery() {
    // 1. Clean up any existing global instance before re-initializing
    if (globalInstance && typeof globalInstance.destroy === 'function') {
      try {
        globalInstance.destroy(true);
      } catch (err) {}
      globalInstance = null;
    }

    // 2. Target all images on the page
    const imgs = document.querySelectorAll('img');
    if (!imgs.length) return;

    // 3. Wrap images dynamically for native LightGallery handling
    imgs.forEach((img) => {
      // Skip badges, icons, or images already wrapped in links
      if (
        img.src.includes('img.shields.io') || 
        img.src.includes('badge') || 
        img.closest('a')
      ) {
        return;
      }

      const a = document.createElement('a');
      a.href = img.src;
      a.setAttribute('data-sub-html', img.alt ? `<h4>${img.alt}</h4>` : '');
      img.parentNode?.insertBefore(a, img);
      a.appendChild(img);
    });

    // 4. Initialize LightGallery on document.body (or a wrapper) targeting all anchor tags
    globalInstance = lightGallery(document.body, {
      selector: 'a[href$=".jpg"], a[href$=".jpeg"], a[href$=".png"], a[href$=".webp"], a[href$=".avif"]', // Or target all 'a' tags that wrap images
      speed: 500,
      download: true,
      counter: true,
      escKey: true,
      swipeThreshold: 50,
      plugins: [lgFullscreen, lgRotate, lgZoom, lgThumbnail, lgVideo],
      zoom: true,
      enableZoomAfter: 200,
      scale: 1.2,
      actualSize: true,
      showZoomInOutIcons: true,
      fullScreen: true,
      rotate: true,
      rotateSpeed: 400,
      thumbnail: true,
      animateThumb: true,
      thumbWidth: 120,
      thumbHeight: '80px',
      thumbMargin: 8,
      appendThumbnailsTo: '.lg-components',
      toggleThumb: true,
      allowMediaOverlap: true,
    });
  }

  // Hook into standard load and Astro view transitions properly
  document.addEventListener('DOMContentLoaded', initLightGallery);
  document.addEventListener('astro:page-load', initLightGallery);
  
  // Clean up instance right before Astro swaps out the page content
  document.addEventListener('astro:before-preparation', () => {
    if (globalInstance && typeof globalInstance.destroy === 'function') {
      try {
        globalInstance.destroy(true);
      } catch {}
      globalInstance = null;
    }
  });
</script>