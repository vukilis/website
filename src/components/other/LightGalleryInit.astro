---
import 'lightgallery/css/lightgallery-bundle.min.css';
---

<script>
(() => {
  const G = '[data-lightgallery]';
  const I = 'a[data-gallery-image="true"]';
  const instances = new Map();

  const initLightGallery = async () => {
    // 1. Prepare and wrap images
    document.querySelectorAll<HTMLElement>(G).forEach(box => {
      box.querySelectorAll<HTMLImageElement>('img').forEach(img => {
        if (img.closest(I) || img.closest('a')) return;
        const src = img.getAttribute('src') || img.currentSrc;
        if (!src) return;

        const s = src.toLowerCase();
        if (
          s.includes('.svg') ||
          s.startsWith('data:image/svg') ||
          s.includes('shields.io') ||
          s.includes('/badge') ||
          s.includes('badge.')
        ) return;

        const a = document.createElement('a');
        a.href = img.dataset.full || src;
        a.dataset.galleryImage = 'true';

        if (img.alt)
          a.dataset.subHtml = `<h4>${img.alt}</h4>`;

        img.parentNode?.insertBefore(a, img);
        a.appendChild(img);
      });
    });

    // 2. Load LightGallery modules in the background
    const [c, f, r, z, t, v] = await Promise.all([
      import('lightgallery'),
      import('lightgallery/plugins/fullscreen'),
      import('lightgallery/plugins/rotate'),
      import('lightgallery/plugins/zoom'),
      import('lightgallery/plugins/thumbnail'),
      import('lightgallery/plugins/video'),
    ]);

    const core = c.default;
    const plugins = [f.default, r.default, z.default, t.default, v.default];

    // 3. Initialize LightGallery on each container natively
    document.querySelectorAll<HTMLElement>(G).forEach(box => {
      if (instances.has(box)) return;

      const lgInstance = core(box, {
        selector: I,
        speed: 500,
        download: true,
        counter: true,
        escKey: true,
        swipeThreshold: 50,
        plugins,
        zoom: true,
        enableZoomAfter: 200,
        scale: 1.2,
        actualSize: true,
        showZoomInOutIcons: true,
        fullScreen: true,
        rotate: true,
        rotateSpeed: 400,
        thumbnail: true,
        animateThumb: true,
        thumbWidth: 120,
        thumbHeight: '80px',
        thumbMargin: 8,
        toggleThumb: true,
        allowMediaOverlap: true,
      });

      instances.set(box, lgInstance);
    });
  };

  const destroy = () => {
    instances.forEach(lg => {
      try { lg.destroy(true); } catch {}
    });
    instances.clear();
  };

  // Clean up instances before Astro swaps pages
  document.addEventListener('astro:before-swap', destroy);

  // Re-initialize cleanly on page load / view transitions
  document.addEventListener('astro:page-load', initLightGallery);

  // Initial load execution
  void initLightGallery();
})();
</script>