---
import 'lightgallery/css/lightgallery-bundle.min.css';
---

<script>
(() => {
  const w = window as any;
  if (w.__lgInit) return;
  w.__lgInit = true;

  const G = '[data-lightgallery]';
  const I = 'a[data-gallery-image="true"]';
  let load: Promise<any> | null = null;
  let lg: any = null;
  let current: HTMLElement | null = null;

  const loadLG = () => load ??= Promise.all([
    import('lightgallery'),
    import('lightgallery/plugins/fullscreen'),
    import('lightgallery/plugins/rotate'),
    import('lightgallery/plugins/zoom'),
    import('lightgallery/plugins/thumbnail'),
    import('lightgallery/plugins/video'),
  ]).then(([c, f, r, z, t, v]) => ({
    core: c.default,
    fullscreen: f.default,
    rotate: r.default,
    zoom: z.default,
    thumbnail: t.default,
    video: v.default,
  }));

  const prepare = () =>
    document.querySelectorAll<HTMLElement>(G).forEach(box =>
      box.querySelectorAll<HTMLImageElement>('img').forEach(img => {
        if (img.closest(I) || img.closest('a')) return;

        const src = img.getAttribute('src') || img.currentSrc;
        if (!src) return;

        const s = src.toLowerCase();
        if (
          s.includes('.svg') ||
          s.startsWith('data:image/svg') ||
          s.includes('shields.io') ||
          s.includes('/badge') ||
          s.includes('badge.')
        ) return;

        const a = document.createElement('a');
        a.href = img.dataset.full || src;
        a.dataset.galleryImage = 'true';

        if (img.alt)
          a.dataset.subHtml = `<h4>${img.alt}</h4>`;

        img.before(a);
        a.appendChild(img);
      })
    );

  const destroy = () => {
    try { lg?.destroy(true); } catch {}
    lg = null;
    current = null;
  };

  async function open(
    box: HTMLElement,
    clicked: HTMLAnchorElement
  ) {
    if (lg && current !== box) destroy();

    const items = () =>
      [...box.querySelectorAll<HTMLAnchorElement>(I)];

    if (lg) {
      lg.openGallery(
        Math.max(items().indexOf(clicked), 0)
      );
      return;
    }

    const m = await loadLG();

    if (!document.documentElement.contains(box))
      return;

    lg = m.core(box, {
      selector: I,

      speed: 500,

      download: true,
      counter: true,
      escKey: true,
      swipeThreshold: 50,

      plugins: [
        m.fullscreen,
        m.rotate,
        m.zoom,
        m.thumbnail,
        m.video
      ],

      zoom: true,
      enableZoomAfter: 200,
      scale: 1.2,
      actualSize: true,
      showZoomInOutIcons: true,

      fullScreen: true,

      rotate: true,
      rotateSpeed: 400,

      thumbnail: true,
      animateThumb: true,
      thumbWidth: 120,
      thumbHeight: '80px',
      thumbMargin: 8,
      toggleThumb: true,

      allowMediaOverlap: true,
    });

    current = box;

    lg.openGallery(
      Math.max(items().indexOf(clicked), 0)
    );
  }

  document.addEventListener('click', e => {
    const link = (e.target as HTMLElement)
      .closest<HTMLAnchorElement>(I);

    const box = link?.closest<HTMLElement>(G);

    if (!link || !box) return;

    e.preventDefault();
    void open(box, link);
  });

  document.addEventListener(
    'astro:before-swap',
    destroy
  );

  document.addEventListener(
    'astro:page-load',
    prepare
  );

  prepare();
})();
</script>