---
const sections = [
  { id: 'hero', label: 'vukilis' },
  { id: 'posts', label: 'dispatches' },
  { id: 'manifesto', label: 'manifesto' },
  { id: 'stats', label: 'numbers' },
  { id: 'skills', label: 'arsenal' },
  { id: 'explore', label: 'explore' },
  { id: 'radio', label: 'on air' },
  { id: 'footer', label: 'connect' },
];
---

<nav class="section-rail" aria-label="Section navigation" data-section-rail>
  <div class="rail-spine" aria-hidden="true">
    <div class="rail-spine-fill" data-rail-progress></div>
    <div class="rail-cursor" data-rail-cursor>
      <span class="rail-cursor-core"></span>
    </div>
  </div>
  <ul class="rail-list">
    {sections.map((section, index) => (
      <li class="rail-row">
        <a href={`#${section.id}`} class="rail-item" data-section={section.id}>
          <span class="rail-label">
            <span class="rail-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="rail-text">{section.label}</span>
          </span>
          <span class="rail-dot" aria-hidden="true"></span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .section-rail {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 900;
    display: none;
  }

  @media (min-width: 1280px) {
    .section-rail { display: block; }
  }

  /* ---------- Vertical spine + progress + cursor ---------- */
  .rail-spine {
    position: absolute;
    right: 3.5px; /* aligns 1px spine with 8px dot centers */
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-border-hover) 55%, transparent) 12%,
      color-mix(in srgb, var(--color-border-hover) 55%, transparent) 88%,
      transparent
    );
    pointer-events: none;
  }

  .rail-spine-fill {
    position: absolute;
    inset: 0;
    width: 100%;
    background: linear-gradient(
      to bottom,
      var(--color-accent-purple),
      var(--color-primary)
    );
    transform-origin: top center;
    transform: scaleY(0);
    opacity: 0.6;
    transition: transform 0.08s linear;
  }

  .rail-cursor {
    position: absolute;
    top: 0;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    border-radius: 50%;
    background: var(--color-bg-dark);
    border: 1.5px solid var(--color-primary);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--color-primary) 14%, transparent),
      0 0 18px color-mix(in srgb, var(--color-primary) 55%, transparent);
    transform: translateY(0);
    opacity: 0;
    transition: opacity 0.35s ease;
    will-change: transform, opacity;
  }

  .rail-cursor.is-ready {
    opacity: 1;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
  }

  .rail-cursor-core {
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--color-primary);
    animation: rail-pulse 2.6s ease-in-out infinite;
  }

  @keyframes rail-pulse {
    0%, 100% { opacity: 0.95; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(0.7); }
  }

  /* ---------- List ---------- */
  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.7rem;
    position: relative;
    z-index: 1;
  }

  .rail-row { position: relative; }

  .rail-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.25rem 0;
    text-decoration: none;
    cursor: pointer;
  }

  /* ---------- Label (pill, glass) ---------- */
  .rail-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg-overlay) 86%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid color-mix(in srgb, var(--color-border) 65%, transparent);
    padding: 0.35rem 0.7rem 0.35rem 0.6rem;
    border-radius: 999px;
    opacity: 0;
    transform: translateX(10px) scale(0.96);
    transition:
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
    pointer-events: none;
    white-space: nowrap;
  }

  .rail-index {
    font-size: 0.5rem;
    color: var(--color-accent-purple);
    opacity: 0.65;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .rail-item:hover .rail-label,
  .rail-item:focus-visible .rail-label,
  .rail-item.is-active .rail-label {
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  .rail-item.is-active .rail-label {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
    background: color-mix(in srgb, var(--color-bg-overlay) 96%, transparent);
  }

  .rail-item.is-active .rail-index {
    color: var(--color-accent-purple);
    opacity: 1;
  }

  /* ---------- Dot ---------- */
  .rail-dot {
    position: relative;
    z-index: 2;
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1.5px solid var(--color-text-muted);
    background: var(--color-bg-dark);
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      background 0.3s ease,
      opacity 0.3s ease,
      box-shadow 0.3s ease;
  }

  .rail-item:hover .rail-dot {
    border-color: var(--color-primary);
    transform: scale(1.3);
    box-shadow: 0 0 14px color-mix(in srgb, var(--color-primary) 50%, transparent);
  }

  /* Active dot fades out — the cursor takes its place */
  .rail-item.is-active .rail-dot {
    border-color: transparent;
    background: transparent;
    transform: scale(0.4);
    opacity: 0;
  }

  .rail-item:focus-visible { outline: none; }
  .rail-item:focus-visible .rail-dot {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-cursor,
    .rail-label,
    .rail-dot,
    .rail-spine-fill,
    .rail-cursor-core {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  (() => {
    let teardown: (() => void) | null = null;

    const init = () => {
      teardown?.();
      teardown = null;

      const rail = document.querySelector<HTMLElement>('[data-section-rail]');
      if (!rail) return;

      const links = Array.from(rail.querySelectorAll<HTMLAnchorElement>('.rail-item'));
      const sections = links
        .map((link) => document.getElementById(link.dataset.section || ''))
        .filter((section): section is HTMLElement => Boolean(section));

      if (sections.length === 0) return;

      const cursor = rail.querySelector<HTMLElement>('[data-rail-cursor]');
      const progress = rail.querySelector<HTMLElement>('[data-rail-progress]');
      const spine = rail.querySelector<HTMLElement>('.rail-spine');

      let active = '';
      let cursorReady = false;

      const moveCursor = (id: string) => {
        if (!cursor || !spine) return;
        const link = links.find((l) => l.dataset.section === id);
        const dot = link?.querySelector<HTMLElement>('.rail-dot');
        if (!link || !dot) return;

        const dotRect = dot.getBoundingClientRect();
        const spineRect = spine.getBoundingClientRect();
        const offset = dotRect.top + dotRect.height / 2 - spineRect.top;

        // First activation: snap into position without transition,
        // then enable the transition on the next frame.
        cursor.style.transform = `translateY(${offset}px)`;
        if (!cursorReady) {
          cursorReady = true;
          requestAnimationFrame(() => cursor.classList.add('is-ready'));
        }
      };

      const setActive = (id: string) => {
        if (id === active) return;
        active = id;

        links.forEach((link) => {
          const isActive = link.dataset.section === id;
          link.classList.toggle('is-active', isActive);
          if (isActive) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });

        moveCursor(id);
      };

      const update = () => {
        const reference = window.innerHeight * 0.4;
        let current = sections[0]?.id ?? '';

        sections.forEach((section) => {
          if (section.getBoundingClientRect().top <= reference) {
            current = section.id;
          }
        });

        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 2;
        if (atBottom) current = sections[sections.length - 1]?.id ?? current;

        setActive(current);

        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          progress.style.transform = `scaleY(${pct})`;
        }
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      };

      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      teardown = () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      };
    };

    const cleanup = () => {
      teardown?.();
      teardown = null;
    };

    const state = window as typeof window & { __sectionRailBound?: boolean };
    if (!state.__sectionRailBound) {
      state.__sectionRailBound = true;
      document.addEventListener('astro:page-load', init);
      document.addEventListener('astro:before-swap', cleanup);
    }

    if (document.readyState !== 'loading') init();
  })();
</script>