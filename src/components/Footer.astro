---
import SocialLinks from './SocialLinks.astro';
import Sponsoring from './Sponsoring.astro';

interface Props {
  socialLinks?: {
    name: string;
    url: string;
    icon: string;
    color?: string;
  }[];
}

const { socialLinks } = Astro.props;
---

<footer class="footer" role="contentinfo">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Vuk1lis Home">
          <img src="/logo.png" alt="Vuk1lis" class="logo-img" loading="lazy" />
        </a>
      </div>

      <div class="footer-sections">
        <div class="footer-section">
          <h3 class="footer-heading">Support</h3>
          <Sponsoring />
        </div>

        <div class="footer-section">
          <h3 class="footer-heading">Connect</h3>
          <SocialLinks links={socialLinks} />
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} Vuk1lis. All rights reserved.
      </p>
      <nav class="footer-legal" aria-label="Legal">
        <a href="/privacy" class="footer-legal-link">Privacy</a>
        <span class="footer-separator" aria-hidden="true"></span>
        <a href="/terms" class="footer-legal-link">Terms</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-darker);
    border-top: 1px solid var(--color-border);
    padding: 4rem 2rem 2.5rem;
    margin-top: auto;
    position: relative;
    z-index: 1;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4rem;
  }

  .footer-brand {
    max-width: 320px;
    flex-shrink: 0;
  }

  .footer-logo {
    display: inline-block;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .footer-logo:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  .logo-img {
    display: block;
  }

  .footer-sections {
    display: flex;
    gap: 4rem;
  }

  .footer-section {
    min-width: 140px;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    opacity: 0.9;
  }

  .footer-section :global(.social-links),
  .footer-section :global(.sponsoring-links) {
    justify-content: flex-start;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-copyright {
    font-size: 0.875rem;
    color: var(--color-text-dim);
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-legal-link {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .footer-legal-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-primary);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .footer-legal-link:hover {
    color: var(--color-primary);
  }

  .footer-legal-link:hover::after {
    width: 100%;
  }

  .footer-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-border);
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 3rem 1.5rem 2rem;
    }

    .footer-main {
      flex-direction: column;
      gap: 2.5rem;
      align-items: center;
    }

    .footer-brand {
      text-align: center;
      max-width: 100%;
    }

    .logo-img {
      margin: 0 auto;
    }

    .footer-sections {
      width: 100%;
      flex-direction: column;
      gap: 2rem;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .footer-section {
      text-align: center;
    }

    .footer-section :global(.social-links),
    .footer-section :global(.sponsoring-links) {
      justify-content: center;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>