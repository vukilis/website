<style>
  .skills-showcase {
    font-family: var(--font-body);
    color: var(--color-text);
    /* min-height: 100vh; */
    /* display: flex; */
    /* align-items: center; */
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: calc(var(--nav-height) + 2rem) 2rem 4rem;
  }

  .skills-showcase .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  /* Header */
  .skills-showcase .section-header {
    text-align: center;
    margin-bottom: 64px;
    animation: skillsFadeUp 0.8s ease-out;
  }

  .skills-showcase .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-text-dim) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .skills-showcase .section-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-dim);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Grid — 3 columns */
  .skills-showcase .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  @media (max-width: 900px) {
    .skills-showcase .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .skills-showcase {
      padding: 60px 18px;
    }
  }

  /* Cards */
  .skills-showcase .skill-card {
    position: relative;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .skills-showcase .skill-card:nth-child(1) { animation-delay: 0.1s; }
  .skills-showcase .skill-card:nth-child(2) { animation-delay: 0.2s; }
  .skills-showcase .skill-card:nth-child(3) { animation-delay: 0.3s; }

  .skills-showcase .skill-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
    box-shadow: 0 20px 60px -10px var(--color-shadow);
  }

  .skills-showcase .card-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .skills-showcase .skill-card[data-category="ai"] .card-glow {
    background: radial-gradient(600px circle at 80% 20%, rgba(241, 196, 15, 0.08), transparent 40%);
  }
  .skills-showcase .skill-card[data-category="devops"] .card-glow {
    background: radial-gradient(600px circle at 20% 80%, rgba(241, 196, 15, 0.08), transparent 40%);
  }
  .skills-showcase .skill-card[data-category="design"] .card-glow {
    background: radial-gradient(600px circle at 80% 80%, rgba(241, 196, 15, 0.08), transparent 40%);
  }

  .skills-showcase .skill-card:hover .card-glow {
    opacity: 1;
  }

  .skills-showcase .card-content {
    position: relative;
    z-index: 1;
    padding: 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .skills-showcase .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }

  .skills-showcase .icon-wrap {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .skills-showcase .skill-card[data-category="ai"] .icon-wrap { color: var(--color-accent-purple); }
  .skills-showcase .skill-card[data-category="devops"] .icon-wrap { color: var(--color-accent-purple); }
  .skills-showcase .skill-card[data-category="design"] .icon-wrap { color: var(--color-accent-purple); }

  .skills-showcase .skill-card:hover .icon-wrap {
    transform: scale(1.08) rotate(-3deg);
    border-color: var(--color-border-hover);
  }

  .skills-showcase .card-header h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    flex: 1;
    letter-spacing: -0.01em;
  }

  .skills-showcase .card-desc {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    line-height: 1.55;
    margin: 0 0 20px 0;
    flex: 1;
  }

  /* Tags */
  .skills-showcase .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .skills-showcase .tag {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 8px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
    transition: all 0.25s ease;
    cursor: default;
    animation: tagIn 0.3s ease backwards;
  }

  .skills-showcase .tag:hover {
    border-color: var(--color-border-hover);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  .skills-showcase .tag.highlight {
    background: var(--color-primary-soft);
    border-color: var(--color-primary);
    color: var(--color-primary-hover);
  }

  .skills-showcase .tag.highlight:hover {
    border-color: var(--color-primary-hover);
    color: var(--color-text);
  }

  /* Hidden tags */
  .skills-showcase .tag-hidden {
    display: none;
    opacity: 0;
    transform: scale(0.9);
  }

  .skills-showcase .skill-tags.expanded .tag-hidden {
    display: inline-flex;
    animation: tagPop 0.25s ease forwards;
  }

  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(1) { animation-delay: 0.02s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(2) { animation-delay: 0.04s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(3) { animation-delay: 0.06s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(4) { animation-delay: 0.08s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(5) { animation-delay: 0.10s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(6) { animation-delay: 0.12s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(7) { animation-delay: 0.14s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(8) { animation-delay: 0.16s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(9) { animation-delay: 0.18s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(10) { animation-delay: 0.20s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(11) { animation-delay: 0.22s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(12) { animation-delay: 0.24s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(13) { animation-delay: 0.26s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(14) { animation-delay: 0.28s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(15) { animation-delay: 0.30s; }
  .skills-showcase .skill-tags.expanded .tag-hidden:nth-child(16) { animation-delay: 0.32s; }

  /* Toggle button */
  .skills-showcase .tag-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 8px;
    background: transparent;
    border: 1px dashed var(--color-border);
    color: var(--color-text-dim);
    cursor: pointer;
    transition: all 0.25s ease;
    margin-left: 2px;
  }

  .skills-showcase .tag-toggle:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .skills-showcase .tag-toggle:active {
    transform: scale(0.96);
  }

  .skills-showcase .toggle-icon {
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1;
  }

  .skills-showcase .skill-tags.expanded .tag-toggle {
    border-style: solid;
    border-color: var(--color-primary);
    color: var(--color-primary-hover);
  }

  /* Hide toggle if no hidden tags */
  .skills-showcase .skill-tags:not(:has(.tag-hidden)) .tag-toggle,
  .skills-showcase .skill-tags:not(:has(.tag-hidden)) + .tag-toggle {
    display: none;
  }

  @keyframes skillsFadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tagPop {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes tagIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.skill-tags').forEach(container => {
      const hiddenTags = container.querySelectorAll('.tag-hidden');
      const toggleBtn = container.querySelector('.tag-toggle');
      const toggleIcon = toggleBtn?.querySelector('.toggle-icon');
      const toggleCount = toggleBtn?.querySelector('.toggle-count');

      if (!toggleBtn || hiddenTags.length === 0) {
        toggleBtn?.remove();
        return;
      }

      // Set initial count text
      if (toggleCount) {
        toggleCount.textContent = `${hiddenTags.length} more`;
      }

      toggleBtn.addEventListener('click', () => {
        const isExpanded = container.classList.toggle('expanded');
        
        if (isExpanded) {
          toggleIcon.textContent = '−';
          toggleCount.textContent = 'less';
          toggleBtn.setAttribute('aria-label', 'Show fewer tags');
        } else {
          toggleIcon.textContent = '+';
          toggleCount.textContent = `${hiddenTags.length} more`;
          toggleBtn.setAttribute('aria-label', 'Show more tags');
        }
      });
    });
  });
</script>