---
// Hero section
const base = import.meta.env.BASE_URL;
---

<section class="hero" id="engineer" aria-label="engineer">
  <div class="hero-atmosphere" aria-hidden="true">
    <span class="hero-halo"></span>
    <span class="hero-halo hero-halo--secondary"></span>
  </div>

  <div class="hero-content">
    <div class="greeting" data-hero>
      <div class="mask-medallion">
        <span class="medallion-ring" aria-hidden="true"></span>
        <span class="medallion-ring medallion-ring--conic" aria-hidden="true"></span>
        <span class="medallion-ring medallion-ring--dashed" aria-hidden="true"></span>
        <span class="medallion-glow" aria-hidden="true"></span>
        <a href="/about/" class="logo" aria-label="About Vuk1lis">
          <img src="/favicon.svg" alt="VUK1LIS" class="logo-img" width="280" height="280" decoding="async" loading="eager" />
        </a>
      </div>
    </div>

    <h1 class="hero-title" data-hero>
      <span class="title-mask">
        <span class="title-text">V For Vuk1lis</span>
      </span>
    </h1>

    <p class="hero-subtitle" data-hero>
      <span>DevOps</span>
      <span class="subtitle-sep" aria-hidden="true">-</span>
      <span>Linux Enthusiast</span>
      <span class="subtitle-sep" aria-hidden="true">-</span>
      <span>VibeCoder</span>
    </p>

    <p class="hero-description" data-hero>
      "Beneath this mask there is more than flesh. Beneath this mask there is an idea, and ideas are bulletproof."
    </p>

    <div class="hero-buttons" data-hero>
      <a href={`${base}projects/`} class="btn btn-primary">
        <span>View Projects</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href={`${base}blog/`} class="btn btn-secondary">
        <span>Read Blog</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; display: flex; align-items: center; justify-content: center; min-height: 100vh; min-height: 100svh; overflow: hidden; padding: calc(var(--nav-height) + 2.5rem) 2rem 5rem; }
  .hero-content { position: relative; z-index: 10; width: 100%; max-width: 860px; text-align: center; }
  .hero-atmosphere { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hero-halo { position: absolute; top: 2%; left: 50%; width: min(86vw, 920px); aspect-ratio: 1; transform: translateX(-50%); background: radial-gradient(circle, rgba(241, 196, 15, 0.09) 0%, rgba(241, 196, 15, 0.03) 38%, transparent 66%); animation: haloDrift 16s ease-in-out infinite alternate; }
  .hero-halo--secondary { top: 34%; width: min(55vw, 520px); background: radial-gradient(circle, rgba(249, 224, 118, 0.05) 0%, transparent 64%); animation-duration: 22s; animation-direction: alternate-reverse; }
  @keyframes haloDrift { from { transform: translate(-50%, -2%) scale(0.94); } to { transform: translate(-50%, 3%) scale(1.06); } }
  .greeting { margin-bottom: 1rem; }
  .mask-medallion { position: relative; display: grid; place-items: center; width: clamp(9.5rem, 16vw, 13rem); aspect-ratio: 1; margin: 0 auto; }
  .medallion-ring { position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--color-accent-purple); opacity: 0.28; pointer-events: none; }
  .medallion-ring--conic { inset: -2px; border: none; padding: 1.5px; background: conic-gradient(from 0deg, transparent 0deg 300deg, var(--color-accent-purple) 330deg, transparent 358deg); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude; opacity: 0.85; animation: medSpin 14s linear infinite; }
  .medallion-ring--dashed { inset: -15px; border: 1px dashed var(--color-accent-purple); opacity: 0.16; animation: medSpin 44s linear infinite reverse; }
  .medallion-glow { position: absolute; inset: 10%; border-radius: 50%; background: radial-gradient(circle, rgba(241, 196, 15, 0.24) 0%, transparent 68%); filter: blur(16px); animation: medGlow 6s ease-in-out infinite; pointer-events: none; }
  @keyframes medSpin { to { transform: rotate(360deg); } }
  @keyframes medGlow { 0%, 100% { opacity: 0.5; transform: scale(0.92); } 50% { opacity: 0.9; transform: scale(1.06); } }
  .logo { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; color: var(--color-text); }
  .logo-img { display: block; width: auto; height: clamp(7rem, 11vw, 10rem); border-radius: 50%; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease; filter: drop-shadow(0 10px 26px rgba(241, 196, 15, 0.22)) drop-shadow(0 3px 8px rgba(0, 0, 0, 0.45)); }
  .mask-medallion:hover .logo-img { transform: scale(1.035); filter: drop-shadow(0 16px 38px rgba(241, 196, 15, 0.36)) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5)); }
  .hero-title { margin-bottom: 1rem; font-family: var(--font-heading); font-size: clamp(3rem, 11vw, 7rem); font-weight: 700; line-height: 0.95; letter-spacing: -0.035em; }
  .title-mask { display: inline-block; padding: 0.06em 0.08em 0.1em; }
  .title-text { display: inline-block; background: linear-gradient(135deg, var(--color-text) 0%, var(--color-primary) 48%, var(--color-accent-purple) 100%); background-size: 200% auto; background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: gradientFlow 5s ease infinite; }
  @keyframes gradientFlow { 0% { background-position: 0% center; } 50% { background-position: 100% center; } 100% { background-position: 0% center; } }
  .hero-subtitle { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.65rem; margin-bottom: 1.35rem; font-family: var(--font-heading); font-size: clamp(1.05rem, 2.4vw, 1.6rem); font-weight: 500; color: var(--color-text); }
  .subtitle-sep { color: var(--color-accent-purple); font-size: 0.6em; opacity: 0.65; }
  .hero-description { max-width: 620px; margin: 0 auto 2.4rem; padding: 0 1.5rem; font-size: clamp(0.98rem, 1.45vw, 1.1rem); font-style: italic; line-height: 1.75; color: var(--color-text-dim); }
  .hero-buttons { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.875rem; margin-bottom: 2rem; }
  .btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.875rem 1.75rem; border: 1px solid transparent; border-radius: 0.875rem; font-family: var(--font-body, system-ui, sans-serif); font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.01em; text-decoration: none; white-space: nowrap; cursor: pointer; overflow: hidden; transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease, background 0.25s ease; }
  .btn-primary { background: linear-gradient(135deg, var(--color-primary, #f1c40f) 0%, var(--color-primary-hover, #d4a80e) 100%); color: #0b0b0c; box-shadow: 0 1px 2px rgba(241, 196, 15, 0.05), 0 4px 16px -2px rgba(241, 196, 15, 0.28); }
  .btn-primary::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, transparent 60%); opacity: 0; transition: opacity 0.25s ease; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 12px -2px rgba(241, 196, 15, 0.4), 0 8px 28px -4px rgba(241, 196, 15, 0.24); }
  .btn-primary:hover::before { opacity: 1; }
  .btn-primary:active { transform: translateY(0); }
  .btn-secondary { width: 12rem; border-color: rgba(100, 84, 21, 0.24); background: var(--color-bg-card); color: var(--color-text, #faf7f0); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
  .btn-secondary::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(135deg, rgba(241, 196, 15, 0.08) 0%, transparent 60%); opacity: 0; transition: opacity 0.25s ease; }
  .btn-secondary:hover { transform: translateY(-2px); border-color: var(--color-border-hover); color: var(--color-text, #faf7f0); box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.24); }
  .btn-secondary:hover::after { opacity: 1; }
  .btn-secondary:active { transform: translateY(0); }
  .btn-icon { flex-shrink: 0; transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
  .btn-primary:hover .btn-icon, .btn-secondary:hover .btn-icon { transform: translateX(3px); }
  .btn:focus-visible { outline: 2px solid var(--color-primary, #f1c40f); outline-offset: 3px; }
  .greeting { --order: 1; }
  .hero-title { --order: 2; }
  .hero-subtitle { --order: 3; }
  .hero-description { --order: 4; }
  .hero-buttons { --order: 5; }
  html.motion-ready .hero [data-hero] { opacity: 0; transform: translateY(18px); filter: blur(8px); }
  html.motion-ready .hero.is-ready [data-hero] { animation: heroIn 900ms cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--order, 0) * 90ms); }
  @keyframes heroIn { from { opacity: 0; transform: translateY(18px); filter: blur(8px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
  html.motion-ready .hero.is-ready .mask-medallion { animation: medallionIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.12s; }
  @keyframes medallionIn { from { transform: scale(0.84); } to { transform: scale(1); } }
  html.motion-ready .hero .title-mask { opacity: 0; transform: translateY(18px); filter: blur(8px); }
  html.motion-ready .hero.is-ready .title-mask { animation: heroIn 900ms cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(var(--order, 0) * 90ms); }
  @supports (animation-timeline: scroll()) { @media (prefers-reduced-motion: no-preference) { html.motion-ready .hero-content { animation: heroScroll linear both; animation-timeline: scroll(root); animation-range: 0 85vh; } } }
  @keyframes heroScroll { to { transform: translateY(-6vh); opacity: 0.2; } }
  @media (max-width: 768px) { .hero { padding: calc(var(--nav-height) + 4rem) 1.25rem 4.5rem; } .mask-medallion { width: 8.5rem; } .logo-img { height: 7.5rem; } .hero-title { font-size: clamp(2.6rem, 12.5vw, 4rem); } .hero-subtitle { gap: 0.45rem; font-size: 1rem; } .hero-description { margin-bottom: 1.9rem; padding: 0; font-size: 0.95rem; } .hero-buttons { flex-direction: column; align-items: stretch; gap: 0.75rem; padding: 0 1rem; } .btn { width: 100%; padding: 1rem 1.5rem; font-size: 1rem; } }
  [data-theme="light"] .hero-halo { background: radial-gradient(circle, rgba(212, 168, 14, 0.13) 0%, rgba(212, 168, 14, 0.04) 38%, transparent 66%); }
  [data-theme="light"] .medallion-glow { background: radial-gradient(circle, rgba(212, 168, 14, 0.2) 0%, transparent 68%); }
  [data-theme="light"] .logo-img { filter: drop-shadow(0 10px 24px rgba(100, 84, 21, 0.2)) drop-shadow(0 3px 8px rgba(100, 84, 21, 0.16)); }
  [data-theme="light"] .mask-medallion:hover .logo-img { filter: drop-shadow(0 16px 36px rgba(100, 84, 21, 0.26)) drop-shadow(0 4px 10px rgba(100, 84, 21, 0.2)); }
  @media (prefers-reduced-motion: reduce) { .hero-halo, .medallion-ring, .medallion-glow, .title-text, .hero-content { animation: none !important; } html.motion-ready .hero [data-hero] { opacity: 1 !important; transform: none !important; filter: none !important; animation: none !important; } html.motion-ready .hero .title-mask { clip-path: none !important; animation: none !important; } }
</style>

<script>
  (() => {
    const s = window, init = () => {
      const h = document.getElementById('engineer');
      if (!h || h.dataset.init) return;
      h.dataset.init = 'true';
      const r = document.documentElement, rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (rm) { r.classList.remove('motion-ready'); h.classList.add('is-ready'); return; }
      r.classList.add('motion-ready');
      let started = false;
      const reveal = () => { if (started) return; started = true; h.classList.add('is-ready'); },
            ldr = document.getElementById('app-loader');
      if (ldr && !r.classList.contains('app-ready')) {
        document.addEventListener('app:ready', reveal, { once: true });
        setTimeout(reveal, 3200);
      } else { setTimeout(reveal, 120); }
    };
    if (!s.__heroBound) { s.__heroBound = true; document.addEventListener('astro:page-load', init); }
    document.readyState !== 'loading' ? init() : document.addEventListener('DOMContentLoaded', init);
  })();
</script>