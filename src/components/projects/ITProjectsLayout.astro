---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import ProjectFilter from '../../components/projects/ProjectFilter.astro';
import Pagination from '../../components/Pagination.astro';
import '../../styles/projects/layout.css';
import '../../styles/projects/filter.css';
import '../../styles/projects/card.css';

interface Props {
  page: any;
  allProjectsForFilter: any[];
  activeCategory: string | undefined;
  title: string;
  subtitle: string;
  paginationBaseUrl: string;
  noResultsExtra?: string;
}

const { page, allProjectsForFilter, activeCategory, title, subtitle, paginationBaseUrl, noResultsExtra } = Astro.props;
---

<BaseLayout title="IT Projects - Vuk1lis"
  description="Explore IT projects, including Windows & Linux tooling, homelab experiments, and web development projects.">
  <Navigation />

  <main class="projects-page" id="main-content">
    <div class="container">

      <header class="projects-header">
        <div class="header-top-nav">
          <a href="/projects/" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Back to projects
          </a>
        </div>

        <h1 class="page-title">{title}</h1>
        <p class="page-subtitle">
          {subtitle}
        </p>
      </header>

      <ProjectFilter allProjects={allProjectsForFilter} activeCategory={activeCategory} baseUrl="/projects/it/" />

      <div class="projects-grid">
        {page?.data && page.data.length > 0 ? (
          page.data.map((project: any) => (
            <article class="project-card">
              <div class="project-card-content">
                {project.data.image && (
                  <div class="project-image">
                    <img src={project.data.image} alt={project.data.title} loading="lazy" />
                  </div>
                )}
                <h3 class="project-title">{project.data.title}</h3>
                <p class="project-description">{project.data.description}</p>
                {project.data.categories && project.data.categories.length > 0 && (
                  <div class="project-categories">
                    {project.data.categories.map((cat) => (
                      <span class="category">{cat}</span>
                    ))}
                  </div>
                )}
                {project.data.tags && project.data.tags.length > 0 && (
                  <div class="project-tags">
                    {project.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
                <div class="project-links">
                  {project.data.link && (
                    <a href={project.data.link} class="project-link" target="_blank" rel="noopener noreferrer">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                      Live Demo
                    </a>
                  )}
                  {project.data.github && (
                    <a href={project.data.github} class="project-link" target="_blank" rel="noopener noreferrer">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                      </svg>
                      GitHub
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        ) : (
          <p class="no-results">
            No projects found. {noResultsExtra}
          </p>
        )}
      </div>

      <Pagination
        page={page}
        baseUrl={paginationBaseUrl}
        showFirstLast={true}
        maxVisible={5}
      />
    </div>
  </main>
</BaseLayout>

<link rel="canonical" href={`${Astro.site}${typeof page.url === 'string' ? page.url : page.url.pathname}`} />
{(page as any).prev && <link rel="prev" href={(page as any).prev.href} />}
{(page as any).next && <link rel="next" href={(page as any).next.href} />}
