---
import type { CollectionEntry } from 'astro:content';
import BlogCard from './BlogCard.astro';

interface Props {
  allPosts: CollectionEntry<'blog'>[];
  currentPage?: number;
  pageSize?: number;
  activeTag?: string | undefined;
}

const { allPosts, pageSize = 12, activeTag } = Astro.props;

type BlogPost = CollectionEntry<'blog'>;

function getReadingTime(post: BlogPost): number {
  try {
    const body = (post as any).body ?? '';
    if (typeof body !== 'string' || body.trim().length === 0) {
      return 1;
    }
    const plainText = body
      .replace(/<[^>]*>/g, ' ')
      .replace(/[#*_`~\-\[\]\(\)!$|\\]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
    const words = plainText.split(' ').filter((word: string) => word.length > 0).length;
    return Math.max(1, Math.ceil(words / 200));
  } catch (e) {
    return 1;
  }
}
---

<div class="blog-sort" id="blog-sort">
  <div class="sort-controls">
    <span class="sort-label">Sort by</span>
    <div class="sort-buttons">
      <button
        class="sort-btn"
        data-sort="alpha-asc"
        data-sort-desc="alpha-desc"
        aria-label="Sort alphabetically ascending"
        title="A to Z"
        type="button"
      >
        <span class="sort-text">A/Z</span>
        <svg class="sort-icon sort-icon--up" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
        <svg class="sort-icon sort-icon--down" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <button
        class="sort-btn"
        data-sort="date-asc"
        data-sort-desc="date-desc"
        aria-label="Sort by date ascending"
        title="Oldest first"
        type="button"
      >
        <span class="sort-text">Date</span>
        <svg class="sort-icon sort-icon--up" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
        <svg class="sort-icon sort-icon--down" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <button
        class="sort-btn"
        data-sort="time-asc"
        data-sort-desc="time-desc"
        aria-label="Sort by reading time ascending"
        title="Shortest read first"
        type="button"
      >
        <span class="sort-text">Read time</span>
        <svg class="sort-icon sort-icon--up" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
        <svg class="sort-icon sort-icon--down" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <button
        class="clear-sort-btn"
        type="button"
        aria-label="Clear sort"
        title="Clear sort"
        hidden
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        Clear
      </button>
    </div>
  </div>

  <div class="blog-grid" id="blog-grid" data-page-size={pageSize}>
    {allPosts.map((post: BlogPost) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        lastmod={post.data.lastmod}
        slug={post.id}
        tags={post.data.tags}
        categories={post.data.categories}
        activeTag={activeTag}
        readingTime={getReadingTime(post)}
      />
    ))}
  </div>
</div>

<script is:inline>
  (function() {
    var currentSort = null;
    var currentPage = 1;
    var allElements = [];
    var sortedElements = [];
    var buttons = [];
    var clearBtn = null;
    var container = null;
    var lastPageUrl = '';

    function getReadingTimeFromCard(el) {
      var readingTime = parseInt(el.getAttribute('data-reading-time') || '0', 10);
      if (!readingTime || readingTime < 1) {
        var titleEl = el.querySelector('.blog-title');
        var descEl = el.querySelector('.blog-description');
        var text = '';
        if (titleEl) text += titleEl.textContent + ' ';
        if (descEl) text += descEl.textContent + ' ';
        var words = text.trim().split(/\s+/).filter(function(w) { return w.length > 0; }).length;
        return Math.max(1, Math.ceil(words / 200));
      }
      return readingTime;
    }

    function getCurrentPage() {
      var path = window.location.pathname;
      var match = path.match(/\/(\d+)\/?$/);
      if (match) {
        var page = parseInt(match[1], 10);
        if (page >= 1) return page;
      }
      return 1;
    }

    function showCurrentPage() {
      var grid = document.getElementById('blog-grid');
      var pageSize = grid ? parseInt(grid.getAttribute('data-page-size') || '12', 10) : 12;
      var page = getCurrentPage();
      var start = (page - 1) * pageSize;
      var end = start + pageSize;

      sortedElements.forEach(function(el, index) {
        if (index >= start && index < end) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    function sortPostsByAlpha(elements, ascending) {
      return elements.slice().sort(function(a, b) {
        var aTitle = (a.getAttribute('data-title') || '').toLowerCase();
        var bTitle = (b.getAttribute('data-title') || '').toLowerCase();
        var diff = aTitle.localeCompare(bTitle);
        return ascending ? diff : -diff;
      });
    }

    function sortPostsByDate(elements, ascending) {
      return elements.slice().sort(function(a, b) {
        var aTime = new Date(a.getAttribute('data-pub-date') || 0).getTime();
        var bTime = new Date(b.getAttribute('data-pub-date') || 0).getTime();
        var diff = aTime - bTime;
        return ascending ? diff : -diff;
      });
    }

    function sortPostsByReadingTime(elements, ascending) {
      return elements.slice().sort(function(a, b) {
        var aTime = getReadingTimeFromCard(a);
        var bTime = getReadingTimeFromCard(b);
        var diff = aTime - bTime;
        return ascending ? diff : -diff;
      });
    }

    function sortPosts(elements, sortKey) {
      switch (sortKey) {
        case 'alpha-asc':
          return sortPostsByAlpha(elements, true);
        case 'alpha-desc':
          return sortPostsByAlpha(elements, false);
        case 'date-asc':
          return sortPostsByDate(elements, true);
        case 'date-desc':
          return sortPostsByDate(elements, false);
        case 'time-asc':
          return sortPostsByReadingTime(elements, true);
        case 'time-desc':
          return sortPostsByReadingTime(elements, false);
        default:
          return elements;
      }
    }

    function updateClearButton() {
      if (!clearBtn) return;
      if (currentSort) {
        clearBtn.removeAttribute('hidden');
      } else {
        clearBtn.setAttribute('hidden', '');
      }
    }

    function updateButtonStates(activeSortKey) {
      buttons.forEach(function(btn) {
        var sort = btn.getAttribute('data-sort');
        var sortDesc = btn.getAttribute('data-sort-desc');
        var base = sort.replace(/-asc$/, '').replace(/-desc$/, '');
        var isActive = activeSortKey === sort || activeSortKey === sortDesc || (activeSortKey && activeSortKey.startsWith(base + '-'));
        btn.classList.toggle('active', isActive);

        var upIcon = btn.querySelector('.sort-icon--up');
        var downIcon = btn.querySelector('.sort-icon--down');
        if (upIcon && downIcon) {
          if (activeSortKey === base + '-asc') {
            upIcon.style.display = '';
            downIcon.style.display = 'none';
          } else if (activeSortKey === base + '-desc') {
            upIcon.style.display = 'none';
            downIcon.style.display = '';
          } else {
            upIcon.style.display = '';
            downIcon.style.display = 'none';
          }
        }
      });
    }

    function applySort(sortKey) {
      currentSort = sortKey;
      sortedElements = sortPosts(allElements.slice(), sortKey);

      var allGrids = document.querySelectorAll('#blog-grid');
      var grid = allGrids.length > 0 ? allGrids[allGrids.length - 1] : document.getElementById('blog-grid');
      if (!grid) return;

      sortedElements.forEach(function(el) {
        grid.appendChild(el);
      });

      showCurrentPage();
      updateClearButton();
      updateButtonStates(sortKey);
    }

    function updateUrl(sortKey) {
      var url = new URL(window.location);
      if (!sortKey) {
        url.searchParams.delete('sort');
      } else {
        url.searchParams.set('sort', sortKey);
      }
      history.pushState({ sort: sortKey }, '', url);
      
      var filter = document.querySelector('.blog-filter');
      if (filter) {
        var links = filter.querySelectorAll('.filter-pill[href]');
        links.forEach(function(link) {
          var href = link.getAttribute('href');
          if (!href) return;
          var base = href.split('?')[0];
          var linkParams = new URLSearchParams(href.split('?')[1] || '');
          if (sortKey) {
            linkParams.set('sort', sortKey);
          } else {
            linkParams.delete('sort');
          }
          var newHref = base + (linkParams.toString() ? '?' + linkParams.toString() : '');
          link.setAttribute('href', newHref);
        });
      }
      
      if (sortKey) {
        sessionStorage.setItem('blogSort', sortKey);
      } else {
        sessionStorage.removeItem('blogSort');
      }
    }

    function init() {
      var currentUrl = window.location.href;
      if (lastPageUrl === currentUrl) return;
      lastPageUrl = currentUrl;
      var allGrids = document.querySelectorAll('#blog-grid');
      var grid = allGrids.length > 0 ? allGrids[allGrids.length - 1] : document.getElementById('blog-grid');
      if (!grid) return;

      allElements = Array.from(grid.querySelectorAll('.blog-card'));
      sortedElements = allElements.slice();

      var allSorts = document.querySelectorAll('#blog-sort');
      container = allSorts.length > 0 ? allSorts[allSorts.length - 1] : document.getElementById('blog-sort');
      if (container) {
        buttons = container.querySelectorAll('.sort-btn');
        clearBtn = container.querySelector('.clear-sort-btn');
      }

      var params = new URLSearchParams(window.location.search);
      var sortFromUrl = params.get('sort');
      var validSorts = ['alpha-asc', 'alpha-desc', 'date-asc', 'date-desc', 'time-asc', 'time-desc'];
      if (sortFromUrl && validSorts.indexOf(sortFromUrl) !== -1) {
        currentSort = sortFromUrl;
      } else if (!sortFromUrl) {
        var storedSort = sessionStorage.getItem('blogSort');
        if (storedSort && validSorts.indexOf(storedSort) !== -1) {
          currentSort = storedSort;
        }
      }

      if (currentSort) {
        applySort(currentSort);
        updateUrl(currentSort);
      } else {
        showCurrentPage();
        updateClearButton();
      }

      if (container && buttons.length) {
        buttons.forEach(function(btn) {
          btn.addEventListener('click', function() {
            var sort = btn.getAttribute('data-sort');
            var sortDesc = btn.getAttribute('data-sort-desc');
            if (!sort || !sortDesc) return;

            var nextSort = currentSort === sort ? sortDesc : sort;
            applySort(nextSort);
            updateUrl(nextSort);
          });
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          applySort(null);
          updateUrl(null);
          sessionStorage.removeItem('blogSort');
        });
      }

      window.addEventListener('popstate', function(e) {
        if (e.state && e.state.sort) {
          currentSort = e.state.sort;
        } else {
          currentSort = null;
        }
        applySort(currentSort);
        showCurrentPage();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style>
  .blog-sort {
    margin-bottom: 2.5rem;
  }

  .sort-controls {
    display: flex;
    gap: .75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    flex-direction: column;
    width: fit-content;
  }

  .sort-label {
    font-family: var(--font-heading, 'Space Grotesk', sans-serif);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dim, #94A3B8);
  }

  .sort-buttons {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--sort-buttons-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--color-border, #334155);
    border-radius: 0.5rem;
    padding: 0.25rem;
  }

  .sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    background: transparent;
    border: none;
    border-radius: 0.375rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-body, 'DM Sans', sans-serif);
    letter-spacing: 0.02em;
    color: var(--color-text-dim, #94A3B8);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
    white-space: nowrap;
    position: relative;
  }

  .sort-btn:hover {
    color: var(--color-text, #E2E8F0);
    background: var(--sort-btn-hover-bg, rgba(255, 255, 255, 0.06));
  }

  .sort-btn.active {
    background: rgba(59, 130, 246, 0.15);
    color: var(--color-accent-blue, #3B82F6);
  }

  .sort-text {
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .sort-icon {
    flex-shrink: 0;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .sort-icon--up {
    display: none;
  }

  .sort-btn.active .sort-icon--up,
  .sort-btn.active .sort-icon--down {
    display: block;
  }

  .sort-btn:not(.active) .sort-icon--up {
    display: block;
    opacity: 0.6;
  }

  .sort-btn:not(.active) .sort-icon--down {
    display: none;
  }

  .clear-sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    margin-left: 0.25rem;
    background: var(--clear-sort-bg, rgba(239, 68, 68, 0.12));
    border: 1px solid var(--clear-sort-border, rgba(239, 68, 68, 0.35));
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-body, 'DM Sans', sans-serif);
    letter-spacing: 0.03em;
    color: var(--clear-sort-color, #fca5a5);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fadeIn 0.2s ease;
  }

  .clear-sort-btn:hover {
    background: var(--clear-sort-hover-bg, rgba(239, 68, 68, 0.2));
    border-color: var(--clear-sort-hover-border, rgba(239, 68, 68, 0.6));
    color: var(--clear-sort-hover-color, #fecaca);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
  }

  .clear-sort-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(239, 68, 68, 0.15);
  }

  .clear-sort-btn:focus-visible {
    outline: 2px solid var(--clear-sort-border, #f87171);
    outline-offset: 2px;
  }

  .clear-sort-btn[hidden] {
    display: none !important;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  :global(.blog-card.hidden) {
    display: none !important;
  }

  @media (max-width: 768px) {
    .sort-controls {
      gap: 0.35rem;
    }

    .sort-buttons {
      gap: 0.2rem;
      flex-wrap: wrap;
    }

    .sort-btn {
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
    }

    .sort-text {
      font-size: 0.75rem;
    }

    .sort-icon {
      width: 14px;
      height: 14px;
    }

    .clear-sort-btn {
      padding: 0.25rem 0.5rem;
      font-size: 0.75rem;
    }

    .clear-sort-btn svg {
      width: 14px;
      height: 14px;
    }
  }

  @media (max-width: 480px) {
    .sort-buttons {
      gap: 0.15rem;
      padding: 0.15rem;
    }

    .sort-btn {
      padding: 0.2rem 0.4rem;
      font-size: 0.75rem;
    }

    .sort-text {
      font-size: 0.75rem;
    }

    .sort-icon {
      width: 12px;
      height: 12px;
    }

    .clear-sort-btn {
      padding: 0.2rem 0.4rem;
      font-size: 0.75rem;
      margin-left: 0.15rem;
    }

    .clear-sort-btn svg {
      width: 12px;
      height: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sort-btn,
    .clear-sort-btn,
    .sort-icon {
      transition: none;
    }
  }
</style>
