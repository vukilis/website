---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteBackdrop from '../components/other/SiteBackdrop.astro';
import BackToTopButton from '../components/other/BackToTopButton.astro';
import Footer from '../components/Footer.astro';
import DamageNumbers from '../components/other/DamageNumbers.astro';
import HeroParticles from '../components/colab/HeroParticles.astro';
import Loader from '../components/other/Loader.astro';
import TiltCards from '../components/other/TiltCards.astro';
import LightGalleryInit from '../components/other/LightGalleryInit.astro';

import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript
} from '@digi4care/astro-google-tagmanager';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  hideFooter?: boolean;
}

const base = import.meta.env.BASE_URL;
const {
  title = 'Vuk1lis | V For Vuk1lis',
  description = 'My work sits at the intersection of art and technology. I build immersive digital experiences where dark aesthetics meet surgical performance. Every deployment is a revolution. Every animation is a statement.',
  keywords = 'vukilis, portfolio, creative developer, immersive experiences, dark aesthetics',
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="viewport" content="width=device-width" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${Astro.site}${base}logo.png`} />
    <meta property="og:site_name" content="Vuk1lis" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.site}${base}logo.png`} />

    <link rel="icon" type="image/png" href={`${base}favicon-96x96.png`} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="shortcut icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta name="apple-mobile-web-app-title" content="Vuk1lis" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    
    <meta name="generator" content={Astro.generator} />
    <!-- Google Fonts: Space Grotesk + DM Sans -->
    <title>{title}</title>
    
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'auto';
      }
    </script>
    
    <script is:inline>
      (function() {
        try {
          var stored = (typeof localStorage !== 'undefined' && localStorage.getItem('theme'));
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      (function() {
        try {
          if (sessionStorage.getItem('loader-seen') === 'true') {
            document.documentElement.classList.add('loader-seen');
          }
        } catch (e) {}
      })();
    </script>
    
    <ClientRouter prefetch={false} />
    <LightGalleryInit />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7134772077337777"
     crossorigin="anonymous"></script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="6253d22e-47b0-4cf0-aea1-f20de51d328f"></script>
    <GoogleTagmanager id="GTM-K7KG6MT7" />
  </head>
  <body>
    <GoogleTagmanagerNoscript id="GTM-K7KG6MT7" />
    <Loader />
    <SiteBackdrop />
    {Astro.url.pathname !== '/homelab/diagram/' && <HeroParticles />}
    <div class="vendetta-bg" aria-hidden="true">
      <div class="v-monogram">
        <span>V</span>
      </div>
    </div>
    <div id="page-content">
      <slot />
    </div>
    {!hideFooter && <Footer />}
    <!-- Theme Toggle -->
    <script is:inline>
      (function() {
        if (window.__themeInitialized) return;
        window.__themeInitialized = true;

        const html = document.documentElement;
        const STORAGE_KEY = 'theme';

        const getSystemTheme = () => 
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        const getSavedTheme = () => {
          try { return localStorage.getItem(STORAGE_KEY); } 
          catch (e) { return null; }
        };

        const getInitialTheme = () => getSavedTheme() || getSystemTheme();

        const TRANSITION_CSS_ID = '__theme-transition-disable';
        const TRANSITION_CSS = '*,*::before,*::after{transition:none!important;}';
        let transitionStyle = null;

        const ensureTransitionStyle = () => {
          if (!transitionStyle) {
            transitionStyle = document.createElement('style');
            transitionStyle.id = TRANSITION_CSS_ID;
            transitionStyle.textContent = TRANSITION_CSS;
            document.head.appendChild(transitionStyle);
          }
        };

        const removeTransitionStyle = () => {
          if (transitionStyle) {
            transitionStyle.remove();
            transitionStyle = null;
          }
        };

        let applyTheme = (theme, shouldPersist = true) => {
          ensureTransitionStyle();
          html.setAttribute('data-theme', theme);
          const btn = document.getElementById('theme-toggle');
          if (btn) {
            btn.setAttribute('aria-pressed', String(theme === 'dark'));
            btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
          }
          if (shouldPersist) try { localStorage.setItem(STORAGE_KEY, theme); } catch {}
          requestAnimationFrame(removeTransitionStyle);
        };

        const toggle = () => {
          const current = html.getAttribute('data-theme') || getSavedTheme() || getSystemTheme();
          applyTheme(current === 'dark' ? 'light' : 'dark', true);
        };

        // Apply theme immediately
        const initialSaved = getSavedTheme();
        applyTheme(initialSaved || getSystemTheme(), !!initialSaved);

        // Event delegation for the toggle button
        document.addEventListener('click', (e) => {
          const target = e.target;
          const toggleBtn = target && target.closest ? target.closest('#theme-toggle') : null;
          if (toggleBtn) {
            e.preventDefault();
            toggle();
          }
        });

        // Follow system preference only when no saved preference exists
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', (e) => {
          if (!getSavedTheme()) {
            applyTheme(e.matches ? 'dark' : 'light', false);
          }
        });

        // Re-enforce theme after every Astro view transition
        document.addEventListener('astro:page-load', () => {
          const saved = getSavedTheme();
          applyTheme(saved || getSystemTheme(), !!saved);
        });

        // Notify widgets that depend on theme (Giscus)
        const giscusContainer = () => document.querySelector('.giscus');
        const broadcastThemeChange = () => {
          const container = giscusContainer();
          if (container) {
            container.dispatchEvent(new CustomEvent('theme-changed', {
              detail: { theme: html.getAttribute('data-theme') || 'dark' },
              bubbles: true
            }));
          }
        };
        const originalApply = applyTheme;
        applyTheme = (theme, shouldPersist = true) => {
          originalApply(theme, shouldPersist);
          broadcastThemeChange();
        };
      })();
    </script>
    <script is:inline>
      // Remove loader after every Astro view transition
      document.addEventListener('astro:before-swap', (e) => {
        try {
          if (sessionStorage.getItem('loader-seen') === 'true') {
            var newLoader = e.newDocument.querySelector('#app-loader');
            if (newLoader) newLoader.remove();
          }
        } catch (err) {}
      });

      // Re-push AdSense ads after every Astro view transition
      // document.addEventListener('astro:after-swap', () => {
      //   if (window.adsbygoogle) {
      //     window.adsbygoogle.push({});
      //   }
      // });

      // Track Umami pageviews after every Astro view transition
      document.addEventListener('astro:after-swap', () => {
        if (window.umami) window.umami.track();
      });
    </script>
    <BackToTopButton />
    <DamageNumbers />
    <TiltCards />
    <!-- Scroll restoration -->
    <script>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      let currentPath = window.location.pathname;
      let fromPath = currentPath;
      const isBlogList = (path) => path === '/blog/' || /^\/blog\/\d+\/?$/.test(path) || path.startsWith('/blog/category/') || path.startsWith('/blog/tag/');
      const isBlogSection = (path) => isBlogList(path) || /^\/blog\/\d{4}\//.test(path);
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.pagination-page, .pagination-icon')) {
          try {
            sessionStorage.setItem('pagination-clicked', 'true');
          } catch (err) {}
          return;
        }
        const link = target.closest('a');
        if (link && link.href && link.origin === window.location.origin) {
          try {
            const destUrl = new URL(link.href);
            fromPath = currentPath;
            if (!isBlogList(destUrl.pathname) && sessionStorage.getItem('scroll-' + destUrl.pathname)) {
              sessionStorage.removeItem('scroll-' + destUrl.pathname);
            }
          } catch (err) {}
        }
      });
      document.addEventListener('astro:before-swap', () => {
        if (isBlogList(currentPath)) {
          try {
            sessionStorage.setItem('scroll-' + currentPath, String(window.scrollY));
          } catch (e) {}
        }
      });
      window.addEventListener('pagehide', () => {
        if (isBlogList(currentPath)) {
          try {
            sessionStorage.setItem('scroll-' + currentPath, String(window.scrollY));
          } catch (e) {}
        }
      });
      function handleScrollRestore() {
        const prevPath = fromPath;
        currentPath = window.location.pathname;
        fromPath = currentPath;
        if (sessionStorage.getItem('pagination-clicked') === 'true') {
          sessionStorage.removeItem('pagination-clicked');
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        if (!isBlogList(currentPath)) {
          window.scrollTo(0, 0);
          return;
        }
        const wasFromBlog = isBlogSection(prevPath);
        const savedPos = parseInt(sessionStorage.getItem('scroll-' + currentPath) || '0', 10);
        if (savedPos > 0 && wasFromBlog) {
          requestAnimationFrame(() => {
            window.scrollTo({ top: savedPos, behavior: 'instant' });
          });
          return;
        }
        window.scrollTo(0, 0);
      }
      window.addEventListener('DOMContentLoaded', handleScrollRestore);
      document.addEventListener('astro:page-load', handleScrollRestore);

      function updateBlogListPath() {
        const path = window.location.pathname;
        const isBlogList = path === '/blog/' || /^\/blog\/\d+\/?$/.test(path) || path.startsWith('/blog/category/') || path.startsWith('/blog/tag/');
        if (isBlogList) {
          try { sessionStorage.setItem('blog-list-path', path); } catch (e) {}
        }
      }

      document.addEventListener('astro:page-load', updateBlogListPath);
    </script>
  </body>
</html>
