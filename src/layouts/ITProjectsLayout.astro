---
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ProjectFilter from '../components/projects/ProjectFilter.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import Pagination from '../components/other/Pagination.astro';
import Icon from '../components/other/Icon.astro';
import '../styles/projects/layout.css';
import '../styles/projects/filter.css';

interface Props {
  page: any;
  allProjectsForFilter: any[];
  activeCategory: string | undefined;
  title: string;
  subtitle: string;
  paginationBaseUrl: string;
  noResultsExtra?: string;
  keywords?: string;
}

const { page, allProjectsForFilter, activeCategory, title, subtitle, paginationBaseUrl, noResultsExtra, keywords } = Astro.props;
---

<BaseLayout title="IT Projects | Vuk1lis"
  description="Explore IT projects, including Windows & Linux tooling, homelab experiments, and web development projects."
  {keywords}
>
  <Navigation />

  <main class="projects-page" id="main-content">
    <div class="container">

      <header class="projects-header">
        <div class="header-top-nav">
          <a href="/projects/" class="back-link">
            <Icon name="arrow-left" /> Back to Projects
          </a>
        </div>

        <h1 class="page-title">{title}</h1>
        <p class="page-subtitle">
          {subtitle}
        </p>
      </header>

      <ProjectFilter allProjects={allProjectsForFilter} activeCategory={activeCategory} baseUrl="/projects/it/" />

      <div class="projects-grid" data-lightgallery>
        {page?.data && page.data.length > 0 ? (
          page.data.map((project: any) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              image={project.data.image}
              link={project.data.link}
              github={project.data.github}
              blog={project.data.blog}
              tags={project.data.tags}
              categories={project.data.categories}
              license={project.data.license}
              featured={project.data.featured}
              draft={project.data.draft}
              status={project.data.status}
            />
          ))
        ) : (
          <p class="no-results">
            No projects found. {noResultsExtra}
          </p>
        )}
      </div>

      <Pagination
        page={page}
        baseUrl={paginationBaseUrl}
        showFirstLast={true}
        maxVisible={5}
      />
    </div>
  </main>
</BaseLayout>

<link rel="canonical" href={`${Astro.site}${typeof page.url === 'string' ? page.url : page.url.pathname}`} />
{(page as any).prev && <link rel="prev" href={(page as any).prev.href} />}
{(page as any).next && <link rel="next" href={(page as any).next.href} />}
