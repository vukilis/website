---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import BlogSearch from '../../components/blog/BlogSearch.astro';
import BlogFilter from '../../components/blog/BlogFilter.astro';
import BlogSort from '../../components/blog/BlogSort.astro';
import Pagination from '../../components/other/Pagination.astro';
import '../../styles/blog/layout.css';

export async function getStaticPaths({ paginate }: { paginate: (...args: any[]) => Promise<any[]> }) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = allPosts.sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(sorted, {
    pageSize: 12,
    format: (p: any) => `/blog/${!p || p === '/' || p === 1 ? '' : p}`
  });
}

const { page } = Astro.props;

const allPostsForSearch = await getCollection('blog', ({ data }) => !data.draft);
const sortedAllPosts = allPostsForSearch.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const url = new URL(Astro.url);
const sortParam = url.searchParams.get('sort');
const queryString = sortParam ? `sort=${encodeURIComponent(sortParam)}` : '';
---

<BaseLayout
  title="Blog | Vuk1lis"
  description="This blog is made to document all my work, store a different guides and how-to articles."
  keywords="vukilis, blog, articles, guides, tutorials, how-to, tech blog, devops, linux, web development, coding, automation, docker, kubernetes, programming, software engineering, infrastructure, cloud, tutorials, guides"
>
  <Navigation />

  <main class="blog-page" id="main-content">
    <div class="container">
      <header class="blog-header">
        <h1 class="page-title">Blog</h1>
        <p class="page-subtitle">
          This blog is made to document all my work, store a different guides and how-to articles
        </p>
        <div class="blog-stats">
          <div class="blog-stat">
            <div class="blog-stat-value">{sortedAllPosts.length}</div>
            <div class="blog-stat-label">Articles</div>
            <div class="blog-stat-flame" aria-hidden="true"></div>
          </div>
          <div class="blog-stat">
            <div class="blog-stat-value">{new Set(sortedAllPosts.flatMap(p => p.data.tags ?? [])).size}</div>
            <div class="blog-stat-label">
              <a href="/blog/tag/" class="blog-stat-link">
                Tags
                <svg class="feature-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
              </a>
            </div>
            <div class="blog-stat-flame" aria-hidden="true"></div>
          </div>
          <div class="blog-stat">
            <div class="blog-stat-value">{new Set(sortedAllPosts.flatMap(p => p.data.categories ?? [])).size}</div>
            <div class="blog-stat-label">Categories</div>
            <div class="blog-stat-flame" aria-hidden="true"></div>
          </div>
        </div>
      </header>

      <BlogSearch allPosts={sortedAllPosts as any} />
      <BlogFilter allPosts={sortedAllPosts as any} />
      <BlogSort allPosts={sortedAllPosts as any} currentPage={page.currentPage} />

      <Pagination page={page} baseUrl="/blog" showFirstLast={true} maxVisible={5} queryString={queryString} />
    </div>
  </main>
</BaseLayout>

<link rel="canonical" href={`${Astro.site}${typeof page.url === 'string' ? page.url : page.url.pathname}`} />
{(page as any).prev && <link rel="prev" href={(page as any).prev.href} />}
{(page as any).next && <link rel="next" href={(page as any).next.href} />}
