---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import BlogSearch from '../../components/blog/BlogSearch.astro';
import BlogFilter from '../../components/blog/BlogFilter.astro';
import BlogSort from '../../components/blog/BlogSort.astro';
import Pagination from '../../components/Pagination.astro';
import '../../styles/blog/layout.css';

export async function getStaticPaths({ paginate }: { paginate: (...args: any[]) => Promise<any[]> }) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(sorted, {
    pageSize: 12,
    format: (p) => `/blog/${!p || p === '/' || p === 1 ? '' : p}`
  });
}

const { page } = Astro.props;

const allPostsForSearch = await getCollection('blog', ({ data }) => !data.draft);
const sortedAllPosts = allPostsForSearch.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const url = new URL(Astro.url);
const sortParam = url.searchParams.get('sort');
const queryString = sortParam ? `sort=${encodeURIComponent(sortParam)}` : '';
---

<BaseLayout
  title="Blog - Vuk1lis"
  description="This blog is made to document all my work, store a different guides and how-to articles."
>
  <Navigation />

  <main class="blog-page" id="main-content">
    <div class="container">
      <header class="blog-header">
        <h1 class="page-title">Blog</h1>
        <p class="page-subtitle">
          This blog is made to document all my work, store a different guides and how-to articles.
        </p>
      </header>

      <BlogSearch allPosts={sortedAllPosts} />
      <BlogFilter allPosts={sortedAllPosts} activeCategory={undefined} />
      <BlogSort allPosts={sortedAllPosts} currentPage={page.currentPage} />

      <Pagination page={page} baseUrl="/blog" showFirstLast={true} maxVisible={5} queryString={queryString} />

      <script is:inline>
        (function() {
          const SCROLL_KEY = 'blog-list-scroll-pos';
          const PATH_KEY = 'blog-list-path';
          const FLAG_KEY = 'blog-list-scroll-top';

          function saveScroll() {
            try {
              if (!/^\/blog\/?$/.test(window.location.pathname) && !/^\/blog\/\d+\/?$/.test(window.location.pathname)) return;
              sessionStorage.setItem(SCROLL_KEY, String(window.scrollY));
              sessionStorage.setItem(PATH_KEY, window.location.pathname + window.location.search);
            } catch (e) {}
          }

          function restoreScroll() {
            try {
              const flag = sessionStorage.getItem(FLAG_KEY);
              if (flag === '1') {
                sessionStorage.removeItem(FLAG_KEY);
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
              }
              const savedPos = parseInt(sessionStorage.getItem(SCROLL_KEY) || '0', 10);
              const savedPath = sessionStorage.getItem(PATH_KEY) || '';
              if (savedPath && window.location.pathname + window.location.search === savedPath && savedPos > 0) {
                requestAnimationFrame(() => window.scrollTo({ top: savedPos, behavior: 'instant' }));
              }
            } catch (e) {}
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', restoreScroll);
          } else {
            restoreScroll();
          }

          document.addEventListener('astro:page-load', restoreScroll);
          document.addEventListener('astro:before-page-load', saveScroll);
          window.addEventListener('beforeunload', saveScroll);
          window.addEventListener('pagehide', saveScroll);

          document.addEventListener('click', function(e) {
            var card = e.target.closest('.blog-card');
            if (card) {
              saveScroll();
            }
          });

          document.addEventListener('click', function(e) {
            var pagLink = e.target.closest('.pagination-page, .pagination-icon');
            if (pagLink) {
              try {
                sessionStorage.setItem(FLAG_KEY, '1');
              } catch (err) {}
            }
          });
        })();
      </script>
    </div>
  </main>
</BaseLayout>

<link rel="canonical" href={`${Astro.site}${typeof page.url === 'string' ? page.url : page.url.pathname}`} />
{(page as any).prev && <link rel="prev" href={(page as any).prev.href} />}
{(page as any).next && <link rel="next" href={(page as any).next.href} />}
