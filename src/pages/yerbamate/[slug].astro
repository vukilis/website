---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Mate from '../../components/mate/Mate.astro';
import CommentSystem from "../../components/blog/CommentSystem.astro";
import Icon from '../../components/other/Icon.astro';
import '../../styles/mate/layout.css';

export async function getStaticPaths() {
  const entries = await getCollection('yerbaMate', ({ data }) => !data.draft);
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.name} - Yerba Mate Review`}
  description={`${entry.data.name} - ${entry.data.type}`}
  keywords={`vukilis, yerba mate, ${entry.data.name}, mate review, argentina, yerba mate reviews, mate tea, south american tea, traditional drink, mate culture, herbal tea, mate rating, mate comparison, best yerba mate, mate types, mate flavors, yerba mate guide, mate blog, tea reviews, mate recommendations`}
>
  <Navigation />
  <main class="yerba-review-page">
    <div class="container" data-lightgallery>
      <a href="/yerbamate/" class="back-link" id="back-to-mates">
        <Icon name="arrow-left" /> Back to Reviews
      </a>
      <Mate
        name={entry.data.name}
        category={entry.data.category}
        image={entry.data.image}
        rating={entry.data.rating}
        type={entry.data.type}
        complexity={entry.data.complexity}
        body={entry.data.body}
        durability={entry.data.durability}
        effect={entry.data.effect}
        level={entry.data.level}
      >
        <Content />
      </Mate>
      <br />
      <br />
      
      <section class="comments-section">
        <h2 class="comment-section-title">
          Join the Conversation
        </h2>
        <p class="comment-section-sub">Drop a thought. Share an idea. Ideas are bulletproof.</p>
        <CommentSystem />
      </section>
    </div>
  </main>
</BaseLayout>

