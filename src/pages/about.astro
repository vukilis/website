<BaseLayout title="About - Vuk1lis" description="My work sits at the intersection of art and technology. I build immersive digital experiences where dark aesthetics meet surgical performance. Every deployment is a revolution. Every animation is a statement. I don't just write code - I orchestrate infrastructure like a symphony, and craft interfaces that feel like they were pulled from another dimension." keywords="vukilis, about, bio, creative developer, devops, linux, gaming, euro truck simulator, no man's sky, left 4 dead 2, path of exile, rocket league, doom, tv shows, movies, football, partizan, paok, santos, boca juniors">
  <Navigation />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">

  <VendettaSection logo={LOGO} />
  <NomansskySection />
  <ArcadeSection {games} {shows} {movies} {clubs} />
  <TerminalLightbox id="termLightbox" />
  <AboutPageScript />
</BaseLayout>
