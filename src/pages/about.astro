---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const games = [
  { name: 'Euro Truck Simulator 2', color: '#ff6b00', icon: 'truck' },
  { name: "No Man's Sky", color: '#00d4aa', icon: 'planet' },
  { name: 'Left 4 Dead 2', color: '#4ade80', icon: 'bio' },
  { name: 'Path of Exile', color: '#d97706', icon: 'orb' },
  { name: 'GTA Vice City', color: '#ec4899', icon: 'palm' },
  { name: 'Prototype 2', color: '#dc2626', icon: 'claw' },
  { name: 'DOOM 2016', color: '#ff2200', icon: 'doom' },
  { name: 'Rocket League', color: '#3b82f6', icon: 'rocket' },
];
---

<BaseLayout title="Vuk1lis — About" description="DevOps engineer, Linux main, VibeCoder. Three worlds. One player.">
  <Navigation />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">

  <!-- ═══════════════════════════════════════
       SECTION 1 — V FOR VENDETTA
       ═══════════════════════════════════════ -->
  <section class="vendetta" id="about">
    <div class="v-mask-bg" aria-hidden="true">
      <svg viewBox="0 0 200 260" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M100 20 C60 20 30 60 30 110 C30 150 50 180 70 200 L70 240 L85 220 L100 240 L115 220 L130 240 L130 200 C150 180 170 150 170 110 C170 60 140 20 100 20Z" fill="currentColor"/>
        <path d="M55 90 Q75 80 85 100 Q65 110 55 90Z" fill="#000"/>
        <path d="M145 90 Q125 80 115 100 Q135 110 145 90Z" fill="#000"/>
        <path d="M85 130 Q100 125 115 130 Q100 150 85 130Z" fill="#000"/>
        <path d="M70 170 Q100 185 130 170" stroke="#000" stroke-width="3" fill="none"/>
        <path d="M95 60 L100 50 L105 60" stroke="currentColor" stroke-width="2" fill="none"/>
      </svg>
    </div>

    <div class="v-rose v-rose-1" aria-hidden="true">
      <svg viewBox="0 0 60 100" fill="none"><path d="M30 100 L30 60" stroke="#8b0000" stroke-width="2"/><path d="M30 60 C20 50 10 40 20 30 C30 20 40 30 30 60" fill="#a00000"/><path d="M30 60 C40 50 50 40 40 30 C30 20 20 30 30 60" fill="#c00000"/><circle cx="30" cy="25" r="12" fill="#ff1a1a"/></svg>
    </div>
    <div class="v-rose v-rose-2" aria-hidden="true">
      <svg viewBox="0 0 60 100" fill="none"><path d="M30 100 L30 60" stroke="#8b0000" stroke-width="2"/><path d="M30 60 C20 50 10 40 20 30 C30 20 40 30 30 60" fill="#a00000"/><circle cx="30" cy="25" r="10" fill="#ff1a1a"/></svg>
    </div>

    <div class="v-content">
      <p class="v-pretitle">Remember, remember…</p>
      <h1 class="v-title">The Developer<br/>Behind the Mask</h1>

      <div class="v-card">
        <p class="v-lead">I'm <strong>Vuk1lis</strong> — a DevOps engineer, Linux enthusiast, and VibeCoder.</p>
        <p>My work sits at the intersection of art and technology. I build immersive digital experiences where dark aesthetics meet surgical performance. Every deployment is a revolution. Every animation is a statement.</p>
        <p>I don't just write code — I orchestrate infrastructure like a symphony, and craft interfaces that feel like they were pulled from another dimension.</p>
      </div>

      <blockquote class="v-quote">
        <span class="q-mark">"</span>
        Beneath this mask there is more than flesh. Beneath this mask there is an idea, and ideas are bulletproof.
        <span class="q-mark">"</span>
      </blockquote>

      <div class="v-stats">
        <div class="v-stat"><span class="v-num">5+</span><span class="v-label">Years in the shadows</span></div>
        <div class="v-stat"><span class="v-num">40+</span><span class="v-label">Repos liberated</span></div>
        <div class="v-stat"><span class="v-num">99.9%</span><span class="v-label">Uptime resistance</span></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SECTION 2 — NO MAN'S SKY UNIVERSE
       ═══════════════════════════════════════ -->
  <section class="nomanssky" id="universe">
    <div class="nms-stars" aria-hidden="true"></div>
    <div class="nms-scan" aria-hidden="true"></div>
    <div class="nms-aurora" aria-hidden="true"></div>

    <div class="nms-header">
      <h2 class="nms-title">Vuk1lis Universe</h2>
      <p class="nms-sub">Explore my projects, infrastructure &amp; interests</p>
    </div>

    <div class="nms-grid">

      <!-- Homelab -->
      <article class="nms-card nms-homelab">
        <div class="nms-badge">HOMELAB</div>
        <h3>Homelab Network Diagram</h3>
        <a href="/homelab_diagram/" class="homelab-diagram">
          <div class="h-preview">
            <img src="https://raw.githubusercontent.com/vukilis/homelab/main/diagram.png" alt="Homelab Network Diagram Preview" class="h-preview-img" />
            <span class="h-preview-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              PREVIEW
            </span>
          </div>
        </a>
        <p class="nms-desc">Self-hosted infrastructure. Proxmox cluster, Authentik for SSO, AdGuard Home for DNS and many more.</p>
      </article>

      <!-- GitHub Terminal -->
      <article class="nms-card nms-github">
        <div class="nms-badge">Github Info</div>
        <h3>GitHub README</h3>
        <div class="terminal" id="githubTerminal">
          <div class="term-header">
            <span class="term-btn"></span><span class="term-btn"></span><span class="term-btn"></span>
            <span class="term-title">vukilis@github:~/README.md</span>
            <button class="term-expand" id="termExpandBtn" aria-label="Expand README">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>
          </div>
          <div class="term-body" id="readmeContent">
            <div class="term-line"><span class="term-prompt">$</span> <span class="term-cmd">curl -s https://raw.githubusercontent.com/vukilis/vukilis/main/README.md</span></div>
            <div class="term-line term-loading">Establishing uplink<span class="term-blink">_</span></div>
          </div>
        </div>
      </article>

      <!-- Steam Status -->
      <article class="nms-card nms-steam">
        <div class="nms-badge">STEAM STATUS</div>
        <h3>Steam Beacon</h3>
        <a href="https://steamcommunity.com/id/vuk1lis/" target="_blank" rel="noopener" class="steam-diagram" aria-label="Open Steam profile">
          <div class="s-preview">
            <span class="home-avatar">
              <img class="steam-icon" src="https://cdn.jsdelivr.net/gh/selfhst/icons@main/webp/steam.webp" alt="Steam" width="30" title="Steam Status">
            </span>
            <span class="s-preview-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
              PREVIEW
            </span>
            <div class="steam-status-label" id="steamStatusLabel">OFFLINE</div>
          </div>
        </a>
        <p class="nms-desc">
          <span class="status-legend">
            <span class="status-item"><span class="status-dot" style="--dot:#33ff33"></span>Online</span>
            <span class="status-item"><span class="status-dot" style="--dot:#ff3333"></span>Busy</span>
            <span class="status-item"><span class="status-dot" style="--dot:#ffff33"></span>Away</span>
            <span class="status-item"><span class="status-dot" style="--dot:#33ccff"></span>Trading</span>
            <span class="status-item"><span class="status-dot" style="--dot:#ff00ff"></span>Playing</span>
            <span class="status-item"><span class="status-dot" style="--dot:#888"></span>Offline</span>
          </span>
        </p>
      </article>

      <!-- Yerba Mate -->
      <a href="/yerbamate/" class="nms-card nms-yerba">
        <div class="nms-badge">MATE REVIEW</div>
        <h3>Yerba Mate Review</h3>
        <div class="yerba-diagram">
          <div class="y-preview">
          <span class="yerba-emoji" aria-hidden="true">🧉</span>
          <span class="y-preview-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            PREVIEW
          </span>
          <div class="yerba-status-label">MATE</div>
          </div>
        </div>
        <p class="nms-desc">A full review about yerba mate - from traditional gourd rituals to modern energy boosts.</p>
      </a>

    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SECTION 3 — GAMING ARCADE
       ═══════════════════════════════════════ -->
  <section class="arcade" id="gaming">
    <div class="arcade-crt" aria-hidden="true">
      <div class="crt-scan"></div>
      <div class="crt-flicker"></div>
    </div>
    <div class="arcade-floor" aria-hidden="true"></div>

    <div class="arcade-header">
      <h2 class="arcade-title">SELECT YOUR GAME</h2>
      <p class="arcade-sub">Player 1 — Insert Coin to Continue</p>
      <div class="arcade-coin-slot">
        <div class="coin-light"></div>
        <span>CREDITS: ∞</span>
      </div>
    </div>

    <div class="games-grid">
      {games.map((game, i) => (
        <div class="game-card" style={`--glow:${game.color};--i:${i}`}>
          <div class="card-glitch" aria-hidden="true"></div>
          <div class="card-number">{String(i + 1).padStart(2, '0')}</div>
          
          <div class="card-icon">
            {game.icon === 'truck' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5" stroke-linecap="round"><rect x="8" y="20" width="28" height="16" rx="2"/><circle cx="16" cy="36" r="3"/><circle cx="32" cy="36" r="3"/><path d="M36 28h4a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-6v8z"/><path d="M8 28H4v-4"/></svg>
            )}
            {game.icon === 'planet' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5"><circle cx="24" cy="24" r="10"/><ellipse cx="24" cy="24" rx="18" ry="5" transform="rotate(-20 24 24)"/></svg>
            )}
            {game.icon === 'bio' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5"><path d="M24 4 C12 4 8 14 8 20 C8 32 16 40 24 44 C32 40 40 32 40 20 C40 14 36 4 24 4Z"/><circle cx="24" cy="20" r="6"/></svg>
            )}
            {game.icon === 'orb' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5"><circle cx="24" cy="24" r="12"/><path d="M24 12 L24 18 M24 30 L24 36 M12 24 L18 24 M30 24 L36 24"/></svg>
            )}
            {game.icon === 'palm' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5"><path d="M24 44 L24 28"/><path d="M24 28 Q16 20 10 24"/><path d="M24 28 Q32 18 38 22"/><path d="M24 28 Q24 14 20 8"/><circle cx="36" cy="10" r="3" opacity="0.5"/></svg>
            )}
            {game.icon === 'claw' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5"><path d="M16 40 L16 28 L12 20 L20 24 L24 16 L28 24 L36 20 L32 28 L32 40"/><path d="M24 16 L24 8"/></svg>
            )}
            {game.icon === 'doom' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5"><path d="M14 12 L14 36 L24 40 L34 36 L34 12 L24 8 Z"/><path d="M18 20 L18 28 L24 30 L30 28 L30 20"/></svg>
            )}
            {game.icon === 'rocket' && (
              <svg viewBox="0 0 48 48" fill="none" stroke={game.color} stroke-width="2.5"><circle cx="24" cy="24" r="8"/><path d="M10 38 Q24 28 38 38"/><rect x="22" y="10" width="4" height="8"/></svg>
            )}
          </div>
          
          <h3 class="card-name">{game.name}</h3>
          <div class="card-bar"><div class="card-bar-fill"></div></div>
          <div class="card-tag">FAVORITE</div>
        </div>
      ))}
    </div>
  </section>

      <div class="term-lightbox" id="termLightbox">
        <div class="term-lightbox-content">
          <div class="term-lightbox-header">
            <span class="term-title">vukilis@github:~/README.md — Full Size</span>
            <button class="term-lightbox-close" id="termLightboxClose" aria-label="Close">✕</button>
          </div>
          <div class="term-body term-body-full" id="readmeContentFull"></div>
        </div>
      </div>

</BaseLayout>

<style is:global>
  /* ═══════════════════════════════════════
     V FOR VENDETTA THEME
     ═══════════════════════════════════════ */
  .vendetta {
    position: relative;
    min-height: 100vh;
    color: var(--color-text);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--nav-height, 64px) + 4rem) 1.5rem 5rem;
  }
  .v-mask-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ff0000;
    opacity: 0.04;
    pointer-events: none;
  }
  .v-mask-bg svg { width: min(80vw, 600px); height: auto; }
  
  .v-rose {
    position: absolute;
    width: 50px;
    opacity: 0.25;
    pointer-events: none;
    animation: roseFloat 8s ease-in-out infinite;
  }
  .v-rose-1 { top: 15%; left: 8%; animation-delay: 0s; }
  .v-rose-2 { bottom: 20%; right: 10%; animation-delay: -4s; width: 40px; }
  @keyframes roseFloat {
    0%,100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  .v-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    text-align: center;
  }
  .v-pretitle {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: #8b0000;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .v-title {
    font-family: var(--font-heading, system-ui, sans-serif);
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    margin: 0 0 2rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-shadow: 0 0 60px rgba(139,0,0,0.4);
  }
  .v-card {
    background: rgba(139,0,0,0.06);
    border: 1px solid rgba(139,0,0,0.25);
    border-left: 3px solid #8b0000;
    border-radius: 4px;
    padding: 2rem;
    text-align: left;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(4px);
  }
  .v-card p {
    font-size: 1rem;
    line-height: 1.75;
    color: #b0b0b0;
    margin: 0 0 1rem;
  }
  .v-card p:last-child { margin-bottom: 0; }
  .v-lead { font-size: 1.125rem !important; color: #e0e0e0 !important; }
  .v-lead strong { color: #ff1a1a; font-weight: 700; }

  .v-quote {
    position: relative;
    font-style: italic;
    font-size: 1.125rem;
    color: #cc0000;
    line-height: 1.6;
    padding: 0 1.5rem;
    margin: 0 0 2.5rem;
  }
  .q-mark {
    color: #8b0000;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .v-stats {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .v-stat { text-align: center; }
  .v-num {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: #ff1a1a;
    font-family: var(--font-heading);
    text-shadow: 0 0 20px rgba(255,26,26,0.3);
  }
  .v-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
    margin-top: 0.25rem;
  }

  /* ═══════════════════════════════════════
     NO MAN'S SKY THEME
     ═══════════════════════════════════════ */
  .nomanssky {
    position: relative;
    min-height: 100vh;
    color: var(--color-text);
    padding: 5rem 1.5rem 6rem;
    overflow: hidden;
  }
  .nms-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.5px 1.5px at 20px 40px, rgba(255,255,255,0.8), transparent),
      radial-gradient(1.5px 1.5px at 60px 120px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 120px 80px, rgba(255,255,255,0.7), transparent),
      radial-gradient(1.5px 1.5px at 180px 20px, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 240px 160px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1.5px 1.5px at 300px 90px, rgba(255,255,255,0.8), transparent),
      radial-gradient(1px 1px at 340px 50px, rgba(255,255,255,0.4), transparent),
      radial-gradient(1.5px 1.5px at 400px 140px, rgba(255,255,255,0.7), transparent),
      radial-gradient(1px 1px at 450px 30px, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 500px 110px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 560px 70px, rgba(255,255,255,0.8), transparent),
      radial-gradient(1.5px 1.5px at 620px 150px, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 680px 40px, rgba(255,255,255,0.7), transparent),
      radial-gradient(1.5px 1.5px at 740px 130px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 800px 60px, rgba(255,255,255,0.8), transparent),
      radial-gradient(1.5px 1.5px at 860px 170px, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 920px 90px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1.5px 1.5px at 980px 20px, rgba(255,255,255,0.7), transparent),
      radial-gradient(1px 1px at 1040px 140px, rgba(255,255,255,0.8), transparent),
      radial-gradient(1.5px 1.5px at 1100px 80px, rgba(255,255,255,0.5), transparent);
    background-size: 1200px 200px;
    animation: starScroll 60s linear infinite;
    pointer-events: none;
  }
  @keyframes starScroll { to { transform: translateY(-200px); } }
  
  .nms-scan {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0,255,255,0.4), transparent);
    animation: scanMove 5s linear infinite;
    pointer-events: none;
  }
  @keyframes scanMove { 0% { top: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 100%; opacity: 0; } }

  .nms-aurora {
    position: absolute;
    top: 20%; left: -20%; right: -20%;
    height: 300px;
    background: radial-gradient(ellipse at 50% 50%, rgba(0,212,170,0.08) 0%, transparent 60%);
    filter: blur(60px);
    pointer-events: none;
    animation: auroraShift 10s ease-in-out infinite alternate;
  }
  @keyframes auroraShift { from { transform: translateX(-5%) rotate(-2deg); } to { transform: translateX(5%) rotate(2deg); } }

  .nms-header { text-align: center; margin-bottom: 3rem; position: relative; z-index: 2; }
  .nms-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: #00ffff;
    text-shadow: 0 0 30px rgba(0,255,255,0.25);
    letter-spacing: 0.02em;
  }
  .nms-sub { font-size: 1rem; color: #7aa; margin: 0; }
  .nms-highlight { color: #00d4aa; font-weight: 600; }

  .nms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    max-width: 960px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .nms-card {
    position: relative;
    border: 1px solid rgba(0,212,170,0.2);
    border-radius: 14px;
    background: rgba(6,10,20,0.65);
    backdrop-filter: blur(12px);
    padding: 1.5rem;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  .nms-card:hover {
    border-color: rgba(0,212,170,0.5);
    box-shadow: 0 8px 40px rgba(0,212,170,0.1);
    transform: translateY(-3px);
  }
  .nms-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #00d4aa;
    border: 1px solid rgba(0,212,170,0.3);
    padding: 3px 10px;
    border-radius: 4px;
    margin-bottom: 0.75rem;
  }
  .nms-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: #e0f2f1;
  }
  .nms-desc {
    font-size: 0.8125rem;
    color: #7aa;
    line-height: 1.6;
    margin: 0.75rem 0 0;
  }
  .nms-link {
    display: inline-flex;
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #00d4aa;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .nms-link:hover { color: #00ffff; text-shadow: 0 0 10px rgba(0,255,255,0.4); }

  /* Homelab diagram */
  .homelab-diagram { width: 100%; position: relative; }
