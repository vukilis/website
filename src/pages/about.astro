const clubs = [
  { name: 'FK Partizan', color: 'var(--color-text)', img: partizanImg, url: 'https://www.partizan.rs/' },
  { name: 'PAOK FC', color: 'var(--color-text)', img: paokImg, url: 'https://www.paokfc.gr/' },
  { name: 'Santos FC', color: 'var(--color-text)', img: santosImg, url: 'https://www.santosfc.com.br/' },
