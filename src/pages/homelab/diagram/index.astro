---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import HomelabHeader from '../../../components/homelab/HomelabHeader.astro';
import '../../../styles/homelab/diagram.css';

const diagramSrc = "https://assets.vukilis.com/it/homelab-diagram.svg";
---

<BaseLayout title="Homelab Diagram | Vuk1lis" description="Live diagram — I run a homelab with over 100 containerized services. I use it to experiment with different tools, improve my skills in containerization and automation, and simulate production-like setups. It is where I usually test new ideas and figure out what actually works in practice." keywords="vukilis, homelab, homelab diagram, network diagram, containerization, docker, kubernetes, automation, self-hosted, home lab, infrastructure, networking, servers, virtualization, self-hosting, home server, tech setup, network topology, homelab services, devops home lab">
  <Navigation />

  <section class="homelab-page">
    <div class="h-page-bg" aria-hidden="true">
      <div class="h-grid"></div>
      <svg class="h-network" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="nodeGrad" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#00d4aa" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#00d4aa" stop-opacity="0"/>
          </radialGradient>
          <filter id="glow">
            <feGaussianBlur stdDeviation="2.5" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        <g class="h-network-lines" stroke="#00d4aa" stroke-opacity="0.08" stroke-width="1"></g>
        <g class="h-network-nodes" fill="#00d4aa" filter="url(#glow)"></g>
        <g class="h-network-pulses"></g>
      </svg>
      <div class="h-particles" id="hParticles"></div>
      <div class="h-glow h-glow-1"></div>
      <div class="h-glow h-glow-2"></div>
    </div>

    <HomelabHeader />

    <div class="h-page-diagram">
      <div id="diagram-container" class="diagram-container">
        <div id="diagram-loader" class="diagram-loader">
          <div class="loader-content">
            <div class="loader-spinner"></div>
            <p class="loader-text">Loading diagram…</p>
          </div>
        </div>

        {/* Panzoom Wrapper */}
        <div id="pan-wrapper" class="pan-wrapper">
          <img 
            id="diagram-svg" 
            src={diagramSrc} 
            alt="Homelab Diagram" 
            draggable="false"
            fetchpriority="high"
          />
        </div>

        {/* Floating Zoom Controls */}
        <div class="zoom-controls">
          <button id="zoom-in" aria-label="Zoom in">+</button>
          <button id="zoom-out" aria-label="Zoom out">−</button>
          <button id="zoom-reset" aria-label="Reset zoom">⤢</button>
        </div>
      </div>
    </div>
  </section>

  <script type="module">
    import Panzoom from '@panzoom/panzoom';

    function initHomelab() {
      const wrapper = document.getElementById('pan-wrapper');
      
      if (!wrapper || wrapper.dataset.panzoomReady === 'true') return;
      wrapper.dataset.panzoomReady = 'true';

      const img = document.getElementById('diagram-svg');
      const loader = document.getElementById('diagram-loader');
      const container = document.getElementById('diagram-container');
      const pageElement = document.querySelector('.homelab-page');
      
      let panzoomInstance = null;
      let rafId = null;
      let targetX = 0;
      let targetY = 0;

      // Smooth Animation Loop (Lerp)
      const animatePan = () => {
        if (!panzoomInstance) return;
        const currentPan = panzoomInstance.getPan();
        const lerpFactor = 0.15; // 0.1 = smoother/slower, 0.2 = faster
        
        const nextX = currentPan.x + (targetX - currentPan.x) * lerpFactor;
        const nextY = currentPan.y + (targetY - currentPan.y) * lerpFactor;
        
        panzoomInstance.pan(nextX, nextY);
        
        // Continue animating until we reach the target
        if (Math.abs(targetX - nextX) > 0.5 || Math.abs(targetY - nextY) > 0.5) {
          rafId = requestAnimationFrame(animatePan);
        } else {
          rafId = null;
        }
      };

      // 1. Initialize Panzoom and Hide Loader
      const startPan = () => {
        loader.classList.remove('is-visible');
        
        panzoomInstance = Panzoom(wrapper, {
          maxScale: 5,
          minScale: 1,
          contain: 'outside',
          cursor: 'grab',
          step: 0.5
        });

        // Pause background animations for performance while dragging
        wrapper.addEventListener('panzoomstart', () => {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = null;
          wrapper.style.cursor = 'grabbing';
          if (pageElement) pageElement.classList.add('is-dragging');
        });

        wrapper.addEventListener('panzoomend', () => {
          wrapper.style.cursor = 'grab';
          if (pageElement) pageElement.classList.remove('is-dragging');
        });
      };

      if (img.complete && img.naturalWidth > 0) {
        startPan();
      } else if (img.complete) {
        loader.classList.remove('is-visible');
      } else {
        loader.classList.add('is-visible');
        img.addEventListener('load', startPan);
        img.addEventListener('error', () => loader.classList.remove('is-visible'));
      }

      // 2. Zoom Controls
      container.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn || !panzoomInstance) return;
        
        e.stopPropagation();
        e.preventDefault();

        if (btn.id === 'zoom-in') panzoomInstance.zoomIn();
        else if (btn.id === 'zoom-out') panzoomInstance.zoomOut();
        else if (btn.id === 'zoom-reset') panzoomInstance.reset();
      });

      // 3. Scroll to Pan (up/down) & Ctrl+Scroll to Zoom
      container.addEventListener('wheel', (e) => {
        if (!panzoomInstance) return;
        
        const scale = panzoomInstance.getScale();
        if (scale > 1 || e.ctrlKey) {
          e.preventDefault();
          
          if (e.ctrlKey) {
            if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
            panzoomInstance.zoomWithWheel(e);
          } else {
            const deltaX = e.shiftKey ? e.deltaY : e.deltaX;
            const deltaY = e.shiftKey ? 0 : e.deltaY;
            
            if (!rafId) {
              const currentPan = panzoomInstance.getPan();
              targetX = currentPan.x;
              targetY = currentPan.y;
            }
            
            targetX -= deltaX;
            targetY -= deltaY;
            
            if (!rafId) {
              rafId = requestAnimationFrame(animatePan);
            }
          }
        }
      }, { passive: false });

      // 4. Background Effects (Particles & Network)
      const particles = document.getElementById('hParticles');
      if (particles) {
        const count = window.innerWidth < 768 ? 15 : 30;
        for (let i = 0; i < count; i++) {
          const p = document.createElement('div');
          p.className = 'h-particle';
          p.style.left = Math.random() * 100 + '%';
          p.style.top = Math.random() * 100 + '%';
          p.style.animationDelay = Math.random() * 8 + 's';
          p.style.animationDuration = (6 + Math.random() * 6) + 's';
          particles.appendChild(p);
        }
      }

      const svg = document.querySelector('.h-network');
      if (svg) {
        const linesGroup = svg.querySelector('.h-network-lines');
        const nodesGroup = svg.querySelector('.h-network-nodes');
        const pulsesGroup = svg.querySelector('.h-network-pulses');
        const width = 1440, height = 900;
        const nodeCount = window.innerWidth < 768 ? 12 : 22;
        const maxDist = 280;
        const nodes = [];

        for (let i = 0; i < nodeCount; i++) {
          nodes.push({ x: 80 + Math.random() * (width - 160), y: 80 + Math.random() * (height - 160) });
        }

        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const dx = nodes[i].x - nodes[j].x;
            const dy = nodes[i].y - nodes[j].y;
            if (Math.sqrt(dx * dx + dy * dy) < maxDist) {
              const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
              line.setAttribute('x1', nodes[i].x);
              line.setAttribute('y1', nodes[i].y);
              line.setAttribute('x2', nodes[j].x);
              line.setAttribute('y2', nodes[j].y);
              linesGroup.appendChild(line);

              const pulse = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
              pulse.setAttribute('r', '2');
              const duration = 2.5 + Math.random() * 3;
              const delay = Math.random() * 5;
              pulse.innerHTML = `
                <animate attributeName="cx" values="${nodes[i].x};${nodes[j].x}" dur="${duration}s" begin="${delay}s" repeatCount="indefinite"/>
                <animate attributeName="cy" values="${nodes[i].y};${nodes[j].y}" dur="${duration}s" begin="${delay}s" repeatCount="indefinite"/>
                <animate attributeName="opacity" values="0;0.9;0.9;0" dur="${duration}s" begin="${delay}s" repeatCount="indefinite"/>
              `;
              pulsesGroup.appendChild(pulse);
            }
          }
        }
        nodes.forEach(node => {
          const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          circle.setAttribute('cx', node.x);
          circle.setAttribute('cy', node.y);
          circle.setAttribute('r', '3.5');
          nodesGroup.appendChild(circle);

          const glow = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          glow.setAttribute('cx', node.x);
          glow.setAttribute('cy', node.y);
          glow.setAttribute('r', '10');
          glow.setAttribute('fill', 'url(#nodeGrad)');
          glow.style.opacity = '0.4';
          nodesGroup.appendChild(glow);
        });
      }
    }
    initHomelab();
    document.addEventListener('astro:page-load', initHomelab);
  </script>
</BaseLayout>