---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TiltCards from '../../components/other/TiltCards.astro';
import '../../styles/homelab/layout.css';

const categories = [
  {
    title: 'EQUIPMENT MANIFEST',
    description: 'Authorized inventory of systems, components and network',
    href: '/homelab/devices/',
  },
  {
    title: 'HOMELAB DIAGRAM',
    description: 'Self-hosted infrastructure and services running at home.',
    href: '/homelab/diagram/',
  },
  {
    title: 'HOMELAB DOCUMENTATION',
    description: 'Learn more about the infrastructure and services behind my homelab.',
    href: '/blog/2026/homelab-documentation/',
  },
];
---

<BaseLayout
  title="Homelab - Vuk1lis"
  description="Central hub for my homelab. Explore PC parts, devices, and the full interactive network diagram of my infrastructure."
  keywords="vukilis, homelab, PC parts, devices, servers, homelab diagram, network topology, infrastructure, containerization, docker, kubernetes, proxmox, devops, self-hosted"
>
  <Navigation />

  <main class="homelab-page" id="main-content">

    <div class="container">
      <header class="homelab-header">
        <h1 class="page-title">Homelab</h1>
        <p class="page-subtitle">
          Select a category to explore
        </p>
      </header>

      <div class="category-grid">
        {categories.map((category, index) => (
          <a href={category.href} class={`category-card ${index === 0 ? 'card-animated' : ''} ${index === 1 ? 'card-diagram' : ''} ${index === 2 ? 'card-docs' : ''}`}>
            <div class="card-inner">
              {index === 0 ? (
                <svg class="animated-scene" viewBox="0 0 500 350" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <filter id="glow-sm">
                    <feGaussianBlur stdDeviation="3" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <filter id="glow-md">
                    <feGaussianBlur stdDeviation="6" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <filter id="glow-lg">
                    <feGaussianBlur stdDeviation="12" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <pattern id="dot-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                    <circle cx="12.5" cy="12.5" r="0.7" fill="rgba(255,255,255,0.04)"/>
                  </pattern>
                </defs>

                <rect width="500" height="350" fill="url(#dot-grid)"/>

                <ellipse cx="300" cy="314" rx="85" ry="6" fill="rgba(0,0,0,0.25)"/>

                <g class="server">
                  <rect x="218" y="35" width="164" height="270" rx="10" fill="none" stroke="#475569" stroke-width="1.8" opacity="0.7"/>

                  <line x1="243" y1="55" x2="357" y2="55" stroke="#334155" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="61" x2="357" y2="61" stroke="#334155" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="67" x2="357" y2="67" stroke="#334155" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="73" x2="357" y2="73" stroke="#334155" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="79" x2="357" y2="79" stroke="#334155" stroke-width="1.2" stroke-linecap="round"/>

                  <rect x="236" y="92" width="128" height="34" rx="4" fill="none" stroke="#334155" stroke-width="1.2" opacity="0.7"/>
                  <rect x="241" y="97" width="84" height="24" rx="2" fill="none" stroke="#253245" stroke-width="0.8" opacity="0.7"/>
                  <circle cx="352" cy="109" r="3.5" fill="none" stroke="#334155" stroke-width="1.2" class="drive-led dl-1" opacity="0.7"/>

                  <rect x="236" y="134" width="128" height="34" rx="4" fill="none" stroke="#334155" stroke-width="1.2" opacity="0.7"/>
                  <rect x="241" y="139" width="84" height="24" rx="2" fill="none" stroke="#253245" stroke-width="0.8" opacity="0.7"/>
                  <circle cx="352" cy="151" r="3.5" fill="none" stroke="#334155" stroke-width="1.2" class="drive-led dl-2" opacity="0.7"/>

                  <rect x="236" y="176" width="128" height="34" rx="4" fill="none" stroke="#334155" stroke-width="1.2" opacity="0.7"/>
                  <rect x="241" y="181" width="84" height="24" rx="2" fill="none" stroke="#253245" stroke-width="0.8" opacity="0.7"/>
                  <circle cx="352" cy="193" r="3.5" fill="none" stroke="#334155" stroke-width="1.2" class="drive-led dl-3" opacity="0.7"/>

                  <circle cx="300" cy="237" r="24" fill="none" stroke="#334155" stroke-width="1.5" opacity="0.7"/>
                  <circle cx="300" cy="237" r="22" fill="none" stroke="#1e2d42" stroke-width="0.8" opacity="0.7"/>

                  <g class="fan-blades">
                    <ellipse cx="300" cy="224" rx="3" ry="8" fill="none" stroke="#334155" stroke-width="1" transform="rotate(0, 300, 237)" opacity="0.7"/>
                    <ellipse cx="300" cy="224" rx="3" ry="8" fill="none" stroke="#334155" stroke-width="1" transform="rotate(60, 300, 237)" opacity="0.7"/>
                    <ellipse cx="300" cy="224" rx="3" ry="8" fill="none" stroke="#334155" stroke-width="1" transform="rotate(120, 300, 237)" opacity="0.7"/>
                    <ellipse cx="300" cy="224" rx="3" ry="8" fill="none" stroke="#334155" stroke-width="1" transform="rotate(180, 300, 237)" opacity="0.7"/>
                    <ellipse cx="300" cy="224" rx="3" ry="8" fill="none" stroke="#334155" stroke-width="1" transform="rotate(240, 300, 237)" opacity="0.7"/>
                    <ellipse cx="300" cy="224" rx="3" ry="8" fill="none" stroke="#334155" stroke-width="1" transform="rotate(300, 300, 237)" opacity="0.7"/>
                    <circle cx="300" cy="237" r="5" fill="none" stroke="#334155" stroke-width="1"/>
                  </g>

                  <circle cx="245" cy="280" r="4" fill="none" stroke="#334155" stroke-width="1.2" class="led led-power"/>
                  <circle cx="260" cy="280" r="3" fill="none" stroke="#334155" stroke-width="1.2" class="led led-hdd"/>
                  <circle cx="273" cy="280" r="3" fill="none" stroke="#334155" stroke-width="1.2" class="led led-net"/>

                  <rect x="298" y="273" width="26" height="14" rx="2" fill="none" stroke="#334155" stroke-width="1.2" opacity="0.7"/>
                  <rect x="302" y="276" width="18" height="8" rx="1.5" fill="none" stroke="#253245" stroke-width="0.8" opacity="0.7"/>

                  <circle cx="363" cy="280" r="7" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.7"/>
                  <path d="M363 274 L363 278" stroke="#475569" stroke-width="1.8" stroke-linecap="round" class="power-icon" opacity="0.7"/>
                  <path d="M358 277 A6 6 0 1 0 368 277" fill="none" stroke="#475569" stroke-width="1.5" stroke-linecap="round" class="power-icon-arc" opacity="0.7"/>
                </g>

                <g class="yubikey">
                  <rect x="53" y="273" width="20" height="14" rx="1.5" fill="none" stroke="#64748b" stroke-width="1.2" opacity="0.7"/>
                  <rect x="58" y="266" width="82" height="28" rx="6" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.7"/>

                  <rect x="64" y="272" width="58" height="16" rx="4" fill="none" stroke="#d4a017" stroke-width="1.5"/>

                  <circle cx="108" cy="280" r="6" fill="none" stroke="#d4a017" stroke-width="1.2" class="yk-touch" opacity="0.7"/>
                  <circle cx="108" cy="280" r="3" fill="none" stroke="#d4a017" stroke-width="1" opacity="0.5" class="yk-touch-inner"/>

                  <circle cx="74" cy="280" r="3" fill="none" stroke="#334155" stroke-width="1.2" class="yk-led" opacity="0.7"/>

                  <circle cx="136" cy="280" r="4" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.7"/>
                </g>

                <circle cx="311" cy="280" r="8" fill="none" stroke="#f1c40f" stroke-width="1.5" class="insertion-spark" opacity="0" filter="url(#glow-lg)"/>

                <text class="auth-text" x="300" y="335" text-anchor="middle" fill="#22c55e" font-size="11" font-family="'Courier New', monospace" opacity="0" letter-spacing="3" filter="url(#glow-sm)">ACCESS GRANTED</text>
              </svg>
            ) : index === 1 ? (
              <svg class="animated-scene-diagram" viewBox="0 0 500 350" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <filter id="glow-diag">
                    <feGaussianBlur stdDeviation="4" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <pattern id="diag-dot-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                    <circle cx="12.5" cy="12.5" r="0.7" fill="rgba(255,255,255,0.04)"/>
                  </pattern>
                </defs>

                <rect width="500" height="350" fill="url(#diag-dot-grid)"/>

                <g class="net-paths" fill="none" stroke-width="1.5" opacity="0.5">
                  <path class="npath p1" d="M250 175 L150 100" stroke="#334155"/>
                  <path class="npath p2" d="M250 175 L350 100" stroke="#334155"/>
                  <path class="npath p3" d="M250 175 L150 250" stroke="#334155"/>
                  <path class="npath p4" d="M250 175 L350 250" stroke="#334155"/>
                </g>

                <g class="node core-node">
                  <polygon points="250,150 275,175 250,200 225,175" fill="none" stroke="#475569" stroke-width="2"/>
                  <circle cx="250" cy="175" r="5" fill="none" stroke="#3b82f6" stroke-width="1.5" class="core-dot"/>
                </g>

                <g class="node peripheral-node">
                  <rect x="125" y="75" width="50" height="50" rx="6" fill="none" stroke="#334155" stroke-width="1.5"/>
                  <circle cx="150" cy="100" r="4" fill="none" stroke="#22c55e" stroke-width="1.2" class="inode i-1"/>
                </g>

                <g class="node peripheral-node">
                  <rect x="325" y="75" width="50" height="50" rx="6" fill="none" stroke="#334155" stroke-width="1.5"/>
                  <circle cx="350" cy="100" r="4" fill="none" stroke="#f59e0b" stroke-width="1.2" class="inode i-2"/>
                </g>

                <g class="node peripheral-node">
                  <rect x="125" y="225" width="50" height="50" rx="6" fill="none" stroke="#334155" stroke-width="1.5"/>
                  <circle cx="150" cy="250" r="4" fill="none" stroke="#3b82f6" stroke-width="1.2" class="inode i-3"/>
                </g>

                <g class="node peripheral-node">
                  <rect x="325" y="225" width="50" height="50" rx="6" fill="none" stroke="#334155" stroke-width="1.5"/>
                  <circle cx="350" cy="250" r="4" fill="none" stroke="#22c55e" stroke-width="1.2" class="inode i-4"/>
                </g>
              </svg>
            ) : index === 2 ? (
              <svg class="animated-scene-docs" viewBox="0 0 500 350" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <filter id="glow-doc">
                    <feGaussianBlur stdDeviation="4" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <pattern id="doc-dot-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                    <circle cx="12.5" cy="12.5" r="0.7" fill="rgba(255,255,255,0.04)"/>
                  </pattern>
                </defs>

                <rect width="500" height="350" fill="url(#doc-dot-grid)"/>

                <rect x="105" y="55" width="220" height="274" rx="6" fill="none" stroke="#475569" stroke-width="1.5" opacity="0.7"/>

                <line x1="105" y1="91" x2="325" y2="91" stroke="#334155" stroke-width="1.2" opacity="0.7"/>

                <circle cx="122" cy="73" r="4" fill="none" stroke="#ef4444" stroke-width="1.2" opacity="0.7"/>
                <circle cx="137" cy="73" r="4" fill="none" stroke="#f59e0b" stroke-width="1.2" opacity="0.7"/>
                <circle cx="152" cy="73" r="4" fill="none" stroke="#22c55e" stroke-width="1.2" opacity="0.7"/>

                <line class="dline dl0" x1="125" y1="108" x2="305" y2="108" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl1" x1="125" y1="122" x2="265" y2="122" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl2" x1="125" y1="136" x2="285" y2="136" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl3" x1="125" y1="158" x2="225" y2="158" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl4" x1="125" y1="172" x2="295" y2="172" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl5" x1="125" y1="186" x2="255" y2="186" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl6" x1="125" y1="200" x2="280" y2="200" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl7" x1="125" y1="222" x2="245" y2="222" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl8" x1="125" y1="236" x2="300" y2="236" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl9" x1="125" y1="250" x2="215" y2="250" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl10" x1="125" y1="264" x2="270" y2="264" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>
                <line class="dline dl11" x1="125" y1="278" x2="285" y2="278" stroke="#334155" stroke-width="2.5" stroke-linecap="round" opacity="0.5"/>

                <circle class="dpart dp0" cx="370" cy="80" r="2" fill="none" stroke="#f1c40f" stroke-width="1" opacity="0"/>
                <circle class="dpart dp1" cx="415" cy="200" r="1.5" fill="none" stroke="#f1c40f" stroke-width="1" opacity="0"/>
                <circle class="dpart dp2" cx="355" cy="270" r="1.8" fill="none" stroke="#f1c40f" stroke-width="1" opacity="0"/>
                <circle class="dpart dp3" cx="435" cy="120" r="1.2" fill="none" stroke="#f1c40f" stroke-width="1" opacity="0"/>
                <circle class="dpart dp4" cx="395" cy="310" r="1.5" fill="none" stroke="#f1c40f" stroke-width="1" opacity="0"/>
              </svg>
            ) : null}
            <div class="card-glare"></div>
            <div class="category-card-overlay"></div>
            <div class="category-card-content">
              <h2 class="category-title">{category.title}</h2>
              <p class="category-description">{category.description}</p>
              <span class="category-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </div>
          </a>
        ))}
      </div>
    </div>

    <TiltCards />
  </main>
</BaseLayout>