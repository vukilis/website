---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import TiltCards from '../../components/other/TiltCards.astro';
import '../../styles/homelab/layout.css';

const categories = [
  {
    title: 'EQUIPMENT MANIFEST',
    description: 'Authorized inventory of systems, components and network',
    href: '/homelab/devices/',
  },
  {
    title: 'HOMELAB DIAGRAM',
    description: 'Self-hosted infrastructure and services running at home.',
    href: '/homelab/diagram/',
    image: 'https://pub-0bfee21847d045719fbf99633ea24028.r2.dev/it/homelab-diagram.webp',
  },
  // {
  //   title: 'DOCUMENTATION',
  //   description: 'Learn more about my homelab and its services.',
  //   href: '/blog/2026/homelab-documentation/',
  //   image: 'https://pub-0bfee21847d045719fbf99633ea24028.r2.dev/it/homelab-diagram.webp',
  // },
];
---

<BaseLayout
  title="Homelab - Vuk1lis"
  description="Central hub for my homelab. Explore PC parts, devices, and the full interactive network diagram of my infrastructure."
  keywords="vukilis, homelab, PC parts, devices, servers, homelab diagram, network topology, infrastructure, containerization, docker, kubernetes, proxmox, devops, self-hosted"
>
  <Navigation />

  <main class="homelab-page" id="main-content">

    <div class="container">
      <header class="homelab-header">
        <h1 class="page-title">Homelab</h1>
        <p class="page-subtitle">
          Select a category to explore
        </p>
      </header>

      <div class="category-grid">
        {categories.map((category, index) => (
          <a href={category.href} class={`category-card ${index === 0 ? 'card-animated' : ''}`}>
            <div class="card-inner">
              {index === 0 ? (
                <svg class="animated-scene" viewBox="0 0 500 350" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="gold-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#b8860b"/>
                    <stop offset="25%" stop-color="#f1c40f"/>
                    <stop offset="50%" stop-color="#ffe066"/>
                    <stop offset="75%" stop-color="#f1c40f"/>
                    <stop offset="100%" stop-color="#b8860b"/>
                  </linearGradient>
                  <linearGradient id="server-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#1e293b"/>
                    <stop offset="100%" stop-color="#0f172a"/>
                  </linearGradient>
                  <linearGradient id="connector-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#c0c0c0"/>
                    <stop offset="50%" stop-color="#a0a0a0"/>
                    <stop offset="100%" stop-color="#808080"/>
                  </linearGradient>
                  <filter id="glow-sm">
                    <feGaussianBlur stdDeviation="3" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <filter id="glow-md">
                    <feGaussianBlur stdDeviation="6" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <filter id="glow-lg">
                    <feGaussianBlur stdDeviation="12" result="blur"/>
                    <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                  </filter>
                  <pattern id="dot-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                    <circle cx="12.5" cy="12.5" r="0.7" fill="rgba(255,255,255,0.04)"/>
                  </pattern>
                </defs>

                <!-- Background dot grid -->
                <rect width="500" height="350" fill="url(#dot-grid)"/>

                <!-- Server shadow -->
                <ellipse cx="300" cy="314" rx="85" ry="6" fill="rgba(0,0,0,0.25)"/>

                <!-- ===== SERVER ===== -->
                <g class="server">
                  <!-- Main body -->
                  <rect x="218" y="35" width="164" height="270" rx="10" fill="url(#server-grad)" stroke="#334155" stroke-width="2"/>

                  <!-- Top ventilation slits -->
                  <line x1="243" y1="55" x2="357" y2="55" stroke="#293548" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="61" x2="357" y2="61" stroke="#293548" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="67" x2="357" y2="67" stroke="#293548" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="73" x2="357" y2="73" stroke="#293548" stroke-width="1.2" stroke-linecap="round"/>
                  <line x1="243" y1="79" x2="357" y2="79" stroke="#293548" stroke-width="1.2" stroke-linecap="round"/>

                  <!-- Drive bay 1 -->
                  <rect x="236" y="92" width="128" height="34" rx="4" fill="#0c1322" stroke="#253245" stroke-width="1"/>
                  <rect x="241" y="97" width="84" height="24" rx="2" fill="#151f30" stroke="#1e2d42" stroke-width="0.5"/>
                  <rect x="241" y="97" width="3" height="24" rx="1" fill="#253245"/>
                  <circle cx="352" cy="109" r="3.5" fill="#293548" class="drive-led dl-1"/>

                  <!-- Drive bay 2 -->
                  <rect x="236" y="134" width="128" height="34" rx="4" fill="#0c1322" stroke="#253245" stroke-width="1"/>
                  <rect x="241" y="139" width="84" height="24" rx="2" fill="#151f30" stroke="#1e2d42" stroke-width="0.5"/>
                  <rect x="241" y="139" width="3" height="24" rx="1" fill="#253245"/>
                  <circle cx="352" cy="151" r="3.5" fill="#293548" class="drive-led dl-2"/>

                  <!-- Drive bay 3 -->
                  <rect x="236" y="176" width="128" height="34" rx="4" fill="#0c1322" stroke="#253245" stroke-width="1"/>
                  <rect x="241" y="181" width="84" height="24" rx="2" fill="#151f30" stroke="#1e2d42" stroke-width="0.5"/>
                  <rect x="241" y="181" width="3" height="24" rx="1" fill="#253245"/>
                  <circle cx="352" cy="193" r="3.5" fill="#293548" class="drive-led dl-3"/>

                  <!-- Fan housing -->
                  <circle cx="300" cy="237" r="28" fill="none" stroke="#253245" stroke-width="1.5"/>
                  <circle cx="300" cy="237" r="26" fill="#0c1322" stroke="#1e2d42" stroke-width="0.5"/>

                  <!-- Fan blades (6 blades) -->
                  <g class="fan-blades">
                    <ellipse cx="300" cy="222" rx="4" ry="13" fill="#1e2d42" transform="rotate(0, 300, 237)"/>
                    <ellipse cx="300" cy="222" rx="4" ry="13" fill="#1e2d42" transform="rotate(60, 300, 237)"/>
                    <ellipse cx="300" cy="222" rx="4" ry="13" fill="#1e2d42" transform="rotate(120, 300, 237)"/>
                    <ellipse cx="300" cy="222" rx="4" ry="13" fill="#1e2d42" transform="rotate(180, 300, 237)"/>
                    <ellipse cx="300" cy="222" rx="4" ry="13" fill="#1e2d42" transform="rotate(240, 300, 237)"/>
                    <ellipse cx="300" cy="222" rx="4" ry="13" fill="#1e2d42" transform="rotate(300, 300, 237)"/>
                  </g>
                  <circle cx="300" cy="237" r="5" fill="#1e2d42" stroke="#253245" stroke-width="1"/>

                  <!-- Status LEDs -->
                  <circle cx="245" cy="280" r="4" fill="#1a2a1a" class="led led-power"/>
                  <circle cx="260" cy="280" r="3" fill="#293548" class="led led-hdd"/>
                  <circle cx="273" cy="280" r="3" fill="#293548" class="led led-net"/>

                  <!-- USB port -->
                  <rect x="298" y="273" width="26" height="14" rx="2" fill="#080d18" stroke="#253245" stroke-width="1"/>
                  <rect x="302" y="276" width="18" height="8" rx="1.5" fill="#040810"/>

                  <!-- Power button -->
                  <circle cx="363" cy="280" r="7" fill="#0c1322" stroke="#334155" stroke-width="1.5"/>
                  <path d="M363 274 L363 278" stroke="#475569" stroke-width="1.8" stroke-linecap="round" class="power-icon"/>
                  <path d="M358 277 A6 6 0 1 0 368 277" fill="none" stroke="#475569" stroke-width="1.5" stroke-linecap="round" class="power-icon-arc"/>
                </g>

                <!-- Server glow border (appears on hover) -->
                <rect x="216" y="33" width="168" height="274" rx="12" fill="none" stroke="#f1c40f" stroke-width="1.5" class="server-glow" opacity="0" filter="url(#glow-md)"/>

                <!-- Scan line (sweeps down on hover) -->
                <rect class="scan-line" x="220" y="35" width="160" height="2" rx="1" fill="#f1c40f" opacity="0"/>

                <!-- ===== YUBIKEY ===== -->
                <g class="yubikey">
                  <!-- USB-A connector -->
                  <rect x="53" y="273" width="20" height="14" rx="1.5" fill="url(#connector-grad)" stroke="#999" stroke-width="0.5"/>
                  <!-- Key body -->
                  <rect x="58" y="266" width="82" height="28" rx="6" fill="#1a2332" stroke="#3d5068" stroke-width="1.5"/>

                  <!-- Gold touch strip -->
                  <rect x="64" y="272" width="58" height="16" rx="4" fill="url(#gold-grad)"/>

                  <!-- Touch circle -->
                  <circle cx="108" cy="280" r="6" fill="none" stroke="#b8860b" stroke-width="1.2" class="yk-touch"/>
                  <circle cx="108" cy="280" r="3" fill="#d4a017" opacity="0.3" class="yk-touch-inner"/>

                  <!-- YubiKey LED -->
                  <circle cx="74" cy="280" r="3" fill="#293548" class="yk-led"/>

                  <!-- Keyring hole -->
                  <circle cx="136" cy="280" r="4" fill="none" stroke="#3d5068" stroke-width="2"/>
                </g>

                <!-- Insertion point glow -->
                <circle cx="311" cy="280" r="8" fill="#f1c40f" class="insertion-spark" opacity="0" filter="url(#glow-lg)"/>

                <!-- Particles (spawn from insertion point on hover) -->
                {Array.from({length: 12}).map((_, i) => (
                  <circle
                    class="particle"
                    cx="311"
                    cy="280"
                    r={1 + Math.random() * 2.5}
                    style={`--delay: ${0.5 + i * 0.07}s; --dx: ${-50 + Math.random() * 100}px; --dy: ${-50 - Math.random() * 120}px;`}
                  />
                ))}

                <!-- Data stream lines (appear from server on hover) -->
                <g class="data-streams" opacity="0">
                  <line x1="382" y1="109" x2="440" y2="85" stroke="#f1c40f" stroke-width="1.2" stroke-linecap="round" class="stream-line" style="--delay: 0.9s"/>
                  <line x1="382" y1="151" x2="450" y2="135" stroke="#f1c40f" stroke-width="1" stroke-linecap="round" class="stream-line" style="--delay: 1.0s"/>
                  <line x1="382" y1="193" x2="445" y2="182" stroke="#f1c40f" stroke-width="1.2" stroke-linecap="round" class="stream-line" style="--delay: 1.1s"/>
                  <line x1="382" y1="237" x2="460" y2="228" stroke="#f1c40f" stroke-width="0.8" stroke-linecap="round" class="stream-line" style="--delay: 1.2s"/>
                  <circle cx="440" cy="85" r="2" fill="#f1c40f" class="stream-dot" style="--delay: 0.9s"/>
                  <circle cx="450" cy="135" r="1.5" fill="#f1c40f" class="stream-dot" style="--delay: 1.0s"/>
                  <circle cx="445" cy="182" r="2" fill="#f1c40f" class="stream-dot" style="--delay: 1.1s"/>
                  <circle cx="460" cy="228" r="1.5" fill="#f1c40f" class="stream-dot" style="--delay: 1.2s"/>
                </g>

                <!-- ACCESS GRANTED text -->
                <text class="auth-text" x="300" y="335" text-anchor="middle" fill="#22c55e" font-size="11" font-family="'Courier New', monospace" opacity="0" letter-spacing="3" filter="url(#glow-sm)">ACCESS GRANTED</text>
              </svg>
            ) : (
              <div class="category-card-image" style={`background-image: url('${category.image}');`}></div>
            )}
            <div class="card-glare"></div>
            <div class="category-card-overlay"></div>
            <div class="category-card-content">
              <h2 class="category-title">{category.title}</h2>
              <p class="category-description">{category.description}</p>
              <span class="category-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </div>
          </a>
        ))}
      </div>
    </div>

    <TiltCards />
  </main>
</BaseLayout>