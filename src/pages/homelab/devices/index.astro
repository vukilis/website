---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Icon from '../../../components/other/Icon.astro';
import '../../../styles/homelab/devices.css';

type ComponentEntry = {
  type: 'component';
  label: string;
  name: string;
  specs: string;
  icon: string;
};

type SubsectionEntry = {
  type: 'subsection';
  title: string;
  items: { name: string; specs: string; icon: string }[];
};

type SystemEntry = ComponentEntry | SubsectionEntry;

interface SystemBuild {
  codename: string;
  subtitle: string;
  status: string;
  sysId: string;
  classification: string;
  icon: string;
  entries: SystemEntry[];
}

const systems: SystemBuild[] = [
  {
    codename: 'BLACKBOX',
    subtitle: 'Primary Workstation',
    status: 'OPERATIONAL',
    sysId: 'SYS-001',
    classification: 'PERSONAL EQUIPMENT',
    icon: 'desktop',
    entries: [
      { type: 'component', label: 'Platform', name: 'CachyOS Arch Linux', specs: 'Operating System · DWM · Xlibre · SDDM · Kitty · ZSH · VS Code', icon: 'cubes' },
      { type: 'component', label: 'Chassis', name: 'Lian Li Air Mini', specs: 'Mid-tower · ATX · SFF', icon: 'box-open' },
      { type: 'component', label: 'Processor', name: 'Intel Core i7-13700K', specs: '16C/24T · Up to 5.4 GHz · LGA 1700', icon: 'microchip' },
      { type: 'component', label: 'Graphics', name: 'ZOTAC GTX 1060 3GB AMP!', specs: '3GB GDDR5 · PCIe 3.0 · 120W TDP', icon: 'display' },
      { type: 'component', label: 'Motherboard', name: 'MSI Z690 Tomahawk', specs: 'DDR5 · PCIe 4.0 · WiFi', icon: 'microchip' },
      { type: 'component', label: 'Memory', name: 'Kingston Fury Renegade', specs: 'DDR5 · 2×16GB · 6000 MT/s', icon: 'memory' },
      { type: 'component', label: 'Cooling', name: 'Arctic Liquid Freezer II 280', specs: '280mm AIO · A-RGB', icon: 'temperature-low' },
      { type: 'component', label: 'Power Supply', name: 'FSP HYDRO G PRO', specs: '1000W · 80+ Gold', icon: 'bolt' },
      { type: 'component', label: 'Case Fans', name: 'Arctic P12 Pro + 3× Lian Li OEM', specs: '120mm A-RGB · 140mm×2 + 120mm×1', icon: 'fan' },
      {
        type: 'subsection',
        title: 'Storage',
        items: [
          { name: 'Samsung 980 PRO 500GB', specs: 'NVMe PCIe 4.0 · 6900 MB/s', icon: 'hard-drive' },
          { name: 'Kingston 480GB', specs: 'SATA III · 500 MB/s', icon: 'hard-drive' },
          { name: 'WD Blue 2TB', specs: 'HDD · 7200 RPM · 256MB Cache', icon: 'database' },
          { name: 'WD Blue 1TB', specs: 'HDD · 7200 RPM · 256MB Cache', icon: 'database' },
          { name: 'SanDisk 120GB', specs: 'SATA III · 440 MB/s · Backup', icon: 'hard-drive' },
          { name: 'Verbatim 320GB', specs: '2.5" HDD · USB 2.0 · External', icon: 'hard-drive' },
        ],
      },
    ],
  },
  {
    codename: 'GHOST',
    subtitle: 'Homelab Server',
    status: 'ONLINE',
    sysId: 'SYS-003',
    classification: 'INFRASTRUCTURE',
    icon: 'server',
    entries: [
      { type: 'component', label: 'System', name: 'Firebat T8 Pro Plus', specs: 'Intel N100 · DDR5 16GB · 512GB NVMe', icon: 'server' },
      { type: 'component', label: 'Platform', name: 'Proxmox VE', specs: 'Virtualization Hypervisor', icon: 'cubes' },
      { type: 'component', label: 'I/O', name: 'On-board Ports', specs: '3× HDMI · 3× USB · 2× RJ45 1GbE', icon: 'plug' },
      {
        type: 'subsection',
        title: 'Storage',
        items: [
          { name: 'Wicgtyp N900 512GB', specs: 'NVMe PCIe 3.0', icon: 'hard-drive' },
          { name: 'Seagate 250GB', specs: '2.5" HDD · USB 3.0 · External', icon: 'hard-drive' },
        ],
      },
    ],
  },
  {
    codename: 'NETWORK',
    subtitle: 'Network Infrastructure & Security',
    status: 'SECURED',
    sysId: 'SYS-004',
    classification: 'CRITICAL INFRASTRUCTURE',
    icon: 'shield-halved',
    entries: [
      { type: 'component', label: 'Switch', name: 'Horaco 2.5GbE Managed Switch', specs: '8× 2.5GbE · 1× 10Gb SFP+ · VLANs', icon: 'network-wired' },
      { type: 'component', label: 'Router', name: 'TP-Link Archer C6 V2', specs: '867 Mbps (AC) · 400 Mbps (N) · MU-MIMO', icon: 'wifi' },
      { type: 'component', label: 'Authentication', name: 'Yubico Secure Key C NFC', specs: 'USB-C · FIDO2 · Passkeys · NFC', icon: 'key' },
    ],
  },
  {
    codename: 'PERIPHERALS',
    subtitle: 'Human Interface Devices',
    status: 'ACTIVE',
    sysId: 'SYS-002',
    classification: 'INTERFACE EQUIPMENT',
    icon: 'keyboard',
    entries: [
      { type: 'component', label: 'Display', name: 'BenQ GW2270', specs: '21.5" · 1920×1080 · VA Panel', icon: 'desktop' },
      { type: 'component', label: 'Pointer', name: 'MCHOSE L7 Ultra+', specs: 'PAW3950 · 39g · Tri-mode · USB-C', icon: 'computer-mouse' },
      { type: 'component', label: 'Keyboard', name: 'AJAZZ AK820', specs: '75% · Sea Salt Switches · PBT · USB-C', icon: 'keyboard' },
      { type: 'component', label: 'Audio Output', name: 'Beyerdynamic DT 770 PRO', specs: '80Ω · 5–35,000 Hz · Closed · HeSuVi EQ', icon: 'headphones' },
      { type: 'component', label: 'Audio Input', name: 'Microphone YU8', specs: 'USB-C / XLR · Dynamic · RGB', icon: 'microphone' },
      { type: 'component', label: 'Surface', name: 'ASUS TUF Gaming Mouse Pad', specs: '500×1200mm · RGB · Anti-slip Rubber', icon: 'square' },
      { type: 'component', label: 'Desk', name: 'MITTZON', specs: 'Electric · 160x80cm · Cable Management', icon: 'square' },
    ],
  },
];

function countComponents(entries: SystemEntry[]): number {
  return entries.reduce((acc, e) => {
    if (e.type === 'component') return acc + 1;
    return acc + e.items.length;
  }, 0);
}

const totalComponents = systems.reduce((acc, s) => acc + countComponents(s.entries), 0);
---

<BaseLayout
  title="Devices — Vuk1lis"
  description="Equipment manifest — systems, components, peripherals, and network infrastructure."
  keywords="vukilis, devices, PC parts, peripherals, servers, switches, homelab, hardware, inventory, blackbox"
>
  <Navigation />

  <main class="devices-page" id="main-content">
    <div class="page-grid">
      <div class="dot-bg" aria-hidden="true"></div>

      <div class="container">
        <a href="/homelab/" class="back-link">
          <Icon name="arrow-left" />
          Back to Homelab
        </a>

        <header class="manifest-header">
          <span class="v-symbol" aria-hidden="true"></span>
          <h1 class="manifest-title">Equipment Manifest</h1>
          <span class="header-rule" aria-hidden="true"></span>
          <p class="manifest-subtitle">
            Authorized inventory of systems, components and network
          </p>
          <p class="manifest-meta">
            <span>{totalComponents} Components</span>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span>{systems.length} Systems</span>
          </p>
        </header>

        {systems.map((sys, sysIndex) => (
          <section
            class="system-card"
            id={`system-${sysIndex}`}
            style={`--enter-delay: ${sysIndex * 0.1}s`}
          >
            <span class="corner c-tl" aria-hidden="true"></span>
            <span class="corner c-tr" aria-hidden="true"></span>
            <span class="corner c-bl" aria-hidden="true"></span>
            <span class="corner c-br" aria-hidden="true"></span>
            <span class="scan-beam" aria-hidden="true"></span>

            <div class="sys-classbar">
              <span>{sys.classification}</span>
              <span>{sys.sysId}</span>
            </div>

            <div class="sys-accent" aria-hidden="true"></div>

            <div class="sys-header">
              <div class="sys-icon-wrap">
                <div class="sys-icon-ring">
                  <Icon name={sys.icon} />
                </div>
              </div>
              <div class="sys-identity">
                <h2 class="sys-codename">{sys.codename}</h2>
                <span class="sys-codeline" aria-hidden="true"></span>
                <p class="sys-subtitle">{sys.subtitle}</p>
              </div>
              <div class="sys-status">
                <span class="status-dot" aria-hidden="true"></span>
                <span class="status-label">{sys.status}</span>
              </div>
            </div>

            <div class="sys-body">
              {sys.entries.map((entry) => {
                if (entry.type === 'component') {
                  return (
                    <div class="comp-row">
                      <span class="comp-label">
                        <Icon name={entry.icon} />
                        {entry.label}
                      </span>
                      <span class="comp-pipe" aria-hidden="true"></span>
                      <div class="comp-detail">
                        <span class="comp-name">{entry.name}</span>
                        <span class="comp-specs">{entry.specs}</span>
                      </div>
                    </div>
                  );
                }
                return (
                  <div class="comp-subsection">
                    <div class="sub-header">
                      <span class="sub-marker" aria-hidden="true">▸</span>
                      <span class="sub-title">{entry.title}</span>
                    </div>
                    <div class="sub-grid">
                      {entry.items.map((item) => (
                        <div class="sub-item">
                          <div class="sub-item-accent" aria-hidden="true"></div>
                          <div class="sub-item-content">
                            <span class="sub-item-name">{item.name}</span>
                            <span class="sub-item-specs">{item.specs}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>

            <div class="sys-footer">
              <span class="sys-footer-left">
                <Icon name="power-off" />
                <span>Powered</span>
              </span>
              <span class="sys-footer-right">
                {countComponents(sys.entries)} {countComponents(sys.entries) === 1 ? 'Component' : 'Components'}
              </span>
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>