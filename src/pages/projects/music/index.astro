---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import MusicHeader from '../../../components/music/MusicHeader.astro';
import MusicFilterBar from '../../../components/music/MusicFilterBar.astro';
import MusicCard from '../../../components/music/MusicCard.astro';
import MusicModal from '../../../components/music/MusicModal.astro';
import { getCollection } from 'astro:content';
import '../../../styles/music/layout.css';

const allTracks = await getCollection('projectsMusic');
const tracks = allTracks.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return b.data.year - a.data.year;
});

const categories = [
  { id: "all", label: "All Tracks" },
  ...Array.from(new Set(tracks.flatMap(t => t.data.cat))).map(cat => ({
    id: cat,
    label: cat.charAt(0).toUpperCase() + cat.slice(1)
  }))
];
---

<BaseLayout
  title="Music — Vukilis"
  description="Explore the sound of Vukilis: AI sound design, songwriting, and music experiments."
>
  <Navigation />

  <main class="design-page" id="main-content">
    <div class="container">
      <MusicHeader />

      <MusicFilterBar categories={categories} />

      <div class="gallery-grid" id="musicGallery">
        {tracks.map((track, index) => (
          <MusicCard item={track.data} index={index} />
        ))}
      </div>
    </div>
  </main>

  <MusicModal />

  <script is:inline>
    (function() {
      function init() {
        var cards = document.querySelectorAll('.music-card');
        var filterChips = document.querySelectorAll('.filter-chip');

        filterChips.forEach(function(chip) {
          if (!chip.dataset.filterAttached) {
            chip.dataset.filterAttached = 'true';
            chip.addEventListener('click', function() {
              var filter = chip.dataset.filter;
              if (!filter) return;

              filterChips.forEach(function(c) {
                c.classList.remove('active');
                c.setAttribute('aria-selected', 'false');
              });
              chip.classList.add('active');
              chip.setAttribute('aria-selected', 'true');

               cards.forEach(function(card) {
                 const cats = (card.dataset.category || '').split(',');
                 var matches = filter === 'all' || cats.includes(filter);
                 card.style.display = matches ? 'flex' : 'none';
               });
            });
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</BaseLayout>
