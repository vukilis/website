---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import MusicHeader from '../../../components/music/MusicHeader.astro';
import MusicFilterBar from '../../../components/music/MusicFilterBar.astro';
import MusicCard from '../../../components/music/MusicCard.astro';
import MusicModal from '../../../components/music/MusicModal.astro';
import { getCollection } from 'astro:content';
import '../../../styles/music/layout.css';

const allTracks = await getCollection('projectsMusic');
const tracks = allTracks.sort((a, b) => b.data.pubDate - a.data.pubDate);

const categoryCounts = new Map();
for (const t of tracks) {
  for (const cat of t.data.cat) {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  }
}

const categories = [
  { id: "all", label: "All Tracks", count: tracks.length },
  ...Array.from(new Set(tracks.flatMap(t => t.data.cat))).map(cat => ({
    id: cat,
    label: cat.charAt(0).toUpperCase() + cat.slice(1),
    count: categoryCounts.get(cat) ?? 0,
  }))
];
---

<BaseLayout
  title="Music — Vukilis"
  description="Explore the sound of Vukilis: AI sound design, songwriting, and music experiments."
>
  <Navigation />

  <main class="design-page" id="main-content">
    <div class="container">
      <MusicHeader />

      <MusicFilterBar categories={categories} />

      <div class="gallery-grid" id="musicGallery">
        {tracks.map((track, index) => (
          <MusicCard item={{ ...track.data, pubDate: track.data.pubDate }} index={index} />
        ))}
      </div>
    </div>
  </main>

  <MusicModal />

  <script is:inline>
    (function() {
      function init() {
        var cards = Array.from(document.querySelectorAll('.music-card'));
        var filterChips = document.querySelectorAll('.filter-chip');
        var sortBtn = document.getElementById('music-pubdate-sort-btn');
        var clearSortBtn = document.getElementById('music-clear-sort-btn');
        var currentFilter = 'all';
        var currentSort = null;
        var originalOrder = cards.slice();

        function showClearButton() {
          if (clearSortBtn) clearSortBtn.hidden = false;
        }

        function hideClearButton() {
          if (clearSortBtn) clearSortBtn.hidden = true;
        }

        function applyFilter() {
          cards.forEach(function(card) {
            var cats = (card.getAttribute('data-category') || '').split(',');
            var matches = currentFilter === 'all' || cats.includes(currentFilter);
            card.style.display = matches ? 'flex' : 'none';
          });
        }

        function applySort() {
          var grid = document.getElementById('musicGallery');
          if (!grid) return;
          var visible = cards.filter(function(c) { return c.style.display !== 'none'; });
          visible.sort(function(a, b) {
            var da = new Date(a.getAttribute('data-pub-date') || 0).getTime();
            var db = new Date(b.getAttribute('data-pub-date') || 0).getTime();
            return currentSort === 'date-desc' ? db - da : da - db;
          });
          visible.forEach(function(card) { grid.appendChild(card); });
        }

        function restoreOriginalOrder() {
          var grid = document.getElementById('musicGallery');
          if (!grid) return;
          originalOrder.forEach(function(card) { grid.appendChild(card); });
        }

        function updateSortUI() {
          sortBtn.classList.toggle('active', !!currentSort);
          if (currentSort === 'date-asc') {
            sortBtn.setAttribute('data-sort-direction', 'asc');
          } else if (currentSort === 'date-desc') {
            sortBtn.setAttribute('data-sort-direction', 'desc');
          } else {
            sortBtn.removeAttribute('data-sort-direction');
          }
          if (currentSort) {
            showClearButton();
          } else {
            hideClearButton();
          }
        }

        function setSort(nextSort) {
          currentSort = nextSort;
          updateSortUI();
          if (currentSort) {
            applySort();
          } else {
            restoreOriginalOrder();
          }
        }

        filterChips.forEach(function(chip) {
          chip.addEventListener('click', function() {
            var filter = chip.getAttribute('data-filter');
            if (!filter) return;
            currentFilter = filter;
            filterChips.forEach(function(c) {
              c.classList.remove('active');
              c.setAttribute('aria-selected', 'false');
            });
            chip.classList.add('active');
            chip.setAttribute('aria-selected', 'true');
            applyFilter();
            if (currentSort) applySort();
          });
        });

        if (sortBtn) {
          sortBtn.addEventListener('click', function() {
            if (currentSort === 'date-desc') {
              setSort('date-asc');
            } else {
              setSort('date-desc');
            }
          });
        }

        if (clearSortBtn) {
          clearSortBtn.addEventListener('click', function() {
            setSort(null);
          });
        }

        applyFilter();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</BaseLayout>
