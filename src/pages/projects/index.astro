---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import '../../styles/projects/layout.css';

const categories = [
  {
    title: 'IT',
    description: 'Windows & Linux tooling, homelab experiments and web development projects',
    href: '/projects/it/',
    image: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1200&q=80',
  },
  {
    title: 'DESIGN',
    description: 'Motion design, animation and visual experiments projects',
    href: '/projects/design/',
    image: 'https://images.unsplash.com/photo-1626785774573-4b799315345d?auto=format&fit=crop&w=1200&q=80',
  },
  {
    title: 'MUSIC',
    description: 'Song writing, AI sound design and music projects',
    href: '/projects/music/',
    image: 'https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?auto=format&fit=crop&w=1200&q=80',
  },
];
---

<BaseLayout
  title="Projects - Vuk1lis"
  description="Explore projects across IT, Design, and Music"
  keywords="vukilis, projects, portfolio, IT projects, design projects, music projects, web development, motion design, songwriting, creative coding, linux tooling, homelab, after effects, photoshop, music production, digital art, steam community, animation, microservices, scripting"
>
  <Navigation />

  <main class="projects-page" id="main-content">
    <div class="container">
      <header class="projects-header">
        <h1 class="page-title">Projects</h1>
        <p class="page-subtitle">
          Select a category to explore
        </p>
      </header>

      <div class="category-grid">
        {categories.map((category) => (
          <a href={category.href} class="category-card">
            <div class="category-card-image" style={`background-image: url('${category.image}');`}></div>
            <div class="category-card-overlay"></div>
            <div class="category-card-content">
              <h2 class="category-title">{category.title}</h2>
              <p class="category-description">{category.description}</p>
              <span class="category-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

