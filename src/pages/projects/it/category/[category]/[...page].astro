---
import { getCollection } from 'astro:content';
import ITProjectsLayout from '../../../../../layouts/ITProjectsLayout.astro';

export async function getStaticPaths({ paginate }: { paginate: (...args: any[]) => Promise<any[]> }) {
  const allProjects = await getCollection('projectsIT', ({ data }) => !data.draft);
  const sorted = allProjects.sort((a, b) => {
    const aFeatured = a.data.featured ? 1 : 0;
    const bFeatured = b.data.featured ? 1 : 0;
    if (bFeatured !== aFeatured) return bFeatured - aFeatured;

    const statusOrder = { active: 0, normal: 1, archived: 2 };
    const aStatus = statusOrder[a.data.status] ?? 1;
    const bStatus = statusOrder[b.data.status] ?? 1;
    if (aStatus !== bStatus) return aStatus - bStatus;

    return b.data.title.localeCompare(a.data.title);
  });

  const categories = [
    ...new Set(sorted.flatMap(p => p.data.categories ?? []))
  ];

  function slugify(str: string) {
    return str
      .toLowerCase()
      .trim()
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '')
      .replace(/-+/g, '-');
  }

  return categories.flatMap(cat => {
    const slug = slugify(cat);
    return paginate(
      sorted.filter(p => (p.data.categories ?? []).includes(cat)),
      {
        params: { category: slug },
        pageSize: 9,
        format: (p) => `/projects/it/category/${slug}${!p || p === '/' ? '' : '/' + p}`
      }
    );
  });
}

const { page } = Astro.props;

const urlStr = Astro.url.pathname;
const categoryMatch = urlStr.match(/\/projects\/it\/category\/([^\/]+)/);
const categorySlug = categoryMatch ? categoryMatch[1] : 'unknown';

const allProjectsForFilter = await getCollection('projectsIT', ({ data }) => !data.draft);
const sortedAllProjects = allProjectsForFilter.sort((a, b) => {
  const aFeatured = a.data.featured ? 1 : 0;
  const bFeatured = b.data.featured ? 1 : 0;
  if (bFeatured !== aFeatured) return bFeatured - aFeatured;

  const statusOrder = { active: 0, normal: 1, archived: 2 };
  const aStatus = statusOrder[a.data.status] ?? 1;
  const bStatus = statusOrder[b.data.status] ?? 1;
  if (aStatus !== bStatus) return aStatus - bStatus;

  return b.data.title.localeCompare(a.data.title);
});

function slugify(str: string) {
  return str
    .toLowerCase()
    .trim()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9-]/g, '')
    .replace(/-+/g, '-');
}

const allCategories = [...new Set(sortedAllProjects.flatMap(p => p.data.categories ?? []))];
const activeCategoryName = allCategories.find(cat => slugify(cat) === categorySlug) || categorySlug;
---

<ITProjectsLayout
  page={page}
  allProjectsForFilter={sortedAllProjects}
  activeCategory={categorySlug}
  title={`IT Projects / ${activeCategoryName.charAt(0).toUpperCase() + activeCategoryName.slice(1)}`}
  subtitle="Windows & Linux tooling, homelab experiments and web development projects"
  paginationBaseUrl={`/projects/it/category/${categorySlug}`}
  noResultsExtra={`<a href="/projects/it/">Show all IT projects</a>.`}
/>
