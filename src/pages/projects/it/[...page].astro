---
import { getCollection } from 'astro:content';
import ITProjectsLayout from '../../../layouts/ITProjectsLayout.astro';

export async function getStaticPaths({ paginate }: { paginate: (...args: any[]) => Promise<any[]> }) {
  const allProjects = await getCollection('projectsIT', ({ data }) => !data.draft);
  const sorted = allProjects.sort((a, b) => {
    const aFeatured = a.data.featured ? 1 : 0;
    const bFeatured = b.data.featured ? 1 : 0;
    if (bFeatured !== aFeatured) return bFeatured - aFeatured;

    const statusOrder = { active: 0, normal: 1, archived: 2 };
    const aStatus = statusOrder[a.data.status] ?? 1;
    const bStatus = statusOrder[b.data.status] ?? 1;
    if (aStatus !== bStatus) return aStatus - bStatus;

    return b.data.title.localeCompare(a.data.title);
  });

  return paginate(sorted, {
    pageSize: 9,
    format: (p) => `/projects/it${!p || p === '/' ? '' : '/' + p}`
  });
}

const { page } = Astro.props;

const allProjectsForFilter = await getCollection('projectsIT', ({ data }) => !data.draft);
const sortedAllProjects = allProjectsForFilter.sort((a, b) => {
  const aFeatured = a.data.featured ? 1 : 0;
  const bFeatured = b.data.featured ? 1 : 0;
  if (bFeatured !== aFeatured) return bFeatured - aFeatured;

  const statusOrder = { active: 0, normal: 1, archived: 2 };
  const aStatus = statusOrder[a.data.status] ?? 1;
  const bStatus = statusOrder[b.data.status] ?? 1;
  if (aStatus !== bStatus) return aStatus - bStatus;

  return b.data.title.localeCompare(a.data.title);
});
---

<ITProjectsLayout
  page={page}
  allProjectsForFilter={sortedAllProjects}
  activeCategory={undefined}
  title="IT Projects"
  subtitle="Windows & Linux tooling, homelab experiments and web development projects"
  paginationBaseUrl="/projects/it"
  noResultsExtra=""
  keywords="vukilis, IT projects, windows tooling, linux tooling, homelab, web development, docker, kubernetes, automation, scripting, microservices, infrastructure, cloud, devops, programming, software engineering, server, containerization, networking, active projects"
/>
