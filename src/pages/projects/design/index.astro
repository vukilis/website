const categories = [
  { id: "all", label: "All Works" },
  { id: "steam", label: "Steam Artworks" },
  { id: "music", label: "Music Artworks" },
];
---

<BaseLayout
  title="My Design Artworks - Vuk1lis"
  description="All my retro and motion design artworks made for the Steam community using Photoshop and After Effects."
>
  <Navigation />

  <main class="design-page" id="main-content">
    <div class="container">
      <DesignHeader />

      <DesignFilterBar categories={categories} />

      <div class="gallery-grid" id="artGallery">
        {items.map((item, index) => (
          <DesignArtworkCard item={item} index={index} categories={categories} />
        ))}
      </div>
    </div>
  </main>

  <ArtworkModal />

  <script is:inline>
    (function() {
      function init() {
        var cards = document.querySelectorAll('.art-card');
        var filterChips = document.querySelectorAll('.filter-chip');
        var listenersAttached = false;

        cards.forEach(function(card) {
          var img = card.querySelector('.art-thumb');
          if (!img) return;

          var hoverSrc = img.dataset.hoverSrc;
          var staticSrc = img.dataset.staticSrc;

          if (!hoverSrc) return;

          var showAnimated = function() { img.src = hoverSrc; };
          var stopAnimation = function() { img.src = staticSrc; };

          if (!card.dataset.listenersAttached) {
            card.dataset.listenersAttached = 'true';
            card.addEventListener('mouseenter', showAnimated);
            card.addEventListener('mouseleave', stopAnimation);
            card.addEventListener('focus', showAnimated);
            card.addEventListener('blur', stopAnimation);
          }
        });

        filterChips.forEach(function(chip) {
          if (!chip.dataset.filterAttached) {
            chip.dataset.filterAttached = 'true';
            chip.addEventListener('click', function() {
              var filter = chip.dataset.filter;
              if (!filter) return;

              filterChips.forEach(function(c) {
                c.classList.remove('active');
                c.setAttribute('aria-selected', 'false');
              });
              chip.classList.add('active');
              chip.setAttribute('aria-selected', 'true');

              cards.forEach(function(card) {
                var matches = filter === 'all' || card.dataset.category === filter;
                card.style.display = matches ? 'flex' : 'none';
              });
            });
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
      document.addEventListener('astro:page-load', init);
    })();
  </script>
</BaseLayout>
