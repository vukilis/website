---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import DesignHeader from '../../../components/design/DesignHeader.astro';
import DesignFilterBar from '../../../components/design/DesignFilterBar.astro';
import DesignArtworkCard from '../../../components/design/DesignArtworkCard.astro';
import ArtworkModal from '../../../components/design/ArtworkModal.astro';
import { getCollection } from 'astro:content';
import '../../../styles/design/layout.css';

const allItems = await getCollection('projectsDesign', ({ data }) => !data.draft);
const items = allItems.sort((a, b) => {
  const typeOrder = { WEBP: 0, VIDEO: 1 };
  const aType = typeOrder[a.data.type] ?? 2;
  const bType = typeOrder[b.data.type] ?? 2;
  if (aType !== bType) return aType - bType;
  return b.data.pubDate - a.data.pubDate;
});

const categoryCounts = new Map();
for (const i of items) {
  for (const cat of i.data.cat) {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  }
}

const categories = [
  { id: "all", label: "All Works", count: items.length },
  ...Array.from(new Set(items.flatMap(i => i.data.cat))).map(cat => ({
    id: cat,
    label: cat.charAt(0).toUpperCase() + cat.slice(1),
    count: categoryCounts.get(cat) ?? 0,
  }))
];
---

<BaseLayout
  title="My Design Artworks - Vuk1lis"
  description="All my retro and motion design artworks made for the Steam community using Photoshop and After Effects."
>
  <Navigation />

  <main class="design-page" id="main-content">
    <div class="container">
      <DesignHeader />

      <DesignFilterBar categories={categories} />

      <div class="gallery-grid" id="artGallery">
        {items.map((item, index) => (
          <DesignArtworkCard item={{ ...item.data, pubDate: item.data.pubDate }} index={index} categories={categories} />
        ))}
      </div>
    </div>
  </main>

  <ArtworkModal />

  <script>
    if (!window.__designPageInitialized) {
      window.__designPageInitialized = true;

      document.addEventListener('mouseover', function(e) {
        const card = e.target.closest('.art-card');
        if (!card) return;
        const img = card.querySelector('.art-thumb');
        if (!img || !img.dataset.hoverSrc) return;
        img.src = img.dataset.hoverSrc;
      });

      document.addEventListener('mouseout', function(e) {
        const card = e.target.closest('.art-card');
        if (!card) return;
        const img = card.querySelector('.art-thumb');
        if (!img || !img.dataset.staticSrc) return;
        img.src = img.dataset.staticSrc;
      });

      document.addEventListener('focusin', function(e) {
        const card = e.target.closest('.art-card');
        if (!card) return;
        const img = card.querySelector('.art-thumb');
        if (!img || !img.dataset.hoverSrc) return;
        img.src = img.dataset.hoverSrc;
      });

      document.addEventListener('focusout', function(e) {
        const card = e.target.closest('.art-card');
        if (!card) return;
        const img = card.querySelector('.art-thumb');
        if (!img || !img.dataset.staticSrc) return;
        img.src = img.dataset.staticSrc;
      });

      (function() {
        var cards = Array.from(document.querySelectorAll('.art-card'));

        function applyFilter() {
          cards.forEach(function(card) {
            var cats = (card.getAttribute('data-category') || '').split(',');
            var activeFilter = document.querySelector('.filter-chip.active');
            var filter = activeFilter ? activeFilter.getAttribute('data-filter') : 'all';
            var matches = filter === 'all' || cats.includes(filter);
            card.style.display = matches ? 'flex' : 'none';
          });
        }

        document.querySelectorAll('.filter-chip').forEach(function(chip) {
          chip.addEventListener('click', function() {
            document.querySelectorAll('.filter-chip').forEach(function(c) {
              c.classList.remove('active');
              c.setAttribute('aria-selected', 'false');
            });
            chip.classList.add('active');
            chip.setAttribute('aria-selected', 'true');
            applyFilter();
          });
        });

        applyFilter();
      })();
    }
  </script>
</BaseLayout>
