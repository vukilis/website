<script>
  document.addEventListener('astro:page-load', () => {
    if (window.matchMedia('(pointer: coarse), (prefers-reduced-motion: reduce)').matches) return;

    // Parallax on V monogram based on scroll
    const monogram = document.querySelector('.v-monogram') as HTMLElement | null;

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (monogram) monogram.style.setProperty('--sy', `${y * 0.15}px`);
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>
