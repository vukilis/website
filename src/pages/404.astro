---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const date = new Date();
---

<BaseLayout
  title="404 — Verily Vanquished | Vuk1lis"
  description="The page you seek has vanished. Ideas are bulletproof, but this URL is not."
  hideFooter={true}
>
  <main class="v404">
    <!-- background layers -->
    <div class="v404__bg" aria-hidden="true">
      <div class="bg__glow bg__glow--top"></div>
      <div class="bg__glow bg__glow--bot"></div>
      <div class="bg__v">V</div>
    </div>

    <!-- rose -->
    <div class="v404__rose" aria-hidden="true">
      <svg viewBox="0 0 60 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M30 100 C30 100 28 72 26 60 C24 48 18 42 18 42" stroke="#2d1f1f" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M30 42 C24 38 16 42 18 50 C20 56 28 52 30 48 C32 52 40 56 42 50 C44 42 36 38 30 42Z" fill="#8b1a1a"/>
        <path d="M30 38 C22 32 12 36 14 46 C16 52 26 48 30 42 C34 48 44 52 46 46 C48 36 38 32 30 38Z" fill="#b91c1c"/>
        <path d="M30 34 C25 28 18 30 20 38 C22 43 28 40 30 36 C32 40 38 43 40 38 C42 30 35 28 30 34Z" fill="#dc2626"/>
        <path d="M30 30 C27 26 22 27 24 33 C25 36 29 34 30 31 C31 34 35 36 36 33 C38 27 33 26 30 30Z" fill="#ef4444"/>
        <path d="M26 60 C20 56 12 58 14 64 C16 68 22 66 26 62Z" fill="#1a1212" opacity="0.7"/>
        <path d="M27 56 C32 54 38 56 36 62 C34 66 28 64 27 60Z" fill="#1a1212" opacity="0.6"/>
      </svg>
    </div>

    <div class="v404__container">
      <!-- Terminal -->
      <div class="term">
        <div class="term__bar">
          <span class="term__dot" style="background:#ff5f56"></span>
          <span class="term__dot" style="background:#ffbd2e"></span>
          <span class="term__dot" style="background:#27c93f"></span>
          <span class="term__title">vuk1lis@shadow:~/404</span>
        </div>
        <div class="term__body">
          <div class="term__line">
            <span class="pr">vuk1lis@shadow</span>:<span class="pp">~</span>$ <span class="cmd">cat {date.getDate()}-{date.toLocaleString('en-US', { month: 'long' })}-{date.getFullYear()}.log</span>
          </div>
          <div class="term__out">
            <p class="err-main">VANQUISHED — 404</p>
            <p class="err-sub">This page did not survive. Verily.</p>
          </div>
          <div class="term__line">
            <span class="pr">vuk1lis@shadow</span>:<span class="pp">~</span>$ <span class="blink" aria-hidden="true">█</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="hero">
        <div class="hero__number" aria-hidden="true">404</div>
        <h1 class="hero__title">Verily, This Page Has Vanished</h1>
        <p class="hero__quote">
          "Beneath this mask there is more than just flesh. Beneath this mask there is an idea…
          and ideas are bulletproof."
        </p>
        <p class="hero__sub">
          But this URL, unfortunately, is not. The page you sought has been erased from the record — 
          relocated, removed, or simply never existed in this shadow.
        </p>

        <a href={base} class="home-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Return to the Shadow
        </a>
      </div>
    </div>
  </main>

  <style>
    /* ── Tokens ── */
    :root {
      --v-red: #dc2626;
      --v-red-hot: #ef4444;
      --v-red-glow: rgba(220, 38, 38, .15);
      --v-blood: #991b1b;
      --v-dark: #0a0a0a;
      --v-mid: #141414;
      --v-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    }

    /* ── Page ── */
    .v404 {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: calc(var(--nav-height, 4rem) + 2rem) 1.25rem 5rem;
      position: relative;
      overflow: hidden;
      background: var(--v-dark);
    }

    /* ── Background ── */
    .v404__bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
    }

    .bg__glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(120px);
    }
    .bg__glow--top {
      width: 600px; height: 600px;
      top: -15%; left: 20%;
      background: rgba(220, 38, 38, .08);
    }
    .bg__glow--bot {
      width: 450px; height: 450px;
      bottom: -10%; right: 10%;
      background: rgba(153, 27, 27, .06);
    }

    .bg__v {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      font-family: var(--v-mono);
      font-size: clamp(18rem, 40vw, 32rem);
      font-weight: 900;
      color: transparent;
      -webkit-text-stroke: 1px rgba(220, 38, 38, .06);
      line-height: 1;
      user-select: none;
    }

    /* ── Rose ── */
    .v404__rose {
      position: fixed;
      bottom: 8%;
      right: 6%;
      width: 80px;
      opacity: .35;
      z-index: 0;
      animation: rose-fade 6s ease-in-out infinite alternate;
    }

    @keyframes rose-fade {
      from { opacity: .25; transform: translateY(0); }
      to   { opacity: .45; transform: translateY(-6px); }
    }

    /* ── Container ── */
    .v404__container {
      position: relative;
      z-index: 1;
      max-width: 600px;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      animation: emerge .8s cubic-bezier(.16,1,.3,1) both;
    }

    @keyframes emerge {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Terminal ── */
    .term {
      background: var(--v-mid);
      border: 1px solid rgba(220, 38, 38, .12);
      border-radius: 12px;
      overflow: hidden;
      box-shadow:
        0 1px 2px rgba(0,0,0,.4),
        0 20px 50px -15px rgba(0,0,0,.6),
        inset 0 1px 0 rgba(255,255,255,.03);
    }

    .term__bar {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: .6rem .9rem;
      background: rgba(255,255,255,.025);
      border-bottom: 1px solid rgba(220, 38, 38, .08);
    }

    .term__dot {
      width: 9px; height: 9px;
      border-radius: 50%;
      display: block;
    }

    .term__title {
      margin-left: auto;
      font-family: var(--v-mono);
      font-size: .65rem;
      color: rgba(255,255,255,.3);
      letter-spacing: .03em;
    }

    .term__body {
      padding: 1.1rem 1.2rem 1rem;
      font-family: var(--v-mono);
      font-size: .76rem;
      line-height: 1.7;
      display: flex;
      flex-direction: column;
      gap: .2rem;
    }

    .term__line {
      white-space: nowrap;
      overflow: hidden;
      color: rgba(255,255,255,.5);
    }

    .pr { color: var(--v-red-hot); font-weight: 600; }
    .pp { color: var(--v-red); }
    .cmd { color: rgba(255,255,255,.8); }
    .cmd.err { color: var(--v-red-hot); }

    .term__out {
      padding: .25rem 0 .45rem;
      font-size: .74rem;
      line-height: 1.65;
    }

    .ascii {
      color: var(--v-red);
      opacity: .7;
      font-family: var(--v-mono);
      font-size: .52rem;
      letter-spacing: .08em;
      line-height: 1.2;
      margin: .15rem 0 .35rem;
      overflow: hidden;
    }

    .err-main {
      color: var(--v-red-hot);
      font-weight: 700;
      font-size: .8rem;
      letter-spacing: .06em;
      margin-bottom: .1rem;
    }

    .err-sub {
      color: rgba(255,255,255,.3);
      font-size: .72rem;
    }

    .blink {
      color: var(--v-red);
      animation: cblink 1s step-end infinite;
    }
    @keyframes cblink { 50% { opacity: 0; } }

    /* ── Hero ── */
    .hero {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      animation: emerge .8s cubic-bezier(.16,1,.3,1) .1s both;
    }

    .hero__number {
      font-family: var(--v-mono);
      font-size: clamp(6rem, 18vw, 10rem);
      font-weight: 900;
      line-height: .85;
      letter-spacing: -.04em;
      background: linear-gradient(180deg, var(--v-red-hot) 0%, var(--v-blood) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      user-select: none;
      filter: drop-shadow(0 0 30px rgba(220,38,38,.15));
    }

    .hero__title {
      font-family: var(--font-heading);
      font-size: clamp(1.4rem, 4vw, 2rem);
      font-weight: 800;
      letter-spacing: -.025em;
      line-height: 1.15;
      color: rgba(255,255,255,.92);
    }

    .hero__quote {
      font-style: italic;
      font-size: .92rem;
      line-height: 1.65;
      color: var(--v-red);
      opacity: .75;
      border-left: 2px solid rgba(220,38,38,.3);
      padding-left: 1rem;
      max-width: 480px;
    }

    .hero__sub {
      color: rgba(255,255,255,.4);
      font-size: .92rem;
      line-height: 1.7;
      max-width: 480px;
    }

    /* ── Button ── */
    .home-btn {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .8rem 1.5rem;
      background: var(--v-red);
      color: #fff;
      font-family: var(--font-heading);
      font-size: .85rem;
      font-weight: 700;
      border-radius: 8px;
      text-decoration: none;
      letter-spacing: .02em;
      align-self: flex-start;
      box-shadow: 0 2px 16px rgba(220,38,38,.25);
      transition: transform .2s, box-shadow .2s, background .2s;
      position: relative;
      overflow: hidden;
    }

    .home-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.1) 0%, transparent 50%);
      opacity: 0;
      transition: opacity .2s;
    }

    .home-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 28px rgba(220,38,38,.35);
      background: var(--v-red-hot);
    }
    .home-btn:hover::before { opacity: 1; }
    .home-btn:active { transform: translateY(0); }

    .home-btn:focus-visible {
      outline: 2px solid var(--v-red-hot);
      outline-offset: 3px;
    }

    /* ── Responsive ── */
    @media (max-width: 560px) {
      .v404 { padding: calc(var(--nav-height, 4rem) + 1.5rem) 1rem 4rem; }
      .term__body { padding: .9rem 1rem .85rem; font-size: .7rem; }
      .ascii { font-size: .38rem; }
      .hero__quote { font-size: .85rem; }
      .hero__sub { font-size: .85rem; }
      .home-btn { width: 100%; justify-content: center; }
      .v404__rose { width: 55px; right: 3%; bottom: 5%; }
      .bg__glow--top { width: 300px; height: 300px; }
      .bg__glow--bot { width: 220px; height: 220px; }
    }
  </style>
</BaseLayout>